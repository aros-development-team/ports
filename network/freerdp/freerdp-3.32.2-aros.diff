diff --git a/channels/printer/client/aros/document_native.c b/channels/printer/client/aros/document_native.c
new file mode 100644
index 0000000..49bec98
--- /dev/null
+++ b/channels/printer/client/aros/document_native.c
@@ -0,0 +1,87 @@
+/* Spool locally; render in a separate process through stock printer.device. */
+#include "document_native.h"
+#include <proto/dos.h>
+#include <proto/exec.h>
+#include <dos/dostags.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <inttypes.h>
+struct native_document_job { FILE *file; char path[160]; int slot; };
+/* One queued/active job prevents interleaving printer.device page streams. */
+static char pending[1][160];
+static unsigned sequence;
+static int renderer_path(char *path,size_t size)
+{
+    return NameFromLock(GetProgramDir(),(STRPTR)path,size) &&
+        AddPart((STRPTR)path,(CONST_STRPTR)"adt-rdp-render",size);
+}
+int native_document_available(void)
+{
+    char path[1024]; if (!renderer_path(path,sizeof(path))) return 0;
+    BPTR lock=Lock((CONST_STRPTR)path,ACCESS_READ); if (!lock) return 0;
+    UnLock(lock); return 1;
+}
+struct native_document_job *native_document_open(uint32_t id)
+{
+    int slot=-1;
+    for (int i=0;i<1;i++) {
+        if (pending[i][0]) {
+            BPTR lock=Lock((CONST_STRPTR)pending[i],ACCESS_READ);
+            if (lock) UnLock(lock); else if (IoErr()==ERROR_OBJECT_NOT_FOUND) pending[i][0]=0;
+        }
+        if (!pending[i][0] && slot<0) slot=i;
+    }
+    if (slot<0 || !native_document_available()) return NULL;
+    BPTR dir=CreateDir((CONST_STRPTR)"RAM:RemoteDesktopJobs");
+    if (dir) UnLock(dir); else if (IoErr()!=ERROR_OBJECT_EXISTS) return NULL;
+    struct native_document_job *job=calloc(1,sizeof(*job)); if (!job) return NULL;
+    job->slot=slot;
+    /* Generated paths contain only hex digits and hyphens; never remote names. */
+    for (unsigned attempt=0;attempt<100;attempt++) {
+        snprintf(job->path,sizeof(job->path),"RAM:RemoteDesktopJobs/%" PRIxPTR "-%x-%x.xps",
+                 (uintptr_t)FindTask(NULL),(unsigned)id,++sequence);
+        BPTR lock=Lock((CONST_STRPTR)job->path,ACCESS_READ);
+        if (lock) { UnLock(lock); continue; }
+        if (IoErr()!=ERROR_OBJECT_NOT_FOUND) break;
+        job->file=fopen(job->path,"wb"); break;
+    }
+    if (!job->file) { free(job); return NULL; }
+    strcpy(pending[slot],job->path); return job;
+}
+int native_document_write(struct native_document_job *job,const void *data,size_t length)
+{
+    return job && job->file && fwrite(data,1,length,job->file)==length;
+}
+void native_document_abort(struct native_document_job *job)
+{
+    if (!job) return;
+    if (job->file) fclose(job->file);
+    remove(job->path); pending[job->slot][0]=0; free(job);
+}
+int native_document_finish(struct native_document_job *job)
+{
+    if (!job) return 0;
+    int error=fclose(job->file); job->file=NULL;
+    char helper[1024],args[192],log[192];
+    if (error || !renderer_path(helper,sizeof(helper))) { native_document_abort(job); return 0; }
+    BPTR segment=LoadSeg((CONST_STRPTR)helper);
+    if (!segment) { native_document_abort(job); return 0; }
+    snprintf(args,sizeof(args),"--spool %s\n",job->path);
+    snprintf(log,sizeof(log),"%s.log",job->path);
+    BPTR input=Open((CONST_STRPTR)"NIL:",MODE_OLDFILE),output=Open((CONST_STRPTR)log,MODE_NEWFILE);
+    struct Process *process=NULL;
+    if (input && output)
+        process=CreateNewProcTags(NP_Seglist,segment,NP_FreeSeglist,TRUE,
+            NP_Name,(IPTR)"Remote Desktop print job",NP_Arguments,(IPTR)args,
+            NP_Cli,TRUE,NP_StackSize,8388608,NP_Input,input,NP_Output,output,
+            NP_CloseInput,TRUE,NP_CloseOutput,TRUE,NP_Error,output,NP_CloseError,FALSE,TAG_DONE);
+    if (!process) {
+        if (input) Close(input);
+        if (output) Close(output);
+        UnLoadSeg(segment);
+        native_document_abort(job); return 0;
+    }
+    printf("PRINT_JOB_QUEUED=%s LOG=%s\n",job->path,log); fflush(stdout);
+    free(job); return 1;
+}
