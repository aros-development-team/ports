+#include "display.h"
+#include <winpr/sysinfo.h>
+#include <freerdp/log.h>
+static UINT capabilities(DispClientContext *disp, UINT32 monitors, UINT32 a, UINT32 b)
+{
+    tfContext *tf=disp->custom;
+    if (!tf) return CHANNEL_RC_OK;
+    EnterCriticalSection(&tf->clip_lock);
+    tf->disp_area=(UINT64)a*b;
+    tf->disp_ready=monitors>0 && tf->disp_area>=40000;
+    LeaveCriticalSection(&tf->clip_lock);
+    return CHANNEL_RC_OK;
+}
+void adt_display_attach(tfContext *tf, DispClientContext *disp)
+{
+    if (!disp) return;
+    EnterCriticalSection(&tf->clip_lock);
+    tf->disp=disp; tf->disp_ready=FALSE;
+    disp->custom=tf; disp->DisplayControlCaps=capabilities;
+    LeaveCriticalSection(&tf->clip_lock);
+}
+void adt_display_detach(tfContext *tf)
+{
+    EnterCriticalSection(&tf->clip_lock);
+    if (tf->disp) { tf->disp->custom=NULL; tf->disp->DisplayControlCaps=NULL; }
+    tf->disp=NULL; tf->disp_ready=FALSE;
+    LeaveCriticalSection(&tf->clip_lock);
+}
+void adt_display_resize(tfContext *tf, UINT32 width, UINT32 height)
+{
+    if (!freerdp_settings_get_bool(tf->common.context.settings, FreeRDP_DynamicResolutionUpdate)) return;
+    if (width<200 || width>8192 || height<200 || height>8192) return;
+    tf->resize_width=width & ~1U; tf->resize_height=height; tf->resize_changed=GetTickCount64();
+}
+void adt_display_poll(tfContext *tf)
+{
+    if (!tf->resize_width || GetTickCount64()-tf->resize_changed<250) return;
+    EnterCriticalSection(&tf->clip_lock);
+    if (tf->disp && tf->disp_ready && (UINT64)tf->resize_width*tf->resize_height<=tf->disp_area) {
+        DISPLAY_CONTROL_MONITOR_LAYOUT m={0};
+        m.Flags=DISPLAY_CONTROL_MONITOR_PRIMARY; m.Width=tf->resize_width; m.Height=tf->resize_height;
+        m.PhysicalWidth=300; m.PhysicalHeight=200; m.DesktopScaleFactor=100; m.DeviceScaleFactor=100;
+        UINT rc=tf->disp->SendMonitorLayout(tf->disp,1,&m);
+        WLog_INFO("com.freerdp.client.aros", "Display resize %ux%u status=%u",m.Width,m.Height,rc);
+        tf->resize_width=0;
+    }
+    LeaveCriticalSection(&tf->clip_lock);
+}
