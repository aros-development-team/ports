diff --git a/channels/printer/client/aros/printer_aros.c b/channels/printer/client/aros/printer_aros.c
new file mode 100644
index 0000000..4bfecef
--- /dev/null
+++ b/channels/printer/client/aros/printer_aros.c
@@ -0,0 +1,130 @@
+/* Explicit native printers: text device writes or queued document rendering. */
+#include <freerdp/config.h>
+#include <winpr/crt.h>
+#include <freerdp/client/printer.h>
+#include <freerdp/channels/log.h>
+#include "printer_native.h"
+#include "document_native.h"
+#define TAG CHANNELS_TAG("printer.client.aros")
+typedef struct { rdpPrinterDriver base; size_t refs, next_id; } Driver;
+typedef struct Job Job;
+typedef struct { rdpPrinter base; Job *job; } Printer;
+struct Job { rdpPrintJob base; struct native_print_job *native; struct native_document_job *document; size_t total; BOOL failed; BYTE magic[5]; size_t magic_size; };
+static UINT write_job(rdpPrintJob *base, const BYTE *bytes, size_t length)
+{
+    Job *job = (Job *)base;
+    size_t limit = base->printer->is_xps ? 33554432 : 8388608;
+    if (job->failed) return ERROR_WRITE_FAULT;
+    if ((!bytes && length) || length > 1048576 || length > limit - job->total) {
+        job->failed=TRUE; return ERROR_INVALID_DATA;
+    }
+    if (job->document) {
+        for (size_t i=0;i<length && job->magic_size<5;i++) job->magic[job->magic_size++]=bytes[i];
+        if (job->magic_size==5 && memcmp(job->magic,"%PDF-",5) && memcmp(job->magic,"PK\003\004",4)) {
+            job->failed=TRUE; return ERROR_NOT_SUPPORTED;
+        }
+        if (length && !native_document_write(job->document,bytes,length)) {
+            job->failed=TRUE; return ERROR_WRITE_FAULT;
+        }
+    } else {
+        for (size_t i=0;i<length;i++)
+            if (bytes[i]<32 && bytes[i]!='\t' && bytes[i]!='\r' && bytes[i]!='\n' && bytes[i]!='\f') {
+                job->failed=TRUE; return ERROR_NOT_SUPPORTED;
+            }
+        if (length && !native_print_write(job->native,bytes,length)) {
+            job->failed=TRUE; return ERROR_WRITE_FAULT;
+        }
+    }
+    job->total += length; return CHANNEL_RC_OK;
+}
+static void close_job(rdpPrintJob *base)
+{
+    Job *job = (Job *)base;
+    ((Printer *)base->printer)->job = NULL;
+    if (job->document) native_document_abort(job->document);
+    if (job->native) native_print_close(job->native);
+    free(job);
+}
+static UINT finish_job(rdpPrintJob *base)
+{
+    Job *job=(Job *)base;
+    UINT result=CHANNEL_RC_OK;
+    if (job->failed || (job->document && job->magic_size<5)) result=ERROR_INVALID_DATA;
+    else if (job->document) {
+        if (!native_document_finish(job->document)) result=ERROR_WRITE_FAULT;
+        job->document=NULL;
+    }
+    close_job(base); return result;
+}
+static rdpPrintJob *create_job(rdpPrinter *base, UINT32 id)
+{
+    Printer *printer = (Printer *)base;
+    if (printer->job) return NULL;
+    Job *job = calloc(1, sizeof(*job));
+    if (!job) return NULL;
+    if (base->is_xps) job->document = native_document_open(id);
+    else job->native = native_print_open(id);
+    if (!job->native && !job->document) { free(job); return NULL; }
+    job->base.id = id; job->base.printer = base;
+    job->base.Write = write_job; job->base.Close = close_job; job->base.Finish = finish_job;
+    printer->job = job; return &job->base;
+}
+static rdpPrintJob *find_job(rdpPrinter *base, UINT32 id)
+{
+    Job *job = ((Printer *)base)->job;
+    return job && job->base.id == id ? &job->base : NULL;
+}
+static void add_driver(rdpPrinterDriver *base) { ((Driver *)base)->refs++; }
+static void release_driver(rdpPrinterDriver *base) { if (--((Driver *)base)->refs == 0) free(base); }
+static void add_printer(rdpPrinter *base) { base->references++; }
+static void release_printer(rdpPrinter *base)
+{
+    if (--base->references) return;
+    if (((Printer *)base)->job) close_job(&((Printer *)base)->job->base);
+    release_driver(base->backend); free(base->name); free(base->driver); free(base);
+}
+static rdpPrinter *get_printer(rdpPrinterDriver *base, const char *name, const char *driver, BOOL def)
+{
+    BOOL document=driver && (!strcmp(driver,"ADT PDF/XPS printer") ||
+                              !strcmp(driver,"Microsoft XPS Document Writer"));
+    if (driver && strcmp(driver, "Generic / Text Only") && !document) {
+        WLog_ERR(TAG, "Unsupported printer driver; select Generic / Text Only or ADT PDF/XPS printer");
+        return NULL;
+    }
+    if (document && !native_document_available()) {
+        WLog_ERR(TAG,"Place adt-rdp-render beside RemoteDesktop to enable document printing"); return NULL;
+    }
+    Printer *p = calloc(1, sizeof(*p));
+    if (!p) return NULL;
+    p->base.name = _strdup(name && *name ? name : (document ? "AROS printer.device (documents)" : "AROS printer.device (text only)"));
+    p->base.driver = _strdup(document ? driver : "Generic / Text Only");
+    p->base.is_xps = document;
+    if (!p->base.name || !p->base.driver) { free(p->base.name); free(p->base.driver); free(p); return NULL; }
+    p->base.id = ++((Driver *)base)->next_id; p->base.backend = base; add_driver(base);
+    p->base.is_default = def; p->base.references = 1;
+    p->base.CreatePrintJob = create_job; p->base.FindPrintJob = find_job;
+    p->base.AddRef = add_printer; p->base.ReleaseRef = release_printer;
+    return &p->base;
+}
+static rdpPrinter **enumerate(rdpPrinterDriver *base)
+{
+    rdpPrinter **list = calloc(2, sizeof(*list));
+    if (!list) return NULL;
+    list[0] = get_printer(base, NULL, NULL, TRUE);
+    if (!list[0]) { free(list); return NULL; } return list;
+}
+static void release_list(rdpPrinter **list)
+{
+    if (!list) return;
+    for (size_t i = 0; list[i]; i++) release_printer(list[i]);
+    free(list);
+}
+FREERDP_ENTRY_POINT(UINT VCAPITYPE aros_freerdp_printer_client_subsystem_entry(void *arg))
+{
+    if (!arg) return ERROR_INVALID_PARAMETER;
+    Driver *d = calloc(1, sizeof(*d));
+    if (!d) return ERROR_OUTOFMEMORY;
+    d->refs = 1; d->base.EnumPrinters = enumerate; d->base.ReleaseEnumPrinters = release_list;
+    d->base.GetPrinter = get_printer; d->base.AddRef = add_driver; d->base.ReleaseRef = release_driver;
+    *(rdpPrinterDriver **)arg = &d->base; return CHANNEL_RC_OK;
+}
diff --git a/channels/printer/client/aros/printer_native.c b/channels/printer/client/aros/printer_native.c
new file mode 100644
index 0000000..b1034dd
--- /dev/null
+++ b/channels/printer/client/aros/printer_native.c
@@ -0,0 +1,48 @@
+/* Stock printer.device is the only output path. Gutenprint remains its driver. */
+#include "printer_native.h"
+#include <devices/printer.h>
+#include <datatypes/datatypesclass.h>
+#include <proto/exec.h>
+#include <stdlib.h>
+#include <stdio.h>
+/* ADT job metadata extension; compatible with SDKs predating its header. */
+#ifndef PRD_SETJOBINFO
+#define PRD_SETJOBINFO (CMD_NONSTD + 13)
+#define PJIA_Application (TAG_USER + 0x80001)
+#define PJIA_Document (TAG_USER + 0x80002)
+#endif
+struct native_print_job { struct MsgPort *port; union printerIO *io; int opened; char title[64]; };
+struct native_print_job *native_print_open(uint32_t id)
+{
+    struct native_print_job *p = calloc(1, sizeof(*p));
+    if (!p) return NULL;
+    p->port = CreateMsgPort();
+    if (p->port) p->io = (union printerIO *)CreateIORequest(p->port, sizeof(*p->io));
+    if (!p->io) { native_print_close(p); return NULL; }
+    int error = OpenDevice("printer.device", 0, (struct IORequest *)p->io, 0);
+    if (error) { fprintf(stderr, "printer.device unit 0: open failed (%d); check printer preferences and configured driver\n", error); native_print_close(p); return NULL; }
+    p->opened = 1;
+    snprintf(p->title, sizeof(p->title), "Remote Desktop text job %u", (unsigned)id);
+    struct TagItem tags[] = {{PJIA_Application, (IPTR)"ADT Remote Desktop"},
+        {PJIA_Document, (IPTR)p->title}, {TAG_DONE, 0}};
+    p->io->ios.io_Command = PRD_SETJOBINFO; p->io->ios.io_Data = tags;
+    p->io->ios.io_Length = 0;
+    /* Older printer.device versions can still print without metadata. */
+    DoIO((struct IORequest *)p->io);
+    return p;
+}
+int native_print_write(struct native_print_job *p, const void *bytes, size_t length)
+{
+    if (!p || !bytes || length > 1048576) return 0;
+    p->io->ios.io_Command = CMD_WRITE; p->io->ios.io_Error = 0;
+    p->io->ios.io_Data = (void *)bytes; p->io->ios.io_Length = length;
+    return DoIO((struct IORequest *)p->io) == 0 && p->io->ios.io_Actual == length;
+}
+void native_print_close(struct native_print_job *p)
+{
+    if (!p) return;
+    if (p->opened) CloseDevice((struct IORequest *)p->io);
+    if (p->io) DeleteIORequest((struct IORequest *)p->io);
+    if (p->port) DeleteMsgPort(p->port);
+    free(p);
+}
