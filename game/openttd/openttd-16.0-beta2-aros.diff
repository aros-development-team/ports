diff --git a/src/network/core/os_abstraction_aros.cpp b/src/network/core/os_abstraction_aros.cpp
new file mode 100644
index 0000000000..b035e83db5
--- /dev/null
+++ b/src/network/core/os_abstraction_aros.cpp
@@ -0,0 +1,174 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/**
+ * @file os_abstraction_aros.cpp Real socket functions for AROS.
+ *
+ * AROS reaches bsdsocket.library through ~184 function-like macros in
+ * <defines/bsdsocket.h>; libnet.a contains no socket symbols at all, only
+ * helpers such as select() and inet_ntoa(). Those macros are therefore
+ * load-bearing - but a function-like macro rewrites *every* occurrence of its
+ * name, not just calls. The names include both the POSIX spellings and the
+ * AmigaOS ones (CloseSocket, IoctlSocket, ...), and they collide with ordinary
+ * C++ all over the codebase: nlohmann/json has a member accept(), gfxinit.cpp
+ * uses std::bind, and OpenTTD's own TCPConnection has a CloseSocket() method.
+ *
+ * Patching each collision is a losing game, because <pthread.h> independently
+ * defines its own cancellation-point wrappers for ten of the same names, so
+ * whether a given file breaks comes down to include order.
+ *
+ * Instead the whole port is built with -DBSDSOCKET_NOLIBDEFINES, which stops
+ * <proto/bsdsocket.h> from pulling the macro block in, and os_abstraction.h
+ * includes <pthread.h> itself and drops its ten macros again, so include order
+ * stops mattering. The C++ side is then completely free of socket macros - at
+ * the cost of the functions no longer being defined anywhere, since
+ * <clib/bsdsocket_protos.h> only declares them.
+ *
+ * This file supplies those definitions. It deliberately re-enables the macros
+ * to get at the __<name>_WB() library-call constructs, then undefines the plain
+ * names so the definitions below are real functions rather than macro
+ * expansions. Signatures follow <clib/bsdsocket_protos.h>, which the compiler
+ * checks for us - note that send()/recv() take int lengths here, not size_t.
+ */
+
+#include "../../stdafx.h"
+
+/* Undo the project-wide suppression: this is the one place that wants them.
+ * The resolver entries (getaddrinfo and friends) come from the Roadshow API, so
+ * their __*_WB macros sit behind __CONFIG_ROADSHOW__. */
+#undef BSDSOCKET_NOLIBDEFINES
+#define __CONFIG_ROADSHOW__
+#include <proto/bsdsocket.h>
+
+#include "../../safeguards.h"
+
+/* Keep __<name>_WB, drop the plain names so we can define them below. */
+#undef socket
+#undef bind
+#undef connect
+#undef listen
+#undef accept
+#undef send
+#undef sendto
+#undef recv
+#undef recvfrom
+#undef setsockopt
+#undef getsockopt
+#undef getsockname
+#undef getpeername
+#undef shutdown
+#undef CloseSocket
+#undef IoctlSocket
+#undef getaddrinfo
+#undef freeaddrinfo
+#undef getnameinfo
+#undef gai_strerror
+
+int socket(int domain, int type, int protocol)
+{
+	return __socket_WB(SocketBase, domain, type, protocol);
+}
+
+int bind(int s, const struct sockaddr *name, socklen_t namelen)
+{
+	return __bind_WB(SocketBase, s, name, namelen);
+}
+
+int connect(int s, const struct sockaddr *name, socklen_t namelen)
+{
+	return __connect_WB(SocketBase, s, name, namelen);
+}
+
+int listen(int s, int backlog)
+{
+	return __listen_WB(SocketBase, s, backlog);
+}
+
+int accept(int s, struct sockaddr *addr, socklen_t *addrlen)
+{
+	return __accept_WB(SocketBase, s, addr, addrlen);
+}
+
+int send(int s, const void *msg, int len, int flags)
+{
+	return __send_WB(SocketBase, s, msg, len, flags);
+}
+
+int sendto(int s, const void *msg, int len, int flags, const struct sockaddr *to, socklen_t tolen)
+{
+	return __sendto_WB(SocketBase, s, msg, len, flags, to, tolen);
+}
+
+int recv(int s, void *buf, int len, int flags)
+{
+	return __recv_WB(SocketBase, s, buf, len, flags);
+}
+
+int recvfrom(int s, void *buf, int len, int flags, struct sockaddr *from, socklen_t *fromlen)
+{
+	return __recvfrom_WB(SocketBase, s, buf, len, flags, from, fromlen);
+}
+
+int setsockopt(int s, int level, int optname, const void *optval, socklen_t optlen)
+{
+	return __setsockopt_WB(SocketBase, s, level, optname, optval, optlen);
+}
+
+int getsockopt(int s, int level, int optname, void *optval, socklen_t *optlen)
+{
+	return __getsockopt_WB(SocketBase, s, level, optname, optval, optlen);
+}
+
+int getsockname(int s, struct sockaddr *name, socklen_t *namelen)
+{
+	return __getsockname_WB(SocketBase, s, name, namelen);
+}
+
+int getpeername(int s, struct sockaddr *name, socklen_t *namelen)
+{
+	return __getpeername_WB(SocketBase, s, name, namelen);
+}
+
+int shutdown(int s, int how)
+{
+	return __shutdown_WB(SocketBase, s, how);
+}
+
+int CloseSocket(int s)
+{
+	return __CloseSocket_WB(SocketBase, s);
+}
+
+int IoctlSocket(int s, unsigned long request, char *argp)
+{
+	return __IoctlSocket_WB(SocketBase, s, request, argp);
+}
+
+/* The resolver entries are exported under RS_ names and are not declared by
+ * <netdb.h> at all, so these are the only declarations OpenTTD ever sees;
+ * os_abstraction.h declares them with the POSIX signatures used here. */
+int getaddrinfo(const char *node, const char *service, const struct addrinfo *hints, struct addrinfo **res)
+{
+	return __getaddrinfo_WB(SocketBase, node, service, hints, res);
+}
+
+void freeaddrinfo(struct addrinfo *res)
+{
+	__freeaddrinfo_WB(SocketBase, res);
+}
+
+int getnameinfo(const struct sockaddr *sa, socklen_t salen, char *host, socklen_t hostlen, char *serv, socklen_t servlen, int flags)
+{
+	/* AROS takes a non-const sockaddr and LONG lengths. */
+	return __getnameinfo_WB(SocketBase, const_cast<struct sockaddr *>(sa), salen, host, hostlen, serv, servlen, flags);
+}
+
+const char *gai_strerror(int errcode)
+{
+	return reinterpret_cast<const char *>(__gai_strerror_WB(SocketBase, errcode));
+}
+
