+#if defined(__AROS__)
+static BOOL open_timer() {
+  if (TimerBase || fallback) {
+    return FALSE;
+  }
+
+  if (!(TimerMP = CreateMsgPort())) {
+    start = clock();
+    fallback = 1;
+    return FALSE;
+  }
+
+  if (!(TimerIO = (struct timerequest *)CreateIORequest(
+            TimerMP, sizeof(struct timerequest)))) {
+    DeleteMsgPort(TimerMP);
+    start = clock();
+    fallback = 1;
+    return FALSE;
+  }
+
+  // Under AROS we use UNIT_MICROHZ to be more accurate for short delays
+  if (OpenDevice("timer.device", UNIT_MICROHZ, &TimerIO->tr_node, 0)) {
+    DeleteMsgPort(TimerMP);
+    DeleteIORequest((struct IORequest *)TimerIO);
+    start = clock();
+    fallback = 1;
+    return FALSE;
+  }
+
+  OwnerTask = TimerMP->mp_SigTask;
+  TimerBase = TimerIO->tr_node.io_Device;
+
+  GetSysTime(&basetime);
+
+  return TRUE;
+}
+
+void Close_timer() {
+  if (TimerIO) {
+    CloseDevice((struct IORequest *)TimerIO);
+    DeleteIORequest((struct IORequest *)TimerIO);
+  }
+  if (TimerMP)
+    DeleteMsgPort(TimerMP);
+}
 #endif
