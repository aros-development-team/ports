 use crate::display::color::{CellRgb, Rgb};
 
+/// The first eight pens of the Workbench screen. AROS consoles take their
+/// colours from them: 0 is the background, 1 the text, and colour n is pen n.
+#[cfg(target_os = "aros")]
+fn workbench_pens() -> Option<[Rgb; 8]> {
+    use std::sync::OnceLock;
+
+    static PENS: OnceLock<Option<[Rgb; 8]>> = OnceLock::new();
+    *PENS.get_or_init(|| {
+        let mut rgb = [0u32; 8];
+        let pens = unsafe { aros_gui_sys::aros_gui_screen_palette(rgb.as_mut_ptr(), 8) };
+        (pens == 8).then(|| rgb.map(|c| Rgb::new((c >> 16) as u8, (c >> 8) as u8, c as u8)))
+    })
+}
