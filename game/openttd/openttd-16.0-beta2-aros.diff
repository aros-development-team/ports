diff --git a/src/network/core/host.cpp b/src/network/core/host.cpp
index 3574aa72ae..3a2c796809 100644
--- a/src/network/core/host.cpp
+++ b/src/network/core/host.cpp
@@ -57,6 +57,56 @@ static void NetworkFindBroadcastIPsInternal(NetworkAddressList *broadcast) // Wi
 	closesocket(sock);
 }
 
+#elif defined(__AROS__)
+static void NetworkFindBroadcastIPsInternal(NetworkAddressList *broadcast) // AROS implementation
+{
+	/* AROS' bsdsocket has no getifaddrs(), so walk the interface list the
+	 * classic way: SIOCGIFCONF for the names, then query each one. */
+	SOCKET sock = socket(AF_INET, SOCK_DGRAM, 0);
+	if (sock == INVALID_SOCKET) return;
+
+	std::vector<char> buffer(sizeof(struct ifreq) * 16);
+	struct ifconf ifc{};
+
+	for (;;) {
+		ifc.ifc_len = static_cast<int>(buffer.size());
+		ifc.ifc_buf = buffer.data();
+		if (ioctl(sock, SIOCGIFCONF, &ifc) != 0) {
+			closesocket(sock);
+			return;
+		}
+		/* A full buffer means the list was probably truncated - retry bigger. */
+		if (static_cast<size_t>(ifc.ifc_len) < buffer.size()) break;
+		buffer.resize(buffer.size() * 2);
+	}
+
+	const char *end = buffer.data() + ifc.ifc_len;
+	for (const char *pos = buffer.data(); pos < end; ) {
+		const struct ifreq *entry = reinterpret_cast<const struct ifreq *>(pos);
+		/* Entries are variable length: the trailing sockaddr may be longer
+		 * than the one embedded in struct ifreq. */
+		size_t addr_len = std::max<size_t>(sizeof(struct sockaddr), entry->ifr_addr.sa_len);
+		pos += offsetof(struct ifreq, ifr_addr) + addr_len;
+
+		if (entry->ifr_addr.sa_family != AF_INET) continue;
+
+		struct ifreq request{};
+		strecpy(request.ifr_name, entry->ifr_name);
+
+		if (ioctl(sock, SIOCGIFFLAGS, &request) != 0) continue;
+		if (request.ifr_flags & IFF_LOOPBACK) continue;
+		if (!(request.ifr_flags & IFF_BROADCAST)) continue;
+
+		if (ioctl(sock, SIOCGIFBRDADDR, &request) != 0) continue;
+		if (request.ifr_broadaddr.sa_family != AF_INET) continue;
+
+		NetworkAddress addr(&request.ifr_broadaddr, sizeof(sockaddr));
+		if (std::none_of(broadcast->begin(), broadcast->end(), [&addr](NetworkAddress const &elem) -> bool { return elem == addr; })) broadcast->push_back(std::move(addr));
+	}
+
+	closesocket(sock);
+}
+
 #else /* not WIN32 */
 static void NetworkFindBroadcastIPsInternal(NetworkAddressList *broadcast)
 {
