diff -ruN -x .cargo-checksum.json -x Cargo.toml.orig -x .cargo_vcs_info.json -x target -x Cargo.lock a/src/hw/ahi_glue.c b/src/hw/ahi_glue.c
--- a/src/hw/ahi_glue.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/hw/ahi_glue.c	2026-10-12 15:19:27.198696664 +0100
@@ -0,0 +1,673 @@
+/*
+ * ahi_glue.c - the AHI side of maolan-engine's AROS audio backend.
+ *
+ * One AHI audio mode is allocated with the low-level API: a ring of
+ * `nperiods` dynamic sounds of `period` stereo 32-bit frames each, played
+ * back to back on channel 0. The sound hook, called by AHI when a sound
+ * starts, queues the next slot and hands back the slot that just finished.
+ * Recording, when asked for, arrives through the record hook into a ring the
+ * worker drains one period at a time.
+ *
+ * AHI drivers tie their start/stop handshake to the task that allocated the
+ * audio (the driver stores FindTask(NULL) and a signal in AHIsub_AllocAudio
+ * and waits for that signal in AHIsub_Start/Stop), while the engine opens
+ * the driver on one thread and runs its cycles on a pool of others. Every
+ * AHI control call (device open, AHI_AllocAudio, the sounds, play, stop,
+ * AHI_FreeAudio) therefore happens on one control task of the stream's own;
+ * the cycle threads only fill the ring and wait for a free slot, with a
+ * signal bit each task registers for itself.
+ *
+ * Everything the Rust side (src/hw/ahi.rs) touches is a plain C function on
+ * the stream handle; the library base comes from ahi.device.
+ */
+
+#include <proto/exec.h>
+#include <proto/ahi.h>
+#include <proto/utility.h>
+#include <proto/dos.h>
+#include <proto/timer.h>
+
+#include <exec/memory.h>
+#include <exec/ports.h>
+#include <devices/ahi.h>
+#include <devices/timer.h>
+#include <utility/hooks.h>
+#include <aros/asmcall.h>
+#include <aros/debug.h>
+
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct Library *AHIBase;
+
+struct ahi_stream;
+void ahi_close(struct ahi_stream *s);
+
+#define MAX_FREQS 16
+#define MAX_WAITERS 32
+
+static int ahi_debug = -1;
+#define AHI_DEBUG(...) do { if (ahi_debug > 0) bug("ahi_glue: " __VA_ARGS__); } while (0)
+
+typedef struct ahi_mode_info {
+    uint32_t id;
+    char name[64];
+    int32_t bits;
+    int32_t max_channels;
+    int32_t record;
+    int32_t fullduplex;
+    int32_t realtime;
+    int32_t min_freq;
+    int32_t max_freq;
+    int32_t nfreq;
+    int32_t freqs[MAX_FREQS];
+} ahi_mode_info;
+
+/* A task that waits for free slots: its signal bit and a timer of its own. */
+struct ahi_waiter {
+    struct Task *task;
+    LONG sig;
+    struct MsgPort *timer_port;
+    struct timerequest *timer_req;
+    int timer_open;
+};
+
+enum ahi_cmd { AHI_CMD_NONE = 0, AHI_CMD_START, AHI_CMD_CLOSE };
+
+struct ahi_stream {
+    /* the control task's state: only it touches these */
+    struct MsgPort *port;
+    struct AHIRequest *req;
+    int device_open;
+    struct AHIAudioCtrl *ctrl;
+    struct Hook sound_hook;
+    struct Hook record_hook;
+    int sounds_loaded;
+
+    /* what to open */
+    uint32_t audio_id;
+    int32_t freq;
+    int record;
+
+    /* the control task and the command channel to it */
+    pthread_t thread;
+    int thread_started;
+    pthread_mutex_t mu;
+    pthread_cond_t cv;
+    int opened;          /* OPEN done */
+    int open_ok;
+    int cmd;             /* pending command */
+    int cmd_done;        /* set when the control task finished it */
+    int cmd_ok;
+
+    int32_t period;            /* frames per slot */
+    int32_t nslots;
+    int32_t **slots;           /* nslots buffers of period * 2 LONGs */
+    volatile uint32_t *filled; /* per slot: written and not yet played */
+    volatile int32_t play_idx; /* slot the hook saw start last */
+    int32_t write_idx;         /* next slot the worker writes */
+    volatile int32_t free_slots;
+    volatile int started;
+    volatile uint64_t xruns;
+    volatile uint32_t hook_calls;
+
+    struct ahi_waiter *waiter;
+    struct ahi_waiter *waiters[MAX_WAITERS];
+    int32_t nwaiters;
+
+    /* capture ring, stereo 32-bit frames */
+    int32_t *cap;
+    int32_t cap_frames;
+    volatile int32_t cap_wr, cap_rd;
+    volatile int32_t cap_fill;
+    volatile uint64_t cap_overruns;
+    uint32_t mixfreq;
+};
+
+/* ---- hooks: run in AHI's context, keep them short ---- */
+
+AROS_UFH3(ULONG, ahi_sound_func,
+    AROS_UFHA(struct Hook *, hook, A0),
+    AROS_UFHA(struct AHIAudioCtrl *, actrl, A2),
+    AROS_UFHA(struct AHISoundMessage *, msg, A1))
+{
+    AROS_USERFUNC_INIT
+    struct ahi_stream *s = (struct ahi_stream *)hook->h_Data;
+    int32_t started = s->play_idx;
+    int32_t next = (started + 1) % s->nslots;
+    int32_t freed = (started + s->nslots - 1) % s->nslots;
+    (void)msg;
+
+    /* queue the slot after the one that just started */
+    if (!s->filled[next])
+        s->xruns++;
+    AHI_SetSound(0, next, 0, 0, actrl, 0);
+    s->play_idx = next;
+
+    /* the one before it has finished: hand it back (not on the very first
+     * start, when nothing has played yet) */
+    if (s->hook_calls++ > 0) {
+        s->filled[freed] = 0;
+        s->free_slots++;
+    }
+    {
+        struct ahi_waiter *w = s->waiter;
+        if (w)
+            Signal(w->task, 1UL << w->sig);
+    }
+    if (s->hook_calls <= 3)
+        AHI_DEBUG("sound hook #%ld: started slot %ld, queued %ld, free %ld\n",
+                  (long)s->hook_calls, (long)started, (long)next, (long)s->free_slots);
+    return 0;
+    AROS_USERFUNC_EXIT
+}
+
+AROS_UFH3(ULONG, ahi_record_func,
+    AROS_UFHA(struct Hook *, hook, A0),
+    AROS_UFHA(struct AHIAudioCtrl *, actrl, A2),
+    AROS_UFHA(struct AHIRecordMessage *, msg, A1))
+{
+    AROS_USERFUNC_INIT
+    struct ahi_stream *s = (struct ahi_stream *)hook->h_Data;
+    int32_t n = (int32_t)msg->ahirm_Length;
+    int32_t i;
+    (void)actrl;
+
+    if (!s->cap || n <= 0)
+        return 0;
+    for (i = 0; i < n; i++) {
+        int32_t l, r;
+        switch (msg->ahirm_Type) {
+        case AHIST_S16S: {
+            const int16_t *p = (const int16_t *)msg->ahirm_Buffer + i * 2;
+            l = (int32_t)p[0] << 16;
+            r = (int32_t)p[1] << 16;
+            break;
+        }
+        case AHIST_M16S: {
+            const int16_t *p = (const int16_t *)msg->ahirm_Buffer + i;
+            l = r = (int32_t)p[0] << 16;
+            break;
+        }
+        case AHIST_S32S: {
+            const int32_t *p = (const int32_t *)msg->ahirm_Buffer + i * 2;
+            l = p[0];
+            r = p[1];
+            break;
+        }
+        case AHIST_M32S: {
+            const int32_t *p = (const int32_t *)msg->ahirm_Buffer + i;
+            l = r = p[0];
+            break;
+        }
+        default:
+            l = r = 0;
+            break;
+        }
+        if (s->cap_fill >= s->cap_frames) {
+            s->cap_overruns++;
+            break;
+        }
+        s->cap[s->cap_wr * 2] = l;
+        s->cap[s->cap_wr * 2 + 1] = r;
+        s->cap_wr = (s->cap_wr + 1) % s->cap_frames;
+        s->cap_fill++;
+    }
+    return 0;
+    AROS_USERFUNC_EXIT
+}
+
+/* ---- device (always on the calling task; the stream's control task for a stream) ---- */
+
+static int open_device(struct ahi_stream *s)
+{
+    s->port = CreateMsgPort();
+    if (!s->port)
+        return 0;
+    s->req = (struct AHIRequest *)CreateIORequest(s->port, sizeof(struct AHIRequest));
+    if (!s->req)
+        return 0;
+    s->req->ahir_Version = 4;
+    if (OpenDevice((CONST_STRPTR)AHINAME, AHI_NO_UNIT, (struct IORequest *)s->req, 0) != 0)
+        return 0;
+    s->device_open = 1;
+    AHIBase = (struct Library *)s->req->ahir_Std.io_Device;
+    return 1;
+}
+
+static void close_device(struct ahi_stream *s)
+{
+    if (s->device_open) {
+        CloseDevice((struct IORequest *)s->req);
+        s->device_open = 0;
+    }
+    if (s->req) {
+        DeleteIORequest((struct IORequest *)s->req);
+        s->req = NULL;
+    }
+    if (s->port) {
+        DeleteMsgPort(s->port);
+        s->port = NULL;
+    }
+}
+
+/* Lists the audio modes AHI knows. Opens and closes the device itself. */
+int32_t ahi_enumerate_modes(ahi_mode_info *out, int32_t max)
+{
+    struct ahi_stream tmp;
+    ULONG id = AHI_INVALID_ID;
+    int32_t count = 0;
+
+    memset(&tmp, 0, sizeof tmp);
+    if (!open_device(&tmp)) {
+        close_device(&tmp);
+        return 0;
+    }
+    while (count < max && (id = AHI_NextAudioID(id)) != AHI_INVALID_ID) {
+        ahi_mode_info *m = &out[count];
+        LONG bits = 0, maxch = 0, rec = 0, fd = 0, rt = 0, minf = 0, maxf = 0, nf = 0, i;
+        memset(m, 0, sizeof *m);
+        m->id = id;
+        AHI_GetAudioAttrs(id, NULL,
+            AHIDB_Name, (IPTR)m->name,
+            AHIDB_BufferLen, sizeof m->name,
+            AHIDB_Bits, (IPTR)&bits,
+            AHIDB_MaxChannels, (IPTR)&maxch,
+            AHIDB_Record, (IPTR)&rec,
+            AHIDB_FullDuplex, (IPTR)&fd,
+            AHIDB_Realtime, (IPTR)&rt,
+            AHIDB_MinMixFreq, (IPTR)&minf,
+            AHIDB_MaxMixFreq, (IPTR)&maxf,
+            AHIDB_Frequencies, (IPTR)&nf,
+            TAG_DONE);
+        m->bits = bits;
+        m->max_channels = maxch;
+        m->record = rec;
+        m->fullduplex = fd;
+        m->realtime = rt;
+        m->min_freq = minf;
+        m->max_freq = maxf;
+        for (i = 0; i < nf && m->nfreq < MAX_FREQS; i++) {
+            LONG f = 0;
+            AHI_GetAudioAttrs(id, NULL, AHIDB_FrequencyArg, i, AHIDB_Frequency, (IPTR)&f, TAG_DONE);
+            if (f > 0)
+                m->freqs[m->nfreq++] = f;
+        }
+        count++;
+    }
+    close_device(&tmp);
+    return count;
+}
+
+/* The mode AHI considers best for realtime 16-bit stereo output. */
+uint32_t ahi_best_mode(void)
+{
+    struct ahi_stream tmp;
+    ULONG id;
+    memset(&tmp, 0, sizeof tmp);
+    if (!open_device(&tmp)) {
+        close_device(&tmp);
+        return AHI_INVALID_ID;
+    }
+    id = AHI_BestAudioID(AHIDB_Realtime, TRUE, AHIDB_Stereo, TRUE, AHIDB_Bits, 16, TAG_DONE);
+    close_device(&tmp);
+    return id;
+}
+
+/* ---- the control task ---- */
+
+/* Opens the device, allocates the audio and loads the ring's sounds. */
+static int ctl_open(struct ahi_stream *s)
+{
+    ULONG mixfreq = 0;
+    int32_t i;
+
+    if (!open_device(s))
+        return 0;
+    s->sound_hook.h_Entry = (HOOKFUNC)ahi_sound_func;
+    s->sound_hook.h_Data = s;
+    s->record_hook.h_Entry = (HOOKFUNC)ahi_record_func;
+    s->record_hook.h_Data = s;
+    s->ctrl = AHI_AllocAudio(
+        AHIA_AudioID, s->audio_id,
+        AHIA_MixFreq, (ULONG)s->freq,
+        AHIA_Channels, 1,
+        AHIA_Sounds, (ULONG)s->nslots,
+        AHIA_SoundFunc, (IPTR)&s->sound_hook,
+        s->record ? AHIA_RecordFunc : TAG_IGNORE, (IPTR)&s->record_hook,
+        AHIA_UserData, (IPTR)s,
+        TAG_DONE);
+    if (!s->ctrl)
+        return 0;
+    AHI_ControlAudio(s->ctrl, AHIC_MixFreq_Query, (IPTR)&mixfreq, TAG_DONE);
+    if (mixfreq == 0)
+        mixfreq = (ULONG)s->freq;
+    s->mixfreq = mixfreq;
+    for (i = 0; i < s->nslots; i++) {
+        struct AHISampleInfo si;
+        si.ahisi_Type = AHIST_S32S;
+        si.ahisi_Address = s->slots[i];
+        si.ahisi_Length = s->period;
+        if (AHI_LoadSound(i, AHIST_DYNAMICSAMPLE, &si, s->ctrl) != AHIE_OK)
+            return 0;
+        s->sounds_loaded = i + 1;
+    }
+    return 1;
+}
+
+static void ctl_start(struct ahi_stream *s)
+{
+    AHI_DEBUG("starting playback: %ld slots of %ld frames at %lu Hz\n",
+              (long)s->nslots, (long)s->period, (unsigned long)s->mixfreq);
+    s->play_idx = 0;
+    AHI_ControlAudio(s->ctrl, AHIC_Play, TRUE, s->record ? AHIC_Record : TAG_IGNORE, TRUE, TAG_DONE);
+    AHI_SetFreq(0, s->mixfreq, s->ctrl, AHISF_IMM);
+    AHI_SetVol(0, 0x10000, 0x8000, s->ctrl, AHISF_IMM);
+    AHI_SetSound(0, 0, 0, 0, s->ctrl, AHISF_IMM);
+    s->started = 1;
+    AHI_DEBUG("playing\n");
+}
+
+static void ctl_close(struct ahi_stream *s)
+{
+    int32_t i;
+    if (s->ctrl) {
+        if (s->started)
+            AHI_ControlAudio(s->ctrl, AHIC_Play, FALSE, AHIC_Record, FALSE, TAG_DONE);
+        s->started = 0;
+        for (i = 0; i < s->sounds_loaded; i++)
+            AHI_UnloadSound(i, s->ctrl);
+        s->sounds_loaded = 0;
+        AHI_FreeAudio(s->ctrl);
+        s->ctrl = NULL;
+    }
+    close_device(s);
+}
+
+static void *ahi_control_thread(void *arg)
+{
+    struct ahi_stream *s = arg;
+    int ok = ctl_open(s);
+
+    pthread_mutex_lock(&s->mu);
+    s->open_ok = ok;
+    s->opened = 1;
+    pthread_cond_broadcast(&s->cv);
+    while (ok) {
+        int cmd;
+        while (s->cmd == AHI_CMD_NONE)
+            pthread_cond_wait(&s->cv, &s->mu);
+        cmd = s->cmd;
+        s->cmd = AHI_CMD_NONE;
+        pthread_mutex_unlock(&s->mu);
+        if (cmd == AHI_CMD_START)
+            ctl_start(s);
+        pthread_mutex_lock(&s->mu);
+        s->cmd_done = 1;
+        s->cmd_ok = 1;
+        pthread_cond_broadcast(&s->cv);
+        if (cmd == AHI_CMD_CLOSE)
+            break;
+    }
+    pthread_mutex_unlock(&s->mu);
+    /* the stream is closed by the control task too (the device was opened by it) */
+    ctl_close(s);
+    return NULL;
+}
+
+/* Runs `cmd` on the control task and waits for it. */
+static int ctl_command(struct ahi_stream *s, int cmd)
+{
+    int ok;
+    pthread_mutex_lock(&s->mu);
+    s->cmd = cmd;
+    s->cmd_done = 0;
+    pthread_cond_broadcast(&s->cv);
+    while (!s->cmd_done)
+        pthread_cond_wait(&s->cv, &s->mu);
+    ok = s->cmd_ok;
+    pthread_mutex_unlock(&s->mu);
+    return ok;
+}
+
+/* ---- the stream ---- */
+
+struct ahi_stream *ahi_open(uint32_t audio_id, int32_t freq, int32_t period, int32_t nperiods,
+                            int32_t record, int32_t *got_freq)
+{
+    struct ahi_stream *s = calloc(1, sizeof *s);
+    int32_t i;
+
+    if (ahi_debug < 0)
+        ahi_debug = getenv("MAOLAN_AHI_DEBUG") ? 1 : 0;
+    if (!s)
+        return NULL;
+    if (period < 64) period = 64;
+    if (nperiods < 2) nperiods = 2;
+    if (nperiods > 16) nperiods = 16;
+    s->period = period;
+    s->nslots = nperiods;
+    s->record = record;
+    s->audio_id = audio_id;
+    s->freq = freq;
+    pthread_mutex_init(&s->mu, NULL);
+    pthread_cond_init(&s->cv, NULL);
+
+    s->slots = calloc(nperiods, sizeof *s->slots);
+    s->filled = calloc(nperiods, sizeof *s->filled);
+    if (!s->slots || !s->filled)
+        goto fail;
+    for (i = 0; i < nperiods; i++) {
+        s->slots[i] = AllocVec(period * 2 * sizeof(int32_t), MEMF_PUBLIC | MEMF_CLEAR);
+        if (!s->slots[i])
+            goto fail;
+    }
+    if (record) {
+        s->cap_frames = period * (nperiods + 2);
+        s->cap = calloc(s->cap_frames * 2, sizeof(int32_t));
+        if (!s->cap)
+            goto fail;
+    }
+
+    if (pthread_create(&s->thread, NULL, ahi_control_thread, s) != 0)
+        goto fail;
+    s->thread_started = 1;
+    pthread_mutex_lock(&s->mu);
+    while (!s->opened)
+        pthread_cond_wait(&s->cv, &s->mu);
+    pthread_mutex_unlock(&s->mu);
+    if (!s->open_ok)
+        goto fail;
+
+    s->free_slots = nperiods;
+    s->write_idx = 0;
+    s->play_idx = 0;
+    if (got_freq)
+        *got_freq = (int32_t)s->mixfreq;
+    AHI_DEBUG("opened mode 0x%08lx at %lu Hz, %ld x %ld frames, record %d\n",
+              (unsigned long)audio_id, (unsigned long)s->mixfreq, (long)nperiods, (long)period, record);
+    return s;
+
+fail:
+    ahi_close(s);
+    return NULL;
+}
+
+void ahi_close(struct ahi_stream *s)
+{
+    int32_t i;
+    if (!s)
+        return;
+    if (s->thread_started) {
+        /* a thread that failed to open has already left its loop */
+        if (s->open_ok)
+            ctl_command(s, AHI_CMD_CLOSE);
+        pthread_join(s->thread, NULL);
+        s->thread_started = 0;
+    }
+    if (s->slots) {
+        for (i = 0; i < s->nslots; i++)
+            if (s->slots[i])
+                FreeVec(s->slots[i]);
+        free(s->slots);
+    }
+    free((void *)s->filled);
+    free(s->cap);
+    /* The waiters' signal bits and timers belong to their tasks; only the
+     * calling task's own are released here, the rest stay with their tasks. */
+    for (i = 0; i < s->nwaiters; i++) {
+        struct ahi_waiter *w = s->waiters[i];
+        if (w->task == FindTask(NULL)) {
+            if (w->timer_open)
+                CloseDevice((struct IORequest *)w->timer_req);
+            if (w->timer_req)
+                DeleteIORequest((struct IORequest *)w->timer_req);
+            if (w->timer_port)
+                DeleteMsgPort(w->timer_port);
+            FreeSignal(w->sig);
+        }
+        free(w);
+    }
+    pthread_cond_destroy(&s->cv);
+    pthread_mutex_destroy(&s->mu);
+    free(s);
+}
+
+int32_t ahi_mix_frequency(struct ahi_stream *s)
+{
+    return (int32_t)s->mixfreq;
+}
+
+/* The calling task's registration with the stream: its signal bit and timer,
+ * allocated on first use. NULL when no bit is left in this task. */
+static struct ahi_waiter *register_waiter(struct ahi_stream *s)
+{
+    struct Task *me = FindTask(NULL);
+    struct ahi_waiter *w = s->waiter;
+    int32_t i;
+
+    if (w && w->task == me)
+        return w;
+    for (i = 0; i < s->nwaiters; i++)
+        if (s->waiters[i]->task == me) {
+            s->waiter = s->waiters[i];
+            return s->waiter;
+        }
+    if (s->nwaiters >= MAX_WAITERS)
+        return NULL;
+    w = calloc(1, sizeof *w);
+    if (!w)
+        return NULL;
+    w->task = me;
+    w->sig = AllocSignal(-1);
+    if (w->sig < 0) {
+        free(w);
+        return NULL;
+    }
+    w->timer_port = CreateMsgPort();
+    if (w->timer_port)
+        w->timer_req = (struct timerequest *)CreateIORequest(w->timer_port, sizeof(struct timerequest));
+    if (w->timer_req && OpenDevice((CONST_STRPTR)"timer.device", UNIT_MICROHZ, (struct IORequest *)w->timer_req, 0) == 0)
+        w->timer_open = 1;
+    s->waiters[s->nwaiters++] = w;
+    s->waiter = w;
+    AHI_DEBUG("waiter registered: task %p sig %ld timer %d\n", me, (long)w->sig, w->timer_open);
+    return w;
+}
+
+/* Blocks until a playback slot is free, or `timeout_ms` (1000 when <= 0)
+ * passes: 1 when a slot is free, 0 on the timeout (counted as an xrun). */
+int32_t ahi_wait_period(struct ahi_stream *s, int32_t timeout_ms)
+{
+    struct ahi_waiter *w;
+    if (!s->started)
+        return 1;
+    w = register_waiter(s);
+    if (!w) {
+        /* No signal bit: poll at the tick rate. */
+        while (s->free_slots <= 0)
+            Delay(1);
+        return 1;
+    }
+    if (timeout_ms <= 0)
+        timeout_ms = 1000;
+    while (s->free_slots <= 0) {
+        if (w->timer_open) {
+            ULONG timersig = 1UL << w->timer_port->mp_SigBit;
+            ULONG got;
+            w->timer_req->tr_node.io_Command = TR_ADDREQUEST;
+            w->timer_req->tr_time.tv_secs = timeout_ms / 1000;
+            w->timer_req->tr_time.tv_micro = (timeout_ms % 1000) * 1000;
+            SendIO((struct IORequest *)w->timer_req);
+            got = Wait((1UL << w->sig) | timersig);
+            if (!CheckIO((struct IORequest *)w->timer_req))
+                AbortIO((struct IORequest *)w->timer_req);
+            WaitIO((struct IORequest *)w->timer_req);
+            SetSignal(0, timersig);
+            if ((got & timersig) && s->free_slots <= 0) {
+                s->xruns++;
+                AHI_DEBUG("wait timed out (%ld ms), hook calls %ld\n", (long)timeout_ms, (long)s->hook_calls);
+                SetSignal(0, 1UL << w->sig);
+                return 0;
+            }
+        } else {
+            Wait(1UL << w->sig);
+        }
+    }
+    /* A wake-up that arrived after the slot was taken is of no use later. */
+    SetSignal(0, 1UL << w->sig);
+    return 1;
+}
+
+/* Copies one period of stereo 32-bit frames into the next slot; playback
+ * starts (on the control task) once every slot has been filled the first
+ * time. Returns the frames taken, 0 when no slot is free. */
+int32_t ahi_write_period(struct ahi_stream *s, const int32_t *stereo, int32_t frames)
+{
+    int32_t idx = s->write_idx;
+    int32_t n = frames < s->period ? frames : s->period;
+
+    if (s->started && s->free_slots <= 0)
+        return 0;
+    memcpy(s->slots[idx], stereo, (size_t)n * 2 * sizeof(int32_t));
+    if (n < s->period)
+        memset(s->slots[idx] + n * 2, 0, (size_t)(s->period - n) * 2 * sizeof(int32_t));
+    s->filled[idx] = 1;
+    s->write_idx = (idx + 1) % s->nslots;
+    Disable();
+    s->free_slots--;
+    Enable();
+
+    if (!s->started && s->free_slots == 0)
+        ctl_command(s, AHI_CMD_START);
+    return n;
+}
+
+/* Takes one period from the capture ring; missing frames are silence. */
+int32_t ahi_read_period(struct ahi_stream *s, int32_t *stereo, int32_t frames)
+{
+    int32_t got = 0;
+    if (!s->cap) {
+        memset(stereo, 0, (size_t)frames * 2 * sizeof(int32_t));
+        return 0;
+    }
+    while (got < frames && s->cap_fill > 0) {
+        stereo[got * 2] = s->cap[s->cap_rd * 2];
+        stereo[got * 2 + 1] = s->cap[s->cap_rd * 2 + 1];
+        s->cap_rd = (s->cap_rd + 1) % s->cap_frames;
+        Disable();
+        s->cap_fill--;
+        Enable();
+        got++;
+    }
+    if (got < frames)
+        memset(stereo + got * 2, 0, (size_t)(frames - got) * 2 * sizeof(int32_t));
+    return got;
+}
+
+uint64_t ahi_xruns(struct ahi_stream *s)
+{
+    return s->xruns + s->cap_overruns;
+}
