+#ifdef __AROS__
+/*
+==================
+Sys_AROSProgramDir
+
+The drawer the executable lives in, as an absolute "Volume:dir" path.
+
+Resolved through NameFromLock() rather than handed out as the literal
+"PROGDIR:", because the engine joins paths with PATH_SEP: "PROGDIR:" + '/' +
+"baseq3" is not a valid AmigaDOS path, while "SYS:Games/ioquake3" + '/' +
+"baseq3" is.
+==================
+*/
+char *Sys_AROSProgramDir( void )
+{
+	static char progDir[ MAX_OSPATH ] = { 0 };
+
+	if( !*progDir )
+	{
+		BPTR lock = GetProgramDir();
+
+		/* GetProgramDir() hands out the process' own lock - do not UnLock it. */
+		if( !lock || !NameFromLock( lock, progDir, sizeof( progDir ) ) )
+			Q_strncpyz( progDir, "PROGDIR:", sizeof( progDir ) );
+	}
+
+	return progDir;
+}
+#endif
