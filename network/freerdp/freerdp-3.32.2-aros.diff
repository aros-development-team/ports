+/* Profiles contain settings and optional authenticated ciphertext, never plaintext passwords. */
+#ifndef ADT_RDP_PROFILE_H
+#define ADT_RDP_PROFILE_H
+#include "native.h"
+struct adt_profile {
+    char host[512], user[512], domain[512];
+    struct native_options options;
+    char password_blob[1200];
+};
+int adt_profile_name_valid(const char *name);
+int adt_profile_load(const char *path, struct adt_profile *profile);
+int adt_profile_save(const char *path, const struct adt_profile *profile);
+#endif
diff --git a/client/AROS/tf_channels.c b/client/AROS/tf_channels.c
new file mode 100644
index 0000000..5bbe85b
--- /dev/null
+++ b/client/AROS/tf_channels.c
@@ -0,0 +1,81 @@
