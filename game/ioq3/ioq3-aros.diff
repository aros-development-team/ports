diff --git a/code/sys/con_tty.c b/code/sys/con_tty.c
index d780f55c..da476964 100644
--- a/code/sys/con_tty.c
+++ b/code/sys/con_tty.c
@@ -34,6 +34,42 @@ Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
 #include <fcntl.h>
 #include <sys/time.h>
 
+#ifdef __AROS__
+#	include <proto/dos.h>
+
+/* AROS' <termios.h> marks tcflush() as NOTIMPL and provides no symbol for it.
+ * It is only used here to discard the tail of an escape sequence after an
+ * arrow key has been handled, so dropping it costs at most a stray keystroke
+ * from a sequence the console did not recognise. */
+#	define tcflush(fd, queue) ((void)(fd), (void)(queue), 0)
+
+/*
+==================
+CON_AROSCharAvailable
+
+Is there a keystroke waiting on the console?
+
+CON_Init() asks for a non-blocking stdin with fcntl(O_NONBLOCK), and on AROS
+that silently does nothing useful: fcntl() records the flag, but read()
+dispatches straight to DOS Read() and never consults it
+(compiler/crt/posixc/read.c). The one-byte read in CON_Input() therefore blocks
+on a console handle until a key arrives - and CON_Input() runs once per frame,
+so the whole game stalls. The window opens and nothing is ever rendered into it;
+each keystroke lets exactly one frame through.
+
+WaitForChar() polls the handle with a zero timeout instead, which keeps the tty
+console usable without blocking. Input() is NULL when there is no console (a
+Workbench launch), and WaitForChar() must not be handed that.
+==================
+*/
+static qboolean CON_AROSCharAvailable( void )
+{
+	BPTR in = Input();
+
+	return ( in && WaitForChar( in, 0 ) ) ? qtrue : qfalse;
+}
+#endif
+
 /*
 =============================================================
 tty console routines
