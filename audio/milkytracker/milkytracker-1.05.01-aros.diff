diff -ruN MilkyTracker-1.05.01/src/tracker/aros/AROS_Main.cpp MilkyTracker-1.05.01.aros/src/tracker/aros/AROS_Main.cpp
--- MilkyTracker-1.05.01/src/tracker/aros/AROS_Main.cpp	1970-01-01 01:00:00.000000000 +0100
+++ MilkyTracker-1.05.01.aros/src/tracker/aros/AROS_Main.cpp	2026-04-26 10:15:30.165030552 +0200
@@ -0,0 +1,366 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <aros/debug.h>
+
+#include <exec/types.h>
+#include <proto/exec.h>
+#include <proto/intuition.h>
+#include <proto/keymap.h>
+#include <proto/timer.h>
+#include <proto/dos.h>
+#include <devices/timer.h>
+#include <devices/inputevent.h>
+#include <intuition/intuition.h>
+
+#include "BasicTypes.h"
+#include "Event.h"
+#include "Screen.h"
+#include "Tracker.h"
+#include "DisplayDevice_AROS.h"
+#include "PPMutex.h"
+#include "PPSystem_AROS.h"
+#include "AROS_KeyTranslation.h"
+#include "AudioDriver_AHI.h"
+
+static BPTR programDirLock = 0;
+
+extern "C" BPTR GetProgramDirLock()
+{
+	if (!programDirLock)
+		programDirLock = GetProgramDir();
+	return programDirLock;
+}
+
+static PPScreen        *myTrackerScreen = NULL;
+static Tracker         *myTracker       = NULL;
+static PPDisplayDevice *myDisplayDevice = NULL;
+PPMutex                *globalMutex     = NULL;
+AudioDriver_AHI *ahiDriver              = NULL;
+static bool             running         = true;
+
+static struct MsgPort      *timerPort = NULL;
+static struct timerequest  *timerReq  = NULL;
+struct Device              *TimerBase = NULL;
+static struct timeval       baseTime;
+
+static pp_int32 lastClickX = 0, lastClickY = 0;
+static pp_uint32 lastClickTime = 0, lastLBtnTime = 0, lastRBtnTime = 0;
+static bool lBtnDown = false, rBtnDown = false;
+static pp_int32 mouseX = 0, mouseY = 0;
+
+#define TIMER_TICK_MS 20
+#define DBLCLICK_MS   500
+#define DBLCLICK_DIST 4
+
+/* Timer */
+static bool openTimer()
+{
+	timerPort = CreateMsgPort();
+	if (!timerPort) return false;
+	timerReq = (struct timerequest *)CreateIORequest(timerPort, sizeof(struct timerequest));
+	if (!timerReq) return false;
+	if (OpenDevice("timer.device", UNIT_MICROHZ, (struct IORequest *)timerReq, 0) != 0) return false;
+	TimerBase = timerReq->tr_node.io_Device;
+	GetSysTime(&baseTime);
+	return true;
+}
+
+static void closeTimer()
+{
+	if (timerReq) {
+		if (TimerBase) CloseDevice((struct IORequest *)timerReq);
+		DeleteIORequest((struct IORequest *)timerReq);
+		timerReq = NULL;
+	}
+	if (timerPort) { DeleteMsgPort(timerPort); timerPort = NULL; }
+	TimerBase = NULL;
+}
+
+pp_uint32 PPGetTickCount()
+{
+	if (!TimerBase) return 0;
+	struct timeval tv;
+	GetSysTime(&tv);
+	// Signed-safe elapsed milliseconds since baseTime.
+	// Naive unsigned subtraction underflows tv_micro on second boundaries
+	// and breaks double-click / mouse-repeat timing.
+	LONG dsec  = (LONG)tv.tv_secs  - (LONG)baseTime.tv_secs;
+	LONG dusec = (LONG)tv.tv_micro - (LONG)baseTime.tv_micro;
+	if (dusec < 0) { dusec += 1000000; dsec -= 1; }
+	if (dsec < 0) return 0;
+	return (pp_uint32)(dsec * 1000 + dusec / 1000);
+}
+
+static void scheduleTimerTick()
+{
+	timerReq->tr_node.io_Command = TR_ADDREQUEST;
+	timerReq->tr_time.tv_secs = 0;
+	timerReq->tr_time.tv_micro = TIMER_TICK_MS * 1000;
+	SendIO((struct IORequest *)timerReq);
+}
+
+static void RaiseEventSerialized(PPEvent &event)
+{
+	if (globalMutex) globalMutex->lock();
+	myTrackerScreen->raiseEvent(&event);
+	if (globalMutex) globalMutex->unlock();
+}
+
+void exitEventLoop() { running = false; }
+
+void QueryKeyModifiers() { /* tracked via updateModifiers on each IDCMP event */ }
+
+static void updateModifiers(UWORD qualifier)
+{
+	if (qualifier & (IEQUALIFIER_LSHIFT | IEQUALIFIER_RSHIFT)) setKeyModifier(KeyModifierSHIFT);
+	else clearKeyModifier(KeyModifierSHIFT);
+	if (qualifier & (IEQUALIFIER_CONTROL | IEQUALIFIER_LCOMMAND | IEQUALIFIER_RCOMMAND))
+		setKeyModifier(KeyModifierCTRL);
+	else clearKeyModifier(KeyModifierCTRL);
+	if (qualifier & (IEQUALIFIER_LALT | IEQUALIFIER_RALT)) setKeyModifier(KeyModifierALT);
+	else clearKeyModifier(KeyModifierALT);
+}
+
+/* Mouse helpers */
+static void handleMouseMove(pp_int32 x, pp_int32 y)
+{
+	mouseX = x; mouseY = y;
+	PPPoint p(x, y);
+	if (lBtnDown)      { PPEvent e(eLMouseDrag, &p, sizeof(p)); RaiseEventSerialized(e); }
+	else if (rBtnDown) { PPEvent e(eRMouseDrag, &p, sizeof(p)); RaiseEventSerialized(e); }
+	else               { PPEvent e(eMouseMoved, &p, sizeof(p)); RaiseEventSerialized(e); }
+}
+
+static void handleMouseDown(int btn, pp_int32 x, pp_int32 y)
+{
+	pp_uint32 now = PPGetTickCount();
+	PPPoint p(x, y);
+	if (btn == 1) {
+		bool dbl = (now - lastClickTime < DBLCLICK_MS) && (abs(x - lastClickX) < DBLCLICK_DIST) && (abs(y - lastClickY) < DBLCLICK_DIST);
+		// Always raise eLMouseDown so the container establishes caughtControl;
+		// then additionally raise eLMouseDoubleClick when applicable.  The
+		// PPUI Container only dispatches double-click events to a caught or
+		// focused control, so skipping the second eLMouseDown drops them on
+		// the floor.
+		{ PPEvent e(eLMouseDown, &p, sizeof(p)); RaiseEventSerialized(e); }
+		if (dbl) { PPEvent e(eLMouseDoubleClick, &p, sizeof(p)); RaiseEventSerialized(e); }
+		lastClickX = x; lastClickY = y; lastClickTime = now; lastLBtnTime = now; lBtnDown = true;
+	} else if (btn == 2) {
+		PPEvent e(eRMouseDown, &p, sizeof(p)); RaiseEventSerialized(e);
+		lastRBtnTime = now; rBtnDown = true;
+	} else {
+		PPEvent e(eMMouseDown, &p, sizeof(p)); RaiseEventSerialized(e);
+	}
+}
+
+static void handleMouseUp(int btn, pp_int32 x, pp_int32 y)
+{
+	PPPoint p(x, y);
+	if (btn == 1) { PPEvent e(eLMouseUp, &p, sizeof(p)); RaiseEventSerialized(e); lBtnDown = false; }
+	else if (btn == 2) { PPEvent e(eRMouseUp, &p, sizeof(p)); RaiseEventSerialized(e); rBtnDown = false; }
+	else { PPEvent e(eMMouseUp, &p, sizeof(p)); RaiseEventSerialized(e); }
+}
+
+static void checkMouseRepeat()
+{
+	pp_uint32 now = PPGetTickCount();
+	PPPoint p(mouseX, mouseY);
+	if (lBtnDown && (now - lastLBtnTime > 25)) { PPEvent e(eLMouseRepeat, &p, sizeof(p)); RaiseEventSerialized(e); }
+	if (rBtnDown && (now - lastRBtnTime > 25)) { PPEvent e(eRMouseRepeat, &p, sizeof(p)); RaiseEventSerialized(e); }
+}
+
+/* Keyboard */
+static void handleKeyDown(UWORD rawkey, UWORD qualifier)
+{
+	updateModifiers(qualifier);
+	pp_uint16 vk = toVK(rawkey, qualifier);
+	pp_uint16 sc = toSC(rawkey);
+	pp_uint16 keyData[3] = { vk, sc, 0 };
+	PPEvent keyEvent(eKeyDown, &keyData, sizeof(keyData));
+	RaiseEventSerialized(keyEvent);
+
+	char ascii = toChar(rawkey, qualifier);
+	if (ascii >= 32 && ascii < 127) {
+		pp_uint8 charData[2] = { (pp_uint8)ascii, 0 };
+		PPEvent charEvent(eKeyChar, &charData, sizeof(charData));
+		RaiseEventSerialized(charEvent);
+	}
+}
+
+static void handleKeyUp(UWORD rawkey, UWORD qualifier)
+{
+	updateModifiers(qualifier);
+	pp_uint16 vk = toVK(rawkey, qualifier);
+	pp_uint16 sc = toSC(rawkey);
+	pp_uint16 keyData[3] = { vk, sc, 0 };
+	PPEvent e(eKeyUp, &keyData, sizeof(keyData));
+	RaiseEventSerialized(e);
+}
+
+/* IDCMP processing */
+static void processIDCMPMessages()
+{
+	struct Window *win = myDisplayDevice->getWindow();
+	if (!win) return;
+	struct IntuiMessage *msg;
+
+	while ((msg = (struct IntuiMessage *)GetMsg(win->UserPort)))
+	{
+		ULONG cls = msg->Class;
+		UWORD code = msg->Code;
+		UWORD qual = msg->Qualifier;
+		WORD mx = msg->MouseX - win->BorderLeft;
+		WORD my = msg->MouseY - win->BorderTop;
+		ReplyMsg((struct Message *)msg);
+
+		pp_int32 sx = mx, sy = my;
+		myDisplayDevice->adjust(sx, sy);
+
+		switch (cls) {
+		case IDCMP_CLOSEWINDOW: {
+			PPEvent e(eAppQuit);
+			RaiseEventSerialized(e);
+			// eAppQuit alone is unhandled in the codebase.  The SDL port
+			// follows up with myTracker->shutDown() which runs the
+			// "save changes?" dialog and returns true if the user confirmed.
+			if (globalMutex) globalMutex->lock();
+			bool ok = myTracker->shutDown();
+			if (globalMutex) globalMutex->unlock();
+			if (ok) running = false;
+			break;
+		}
+		case IDCMP_MOUSEMOVE: if (sx >= 0 && sy >= 0) handleMouseMove(sx, sy); break;
+		case IDCMP_MOUSEBUTTONS:
+			switch (code) {
+			case SELECTDOWN: handleMouseDown(1, sx, sy); break;
+			case SELECTUP:   handleMouseUp(1, sx, sy); break;
+			case MENUDOWN:   handleMouseDown(2, sx, sy); break;
+			case MENUUP:     handleMouseUp(2, sx, sy); break;
+			case MIDDLEDOWN: handleMouseDown(3, sx, sy); break;
+			case MIDDLEUP:   handleMouseUp(3, sx, sy); break;
+			} break;
+		case IDCMP_RAWKEY: {
+			UWORD raw = code & ~IECODE_UP_PREFIX;
+			/* Modifier keys: shift=0x60-0x61, caps=0x62, ctrl=0x63, alt=0x64-0x65, amiga=0x66-0x67 */
+			if (raw >= 0x60 && raw <= 0x67) updateModifiers(qual);
+			else if (code & IECODE_UP_PREFIX) handleKeyUp(raw, qual);
+			else handleKeyDown(raw, qual);
+			break;
+		}
+		case IDCMP_REFRESHWINDOW:
+			BeginRefresh(win); EndRefresh(win, TRUE);
+			myTrackerScreen->paint();
+			break;
+		default: break;
+		}
+	}
+}
+
+/* Modal loop support (called from AROS_ModalLoop) */
+void processIDCMPForModal()
+{
+	struct Window *win = myDisplayDevice->getWindow();
+	if (!win) return;
+	ULONG timerSig = 1L << timerPort->mp_SigBit;
+	ULONG winSig = 1L << win->UserPort->mp_SigBit;
+	ULONG sigs = Wait(timerSig | winSig);
+
+	if (sigs & winSig) {
+		if (globalMutex) globalMutex->lock();
+		processIDCMPMessages();
+		if (globalMutex) globalMutex->unlock();
+	}
+	if (sigs & timerSig) {
+		GetMsg(timerPort);
+		if (globalMutex) globalMutex->lock();
+		PPEvent e(eTimer); RaiseEventSerialized(e);
+		if (globalMutex) globalMutex->unlock();
+		scheduleTimerTick();
+	}
+}
+
+/* Main event loop */
+static void eventLoop()
+{
+	struct Window *win = myDisplayDevice->getWindow();
+	if (!win) return;
+	ULONG timerSig = 1L << timerPort->mp_SigBit;
+	ULONG winSig = 1L << win->UserPort->mp_SigBit;
+	ULONG ahiSig = ahiDriver ? ahiDriver->getSignalMask() : 0;
+
+	scheduleTimerTick();
+	while (running) {
+		ULONG sigs = Wait(timerSig | winSig | ahiSig | SIGBREAKF_CTRL_C);
+		if (sigs & SIGBREAKF_CTRL_C) { running = false; break; }
+		if (sigs & winSig) processIDCMPMessages();
+		if ((sigs & ahiSig) && ahiDriver) ahiDriver->pump();
+		if (sigs & timerSig) {
+			GetMsg(timerPort);
+			PPEvent e(eTimer); RaiseEventSerialized(e);
+			checkMouseRepeat();
+			if (running) scheduleTimerTick();
+		}
+	}
+}
+
+/* Init / shutdown */
+static bool initTracker(int argc, char *argv[])
+{
+	D(bug("[MT] openTimer...\n"));
+	if (!openTimer()) { D(bug("Failed to open timer.device\n")); return false; }
+	D(bug("[MT] creating mutex...\n"));
+	globalMutex = new PPMutex();
+
+	D(bug("[MT] creating Tracker...\n"));
+	myTracker = new Tracker();
+
+	D(bug("[MT] getWindowSizeFromDatabase...\n"));
+	PPSize windowSize = myTracker->getWindowSizeFromDatabase();
+	D(bug("[MT] window size: %dx%d\n", windowSize.width, windowSize.height));
+
+	D(bug("[MT] creating DisplayDevice...\n"));
+	myDisplayDevice = new PPDisplayDevice(windowSize.width, windowSize.height, 1, 32);
+	D(bug("[MT] DisplayDevice created, window=%p\n", (void*)myDisplayDevice->getWindow()));
+	if (!myDisplayDevice->getWindow()) { D(bug("Failed to create window\n")); return false; }
+
+	D(bug("[MT] calling init()...\n"));
+	myDisplayDevice->init();
+
+	D(bug("[MT] creating PPScreen...\n"));
+	myTrackerScreen = new PPScreen(myDisplayDevice, myTracker);
+	D(bug("[MT] setScreen...\n"));
+	myTracker->setScreen(myTrackerScreen);
+	D(bug("[MT] startUp...\n"));
+	myTracker->startUp(true);
+	D(bug("[MT] startUp done\n"));
+
+	if (argc > 1) {
+		PPSystemString fileName(argv[argc - 1]);
+		PPEvent e(eFileDragDropped, &fileName, sizeof(PPSystemString));
+		RaiseEventSerialized(e);
+	}
+	return true;
+}
+
+static void shutdownTracker()
+{
+	delete myTracker; myTracker = NULL;
+	delete myTrackerScreen; myTrackerScreen = NULL;
+	delete myDisplayDevice; myDisplayDevice = NULL;
+	// AHI driver is a process-wide singleton (kept alive across
+	// transient AudioDriverManagers).  Tear it down explicitly here so
+	// the AHI device is closed and its msgport/IORequests/buffers are
+	// freed before the executable is unloaded.
+	if (ahiDriver) { delete ahiDriver; ahiDriver = NULL; }
+	delete globalMutex; globalMutex = NULL;
+	closeTimer();
+}
+
+int main(int argc, char *argv[])
+{
+	if (!initTracker(argc, argv)) { shutdownTracker(); return 1; }
+	eventLoop();
+	shutdownTracker();
+	return 0;
+}
diff -ruN MilkyTracker-1.05.01/src/tracker/aros/AROS_ModalLoop.cpp MilkyTracker-1.05.01.aros/src/tracker/aros/AROS_ModalLoop.cpp
--- MilkyTracker-1.05.01/src/tracker/aros/AROS_ModalLoop.cpp	1970-01-01 01:00:00.000000000 +0100
+++ MilkyTracker-1.05.01.aros/src/tracker/aros/AROS_ModalLoop.cpp	2026-04-26 10:15:30.164625165 +0200
@@ -0,0 +1,37 @@
+#include "AROS_ModalLoop.h"
+#include "Event.h"
+#include "Screen.h"
+#include "DialogBase.h"
+#include "PPMutex.h"
+
+void processIDCMPForModal();
+extern PPMutex* globalMutex;
+
+PPModalDialog::ReturnCodes AROS_runModalLoop(PPScreen* screen, PPDialogBase* dialog)
+{
+	bool exitModalLoop = false;
+
+	pp_uint32 screenEnableStackCount = 0;
+	while (!screen->isDisplayEnabled())
+	{
+		screen->enableDisplay(true);
+		screenEnableStackCount++;
+	}
+
+	ModalLoopResponder modalLoopResponder(exitModalLoop);
+	dialog->setResponder(&modalLoopResponder);
+
+	EventListenerInterface* eventListener = screen->detachEventListener();
+	CustomEventListener customEventListener(eventListener);
+	screen->attachEventListener(&customEventListener);
+	dialog->show();
+
+	if (globalMutex) globalMutex->unlock();
+	while (!exitModalLoop) processIDCMPForModal();
+	if (globalMutex) globalMutex->lock();
+
+	screen->attachEventListener(eventListener);
+	while (screenEnableStackCount > 0) { screen->enableDisplay(false); screenEnableStackCount--; }
+
+	return modalLoopResponder.getReturnCode();
+}
diff -ruN MilkyTracker-1.05.01/src/tracker/aros/AROS_ModalLoop.h MilkyTracker-1.05.01.aros/src/tracker/aros/AROS_ModalLoop.h
