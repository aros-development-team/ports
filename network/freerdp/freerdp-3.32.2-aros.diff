index 0000000..1339307
--- /dev/null
+++ b/client/AROS/native.c
@@ -0,0 +1,411 @@
+/* ADT AROS native desktop backend. */
+#include "native.h"
+#include "profile.h"
+#include "vault.h"
+#include <sys/stat.h>
+#include <stdlib.h>
+#include <intuition/intuition.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/intuition.h>
+#include <proto/cybergraphics.h>
+#include <cybergraphx/cybergraphics.h>
+int native_desktop_size(uint32_t *width, uint32_t *height)
+{
+    struct Screen *screen = LockPubScreen(NULL);
+    if (!screen) return 0;
+    *width = screen->Width > 340 ? screen->Width - 20 : 320;
+    *height = screen->Height > 280 ? screen->Height - 40 : 240;
+    UnlockPubScreen(NULL, screen); return 1;
+}
+int native_screen_size(uint32_t *width, uint32_t *height)
+{
+    struct Screen *screen=LockPubScreen(NULL); if (!screen) return 0;
+    *width=screen->Width; *height=screen->Height; UnlockPubScreen(NULL,screen); return 1;
+}
+struct native_window { struct Window *window; int fullscreen, resize; uint32_t saved_width, saved_height; };
+static struct Window *open_desktop(uint32_t width, uint32_t height, int fullscreen, int resize)
+{
+    struct Screen *screen = LockPubScreen(NULL);
+    if (!screen) return NULL;
+    if (fullscreen) { width = screen->Width; height = screen->Height; }
+    struct Window *w = OpenWindowTags(NULL, WA_Title, (IPTR)(fullscreen ? NULL : "ADT Remote Desktop - Ctrl+Alt+Enter: fullscreen"),
+        WA_PubScreen, (IPTR)screen, WA_Left, 0, WA_Top, 0,
+        WA_InnerWidth, width, WA_InnerHeight, height,
+        WA_Borderless, fullscreen, WA_DragBar, !fullscreen, WA_DepthGadget, !fullscreen,
+        WA_CloseGadget, !fullscreen, WA_SizeGadget, resize && !fullscreen,
+        WA_MinWidth, 200, WA_MinHeight, 200, WA_MaxWidth, screen->Width, WA_MaxHeight, screen->Height,
+        WA_Activate, TRUE, WA_ReportMouse, TRUE,
+        WA_IDCMP, IDCMP_CLOSEWINDOW | IDCMP_RAWKEY | IDCMP_MOUSEBUTTONS |
+                  IDCMP_MOUSEMOVE | IDCMP_REFRESHWINDOW | IDCMP_INACTIVEWINDOW | IDCMP_NEWSIZE,
+        TAG_DONE);
+    UnlockPubScreen(NULL, screen); return w;
+}
+struct native_window *native_open(uint32_t width, uint32_t height, int fullscreen, int resize)
+{
+    struct native_window *n = calloc(1, sizeof(*n));
+    if (!n) return NULL;
+    n->saved_width=width; n->saved_height=height; n->fullscreen=fullscreen; n->resize=resize;
+    if (fullscreen) native_desktop_size(&n->saved_width,&n->saved_height);
+    n->window=open_desktop(width,height,fullscreen,resize);
+    if (!n->window) { free(n); return NULL; }
+    return n;
+}
+int native_toggle_fullscreen(struct native_window *n, uint32_t *width, uint32_t *height)
+{
+    if (!n || !n->window) return 0;
+    if (!n->fullscreen) {
+        n->saved_width=n->window->Width-n->window->BorderLeft-n->window->BorderRight;
+        n->saved_height=n->window->Height-n->window->BorderTop-n->window->BorderBottom;
+    }
+    struct Window *next=open_desktop(n->saved_width,n->saved_height,!n->fullscreen,n->resize);
+    if (!next) return 0;
+    struct Message *m; while ((m=GetMsg(n->window->UserPort))) ReplyMsg(m);
+    CloseWindow(n->window); n->window=next; n->fullscreen=!n->fullscreen;
+    *width=next->Width-next->BorderLeft-next->BorderRight;
+    *height=next->Height-next->BorderTop-next->BorderBottom;
+    return 1;
+}
+void native_close(struct native_window *n)
+{
+    if (!n) return;
+    if (n->window) {
+        struct Message *message;
+        while ((message = GetMsg(n->window->UserPort))) ReplyMsg(message);
+        CloseWindow(n->window);
+    }
+    free(n);
+}
+int native_poll(struct native_window *n, struct native_event *event)
+{
+    struct IntuiMessage *msg = (struct IntuiMessage *)GetMsg(n->window->UserPort);
+    if (!msg) return 0;
+    event->kind = 0; event->code = msg->Code; event->qualifier = msg->Qualifier;
+    event->x = msg->MouseX - n->window->BorderLeft;
+    event->y = msg->MouseY - n->window->BorderTop;
+    switch (msg->Class) {
+    case IDCMP_CLOSEWINDOW: event->kind = 1; break;
+    case IDCMP_INACTIVEWINDOW: event->kind = 6; break;
+    case IDCMP_NEWSIZE:
+        event->kind=7;
+        event->x=n->window->Width-n->window->BorderLeft-n->window->BorderRight;
+        event->y=n->window->Height-n->window->BorderTop-n->window->BorderBottom;
+        break;
+    case IDCMP_RAWKEY: event->kind = 2; break;
+    case IDCMP_MOUSEMOVE: event->kind = 3; break;
+    case IDCMP_MOUSEBUTTONS: event->kind = 4; break;
+    case IDCMP_REFRESHWINDOW:
+        BeginRefresh(n->window); EndRefresh(n->window, TRUE);
+        event->kind = 5; break;
+    }
+    ReplyMsg((struct Message *)msg);
+    return 1;
+}
+int native_paint(struct native_window *n, const void *pixels, uint32_t width,
+                 uint32_t height, uint32_t stride)
+{
+    if (!n || !pixels || width > 65535 || height > 65535 || stride > 65535) return 0;
+    uint32_t w = n->window->Width - n->window->BorderLeft - n->window->BorderRight;
+    uint32_t h = n->window->Height - n->window->BorderTop - n->window->BorderBottom;
+    if (width < w) w = width;
+    if (height < h) h = height;
+    WritePixelArray((void *)pixels, 0, 0, stride, n->window->RPort,
+        n->window->BorderLeft, n->window->BorderTop, w, h, RECTFMT_BGRA32);
+    return 1;
+}
+
+#include <stdio.h>
+#include <string.h>
+#include <libraries/mui.h>
+#include <proto/muimaster.h>
+#include <clib/alib_protos.h>
+/* MUI owns the masked field only while this modal dialog is open. */
+static Object *field(const char *text, int secret)
+{
+    return MUI_NewObject(MUIC_String, MUIA_Frame, MUIV_Frame_String,
+        MUIA_String_MaxLen, 512, MUIA_String_Secret, secret,
+        MUIA_String_Contents, (IPTR)(text ? text : ""), TAG_DONE);
+}
+static Object *label(const char *text)
+{
+    return MUI_NewObject(MUIC_Text, MUIA_Text_Contents, (IPTR)text, TAG_DONE);
+}
+static void clear_secret(char *secret)
+{
+    if (!secret) return;
+    volatile char *q = secret; size_t n = strlen(secret);
+    while (n--) *q++ = 0;
+    free(secret);
+}
+static const char *field_text(Object *o)
+{
+    IPTR value=0; GetAttr(MUIA_String_Contents,o,&value); return value ? (const char *)value : "";
+}
+void native_error(const char *message)
+{
+    struct EasyStruct easy={sizeof(easy),0,"Remote Desktop settings","%s","OK"};
+    IPTR args[]={(IPTR)message}; EasyRequestArgs(NULL,&easy,NULL,(RAWARG)args);
+}
+/* The unlocking password exists only in masked widgets and temporary memory. */
+static void wipe_field(Object *object)
+{
+    char *text=(char *)field_text(object);volatile char *q=text;size_t n=strlen(text);
+    while(n--)*q++=0;
+    SetAttrs(object,MUIA_String_Contents,(IPTR)"",TAG_DONE);
+}
+static int unlock_password(int saving,char output[512])
+{
+    output[0]=0;
+    Object *first=field("",1),*second=saving?field("",1):NULL;
+    Object *accept=MUI_MakeObject(MUIO_Button,(IPTR)(saving?"Save":"Unlock"));
+    Object *cancel=MUI_MakeObject(MUIO_Button,(IPTR)"Cancel");
+    Object *fields=MUI_NewObject(MUIC_Group,MUIA_Group_Columns,2,
+        MUIA_Group_Child,(IPTR)label("Master password"),MUIA_Group_Child,(IPTR)first,TAG_DONE);
+    if(saving){DoMethod(fields,OM_ADDMEMBER,(IPTR)label("Confirm master password"));DoMethod(fields,OM_ADDMEMBER,(IPTR)second);}
+    Object *buttons=MUI_NewObject(MUIC_Group,MUIA_Group_Horiz,TRUE,
+        MUIA_Group_Child,(IPTR)accept,MUIA_Group_Child,(IPTR)cancel,TAG_DONE);
+    Object *group=MUI_NewObject(MUIC_Group,MUIA_Group_Child,(IPTR)fields,MUIA_Group_Child,(IPTR)buttons,TAG_DONE);
+    Object *win=MUI_NewObject(MUIC_Window,MUIA_Window_Title,(IPTR)(saving?"Save password":"Unlock saved password"),
+        MUIA_Window_Width,400,MUIA_Window_RootObject,(IPTR)group,TAG_DONE);
+    Object *app=MUI_NewObject(MUIC_Application,MUIA_Application_Title,(IPTR)"Remote Desktop",MUIA_Application_Window,(IPTR)win,TAG_DONE);
+    if(!app){if(win)MUI_DisposeObject(win);else if(group)MUI_DisposeObject(group);return 0;}
+    DoMethod(accept,MUIM_Notify,MUIA_Pressed,FALSE,(IPTR)app,2,MUIM_Application_ReturnID,1);
+    DoMethod(cancel,MUIM_Notify,MUIA_Pressed,FALSE,(IPTR)app,2,MUIM_Application_ReturnID,2);
+    DoMethod(win,MUIM_Notify,MUIA_Window_CloseRequest,TRUE,(IPTR)app,2,MUIM_Application_ReturnID,2);
+    SetAttrs(win,MUIA_Window_Open,TRUE,TAG_DONE);
+    IPTR opened=0;GetAttr(MUIA_Window_Open,win,&opened);int result=0;
+    while(opened){
+        ULONG signals=0;IPTR id=DoMethod(app,MUIM_Application_NewInput,(IPTR)&signals);
+        if(id==1){
+            const char *text=field_text(first);size_t n=strlen(text);
+            if(!n || n>511){native_error("Enter a master password to protect the saved password.");continue;}
+            if(saving && strcmp(text,field_text(second))){native_error("The master passwords do not match.");continue;}
+            memcpy(output,text,n+1);result=1;break;
+        }
+        if(id==2 || id==MUIV_Application_ReturnID_Quit)break;
+        if(signals && (Wait(signals|SIGBREAKF_CTRL_C)&SIGBREAKF_CTRL_C))break;
+    }
+    wipe_field(first);if(second)wipe_field(second);
+    SetAttrs(win,MUIA_Window_Open,FALSE,TAG_DONE);MUI_DisposeObject(app);return result;
+}
+static void wipe_buffer(char *buffer,size_t size)
+{
+    volatile char *p=buffer;while(size--)*p++=0;
+}
+static int directory_path(const char *text,char output[260])
+{
+    output[0]=0;
+    if (!*text) return 1;
+    if (strlen(text)>259 || strchr(text,',')) return 0;
+    BPTR lock=Lock((CONST_STRPTR)text,ACCESS_READ); if (!lock) return 0;
+    struct FileInfoBlock *info=AllocDosObject(DOS_FIB,NULL);
+    int ok=info && Examine(lock,info) && info->fib_DirEntryType>0 &&
+        NameFromLock(lock,(STRPTR)output,260) && !strchr(output,',');
+    if (info) FreeDosObject(DOS_FIB,info);
+    UnLock(lock); return ok;
+}
+static int native_form(char **host, char **user, char **password, char **domain, int editable, struct native_options *options)
+{
+    Object *server = field(*host, 0);
+    if (server && !editable) SetAttrs(server, MUIA_Disabled, TRUE, TAG_DONE);
+    Object *u = field(*user, 0), *p = field("", 1), *d = field(*domain, 0);
+    Object *ok = MUI_MakeObject(MUIO_Button, (IPTR)"Connect");
+    Object *cancel = MUI_MakeObject(MUIO_Button, (IPTR)"Cancel");
+    if (!server || !u || !p || !d || !ok || !cancel) {
+        if (server) MUI_DisposeObject(server);
+        if (u) MUI_DisposeObject(u); if (p) MUI_DisposeObject(p);
+        if (d) MUI_DisposeObject(d); if (ok) MUI_DisposeObject(ok);
+        if (cancel) MUI_DisposeObject(cancel); return 0;
+    }
+    Object *checks[7] = {0};
+    Object *profile_name=NULL, *pin=NULL, *load=NULL, *save=NULL, *profiles=NULL, *directory=NULL;
+    Object *remember=NULL;
+    Object *sharing = NULL;
+    if (options) {
+        for (unsigned i = 0; i < 7; i++) checks[i] = MUI_MakeObject(MUIO_Checkmark, (IPTR)NULL);
+        if (!checks[0] || !checks[1] || !checks[2] || !checks[3] || !checks[4] || !checks[5] || !checks[6]) {
+            for (unsigned i = 0; i < 7; i++) if (checks[i]) MUI_DisposeObject(checks[i]);
+            MUI_DisposeObject(server); MUI_DisposeObject(u); MUI_DisposeObject(p);
+            MUI_DisposeObject(d); MUI_DisposeObject(ok); MUI_DisposeObject(cancel); return 0;
+        }
+        sharing = MUI_NewObject(MUIC_Group, MUIA_Group_Columns, 2,
+            MUIA_Group_Child, (IPTR)checks[0], MUIA_Group_Child, (IPTR)label("Share text clipboard"),
+            MUIA_Group_Child, (IPTR)checks[1], MUIA_Group_Child, (IPTR)label("Play remote audio"),
+            MUIA_Group_Child, (IPTR)checks[2], MUIA_Group_Child, (IPTR)label("Share microphone"),
+            MUIA_Group_Child, (IPTR)checks[3], MUIA_Group_Child, (IPTR)label("Share printer (text only)"),
+            MUIA_Group_Child, (IPTR)checks[4], MUIA_Group_Child, (IPTR)label("Fullscreen (Ctrl+Alt+Enter)"),
+            MUIA_Group_Child, (IPTR)checks[5], MUIA_Group_Child, (IPTR)label("Resize remote desktop"),
+            MUIA_Group_Child, (IPTR)checks[6], MUIA_Group_Child, (IPTR)label("Share printer (PDF/XPS documents)"), TAG_DONE);
+        remember=MUI_MakeObject(MUIO_Checkmark,(IPTR)NULL);
+        DoMethod(sharing,OM_ADDMEMBER,(IPTR)remember);
+        DoMethod(sharing,OM_ADDMEMBER,(IPTR)label("Remember password"));
+        profile_name=field("default",0); pin=field("",0); directory=field("",0);
+        load=MUI_MakeObject(MUIO_Button,(IPTR)"Load profile");
+        save=MUI_MakeObject(MUIO_Button,(IPTR)"Save profile");
+        profiles=MUI_NewObject(MUIC_Group,MUIA_Group_Columns,2,
+            MUIA_Group_Child,(IPTR)label("Profile name"),MUIA_Group_Child,(IPTR)profile_name,
+            MUIA_Group_Child,(IPTR)load,MUIA_Group_Child,(IPTR)save,
+            MUIA_Group_Child,(IPTR)label("SHA-256 pin (optional)"),MUIA_Group_Child,(IPTR)pin,
+            MUIA_Group_Child,(IPTR)label("Shared folder (blank = off)"),MUIA_Group_Child,(IPTR)directory,TAG_DONE);
+    }
+    if (!sharing) sharing = MUI_NewObject(MUIC_Group, TAG_DONE);
+    if (!profiles) profiles = MUI_NewObject(MUIC_Group, TAG_DONE);
+    Object *fields = MUI_NewObject(MUIC_Group, MUIA_Group_Columns, 2,
+        MUIA_Group_Child, (IPTR)label("Server"), MUIA_Group_Child, (IPTR)server,
+        MUIA_Group_Child, (IPTR)label("Username"), MUIA_Group_Child, (IPTR)u,
+        MUIA_Group_Child, (IPTR)label("Password"), MUIA_Group_Child, (IPTR)p,
+        MUIA_Group_Child, (IPTR)label("Domain (optional)"), MUIA_Group_Child, (IPTR)d, TAG_DONE);
+    Object *actions=MUI_NewObject(MUIC_Group, MUIA_Group_Horiz, TRUE,
+        MUIA_Group_Child,(IPTR)ok, MUIA_Group_Child,(IPTR)cancel, TAG_DONE);
+    Object *group=MUI_NewObject(MUIC_Group,
+        MUIA_Group_Child,(IPTR)profiles,
+        MUIA_Group_Child,(IPTR)fields,
+        MUIA_Group_Child, (IPTR)sharing,
+        MUIA_Group_Child, (IPTR)actions, TAG_DONE);
+    Object *win = MUI_NewObject(MUIC_Window, MUIA_Window_Title, (IPTR)"Remote Desktop login",
+        MUIA_Window_Width, 520, MUIA_Window_RootObject, (IPTR)group, TAG_DONE);
+    Object *app = MUI_NewObject(MUIC_Application, MUIA_Application_Title,
+        (IPTR)"Remote Desktop", MUIA_Application_Window, (IPTR)win, TAG_DONE);
+    if (!app) { if (win) MUI_DisposeObject(win); else if (group) MUI_DisposeObject(group); return 0; }
+    DoMethod(ok, MUIM_Notify, MUIA_Pressed, FALSE, (IPTR)app, 2, MUIM_Application_ReturnID, 1);
+    DoMethod(cancel, MUIM_Notify, MUIA_Pressed, FALSE, (IPTR)app, 2, MUIM_Application_ReturnID, 2);
+    DoMethod(win, MUIM_Notify, MUIA_Window_CloseRequest, TRUE, (IPTR)app, 2, MUIM_Application_ReturnID, 2);
+    if (options) {
+        DoMethod(load,MUIM_Notify,MUIA_Pressed,FALSE,(IPTR)app,2,MUIM_Application_ReturnID,3);
+        DoMethod(save,MUIM_Notify,MUIA_Pressed,FALSE,(IPTR)app,2,MUIM_Application_ReturnID,4);
+    }
+    SetAttrs(win, MUIA_Window_Open, TRUE, TAG_DONE);
+    IPTR opened = 0; GetAttr(MUIA_Window_Open, win, &opened);
+    int result = 0;
+    while (opened) {
+        ULONG signals = 0; IPTR id = DoMethod(app, MUIM_Application_NewInput, (IPTR)&signals);
+        char canonical_directory[260]={0};
+        if (options && (id==1 || id==4)) {
+            IPTR text_print=0, document_print=0;
+            GetAttr(MUIA_Selected,checks[3],&text_print);GetAttr(MUIA_Selected,checks[6],&document_print);
+            if (text_print && document_print) { native_error("Choose either text or document printer sharing."); continue; }
+            if (!directory_path(field_text(directory),canonical_directory)) {
+                native_error("Choose an existing shared folder without commas, or leave it blank to disable folder sharing."); continue;
+            }
+        }
+        if (options && (id==3 || id==4)) {
+            const char *name=field_text(profile_name);
+            if (!adt_profile_name_valid(name)) { native_error("Use 1-48 letters, digits, underscores or hyphens for a profile name."); continue; }
+            char path[128]; snprintf(path,sizeof(path),"PROGDIR:Profiles/%s.conf",name);
+            struct adt_profile settings={0};
+            if (id==3) {
+                if (!adt_profile_load(path,&settings)) { native_error("Cannot load profile: missing file or invalid settings."); continue; }
+                char loaded_password[512]={0},unlock[512]={0};
+                if(*settings.password_blob){
+                    if(!unlock_password(0,unlock))continue;
+                    int unlocked=adt_password_open(&settings,unlock,loaded_password);
+                    wipe_buffer(unlock,sizeof(unlock));
+                    if(!unlocked){wipe_buffer(loaded_password,sizeof(loaded_password));native_error("Cannot unlock the saved password.\nCheck the master password or restore an unchanged profile.");continue;}
+                }
+                char *old_secret=(char *)field_text(p);
+                volatile char *wipe=old_secret; size_t left=strlen(old_secret);
+                while (left--) *wipe++=0;
+                SetAttrs(p,MUIA_String_Contents,(IPTR)loaded_password,TAG_DONE);
+                wipe_buffer(loaded_password,sizeof(loaded_password));
+                SetAttrs(remember,MUIA_Selected,!!*settings.password_blob,TAG_DONE);
+                SetAttrs(server,MUIA_String_Contents,(IPTR)settings.host,TAG_DONE);
+                SetAttrs(u,MUIA_String_Contents,(IPTR)settings.user,TAG_DONE);
+                SetAttrs(d,MUIA_String_Contents,(IPTR)settings.domain,TAG_DONE);
+                SetAttrs(pin,MUIA_String_Contents,(IPTR)settings.options.fingerprint,TAG_DONE);
+                SetAttrs(directory,MUIA_String_Contents,(IPTR)settings.options.directory,TAG_DONE);
+                int values[]={settings.options.clipboard,settings.options.sound,settings.options.microphone,
+                    settings.options.printer,settings.options.fullscreen,settings.options.resize,settings.options.documents};
+                for (unsigned i=0;i<7;i++) SetAttrs(checks[i],MUIA_Selected,values[i],TAG_DONE);
+                native_error(*settings.password_blob ? "Profile and saved password loaded." : "Profile loaded. Enter your password to connect.");
+            } else {
+                snprintf(settings.host,sizeof(settings.host),"%s",field_text(server));
+                snprintf(settings.user,sizeof(settings.user),"%s",field_text(u));
+                snprintf(settings.domain,sizeof(settings.domain),"%s",field_text(d));
+                const char *fingerprint=field_text(pin);
+                if (strlen(fingerprint)>64) { native_error("A SHA-256 pin must contain exactly 64 hexadecimal digits."); continue; }
+                strcpy(settings.options.fingerprint,fingerprint);
+                strcpy(settings.options.directory,canonical_directory);
+                IPTR selected[7]={0}; for (unsigned i=0;i<7;i++) GetAttr(MUIA_Selected,checks[i],&selected[i]);
+                settings.options.clipboard=!!selected[0]; settings.options.sound=!!selected[1];
+                settings.options.microphone=!!selected[2]; settings.options.printer=!!selected[3];
+                settings.options.fullscreen=!!selected[4]; settings.options.resize=!!selected[5]; settings.options.documents=!!selected[6];
+                IPTR save_password=0;GetAttr(MUIA_Selected,remember,&save_password);
+                if(save_password){
+                    char unlock[512]={0};if(!unlock_password(1,unlock))continue;
+                    int sealed=adt_password_seal(&settings,unlock,field_text(p),settings.password_blob);
+                    wipe_buffer(unlock,sizeof(unlock));
+                    if(!sealed){native_error("Cannot save the password. The existing profile has not been changed.");continue;}
+                }
+                mkdir("PROGDIR:Profiles",0700);
+                native_error(adt_profile_save(path,&settings) ? "Profile saved." : "Cannot save settings. Check the pin and that the application folder is writable.");
+            }
+            continue;
+        }
+        if (id == 1) {
+            if (options) {
+                const char *fingerprint=field_text(pin); size_t n=strlen(fingerprint);
+                int valid=!n || n==64;
+                for (size_t i=0;valid && i<n;i++) if (!strchr("0123456789abcdefABCDEF",fingerprint[i])) valid=0;
+                if (!valid) { native_error("A SHA-256 pin must contain exactly 64 hexadecimal digits."); continue; }
+                strcpy(options->fingerprint,fingerprint);
+                strcpy(options->directory,canonical_directory);
+            }
+            IPTR ut = 0, pt = 0, dt = 0, ht = 0;
+            GetAttr(MUIA_String_Contents, server, &ht);
+            if (!ht || !*(char *)ht) continue;
+            GetAttr(MUIA_String_Contents, u, &ut); GetAttr(MUIA_String_Contents, p, &pt);
+            GetAttr(MUIA_String_Contents, d, &dt);
+            char *nh = strdup((char *)ht);
+            char *nu = strdup((char *)ut), *np = strdup((char *)pt), *nd = strdup((char *)dt);
+            if (nh && nu && np && nd) {
+                free(*host); *host = nh;
+                free(*user); clear_secret(*password); free(*domain);
+                *user = nu; *password = np; *domain = nd; result = 1;
+                if (options) {
+                    IPTR selected[7] = {0};
+                    for (unsigned i = 0; i < 7; i++) GetAttr(MUIA_Selected, checks[i], &selected[i]);
+                    options->clipboard = selected[0] != 0; options->sound = selected[1] != 0;
+                    options->microphone = selected[2] != 0; options->printer = selected[3] != 0;
+                    options->fullscreen = selected[4] != 0; options->resize = selected[5] != 0; options->documents = selected[6] != 0;
+                }
+            } else { free(nh); free(nu); clear_secret(np); free(nd); }
+            break;
+        }
+        if (id == 2 || id == MUIV_Application_ReturnID_Quit) break;
+        if (signals && (Wait(signals | SIGBREAKF_CTRL_C) & SIGBREAKF_CTRL_C)) break;
+    }
+    /* Wipe the widget buffer before MUI releases its storage. */
+    IPTR secret = 0; GetAttr(MUIA_String_Contents, p, &secret);
+    if (secret) { volatile char *q = (char *)secret; size_t n = strlen((char *)secret); while (n--) *q++ = 0; }
+    SetAttrs(win, MUIA_Window_Open, FALSE, TAG_DONE);
+    MUI_DisposeObject(app);
+    return result;
+}
+
+int native_credentials(const char *host, char **user, char **password, char **domain)
+{
+    char *copy = strdup(host ? host : "");
+    if (!copy) return 0;
+    int result = native_form(&copy, user, password, domain, 0, NULL);
+    free(copy); return result;
+}
+int native_connection(char **host, char **user, char **password, char **domain, struct native_options *options)
+{
+    return native_form(host, user, password, domain, 1, options);
+}
+
+int native_confirm_certificate(const char *host, uint16_t port, const char *name,
+                               const char *fingerprint)
+{
+    if (!host || !fingerprint || strlen(fingerprint) > 128) return 0;
+    char text[1024];
+    snprintf(text, sizeof(text),
+        "Certificate validation failed.\nServer: %.160s:%u\nCertificate name: %.160s\n"
+        "Fingerprint:\n%.48s\n%.80s\n"
+        "Verify this fingerprint independently before accepting.",
+        host, (unsigned)port, name ? name : "", fingerprint,
+        strlen(fingerprint) > 48 ? fingerprint + 48 : "");
+    struct EasyStruct easy = { sizeof(easy), 0, "Remote Desktop certificate", "%s", "Accept once|Reject" };
+    IPTR args[] = {(IPTR)text};
+    return EasyRequestArgs(NULL, &easy, NULL, (RAWARG)args) == 1;
+}
