diff --git a/channels/drive/client/drive_path_aros.h b/channels/drive/client/drive_path_aros.h
new file mode 100644
index 0000000..a915c45
--- /dev/null
+++ b/channels/drive/client/drive_path_aros.h
@@ -0,0 +1,39 @@
+/* AROS DOS gives empty path components parent-directory semantics. Never
+ * forward them, volume separators or dot components from a remote server. */
+#ifndef ADT_DRIVE_PATH_AROS_H
+#define ADT_DRIVE_PATH_AROS_H
+#include <stdlib.h>
+#include <string.h>
+static WCHAR *drive_path_aros(const WCHAR *base,const WCHAR *path,size_t length)
+{
+    if (!base || (!path && length)) return NULL;
+    size_t b=0; while (b<260 && base[b]) b++;
+    if (!b || b==260 || length>32768) return NULL;
+    while (b && (base[b-1]=='/' || base[b-1]=='\\')) b--;
+    if (!b) return NULL;
+    if (length && path[length-1]==0) length--;
+    size_t start=0;
+    if (length && (path[0]=='/' || path[0]=='\\')) start=1;
+    size_t end=length;
+    if (end>start && (path[end-1]=='/' || path[end-1]=='\\')) end--;
+    size_t component=start;
+    for (size_t i=start;i<=end;i++) {
+        if (i<end && (path[i]<32 || path[i]==127 || path[i]==':')) return NULL;
+        if (i==end || path[i]=='/' || path[i]=='\\') {
+            size_t n=i-component;
+            if (!n && end>start) return NULL;
+            if ((n==1 && path[component]=='.') ||
+                (n==2 && path[component]=='.' && path[component+1]=='.')) return NULL;
+            component=i+1;
+        }
+    }
+    /* Reject doubled root/trailing separators too. */
+    if (length>1 && ((path[0]=='/' || path[0]=='\\') && (path[1]=='/' || path[1]=='\\'))) return NULL;
+    if (end>start && (path[end-1]=='/' || path[end-1]=='\\')) return NULL;
+    size_t n=end-start, join=n && base[b-1]!=':';
+    WCHAR *result=calloc(b+join+n+1,sizeof(*result)); if (!result) return NULL;
+    memcpy(result,base,b*sizeof(*result)); if (join) result[b++]='/';
+    for (size_t i=0;i<n;i++) result[b+i]=path[start+i]=='\\' ? '/' : path[start+i];
+    return result;
+}
+#endif
