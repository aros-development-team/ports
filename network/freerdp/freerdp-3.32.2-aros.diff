diff --git a/channels/audin/client/ahi/ahi_native.c b/channels/audin/client/ahi/ahi_native.c
new file mode 100644
index 0000000..097493d
--- /dev/null
+++ b/channels/audin/client/ahi/ahi_native.c
@@ -0,0 +1,50 @@
+/* Native AHI ABI only; no WinPR types in this translation unit. */
+#include "ahi_native.h"
+#include <devices/ahi.h>
+#include <proto/exec.h>
+#include <stdlib.h>
+struct ahi_capture { struct MsgPort *port; struct AHIRequest *io; int opened, pending; uint32_t rate; uint16_t channels; };
+struct ahi_capture *ahi_capture_open(uint32_t rate, uint16_t channels)
+{
+    if (rate < 8000 || rate > 96000 || (channels != 1 && channels != 2)) return NULL;
+    struct ahi_capture *c = calloc(1, sizeof(*c));
+    if (!c) return NULL;
+    c->port = CreateMsgPort();
+    if (c->port) c->io = (struct AHIRequest *)CreateIORequest(c->port, sizeof(*c->io));
+    if (!c->io) { ahi_capture_close(c); return NULL; }
+    c->io->ahir_Version = 4;
+    if (OpenDevice(AHINAME, 0, (struct IORequest *)c->io, 0)) { ahi_capture_close(c); return NULL; }
+    c->opened = 1; c->rate = rate; c->channels = channels;
+    c->io->ahir_Frequency = rate;
+    c->io->ahir_Type = channels == 1 ? AHIST_M16S : AHIST_S16S;
+    c->io->ahir_Std.io_Command = CMD_READ;
+    return c;
+}
+int ahi_capture_start(struct ahi_capture *c, void *buffer, size_t length)
+{
+    if (!c || c->pending || !buffer || !length || length > 65536) return 0;
+    /* CMD_READ converts ahir_Frequency to an internal ratio and trashes input fields.
+       Restore every request, retaining only the documented continuation offset. */
+    c->io->ahir_Frequency = c->rate;
+    c->io->ahir_Type = c->channels == 1 ? AHIST_M16S : AHIST_S16S;
+    c->io->ahir_Std.io_Error = 0;
+    c->io->ahir_Std.io_Data = buffer; c->io->ahir_Std.io_Length = length;
+    SendIO((struct IORequest *)c->io); c->pending = 1; return 1;
+}
+int ahi_capture_poll(struct ahi_capture *c, size_t *actual)
+{
+    if (!c || !c->pending || !actual) return -1;
+    if (!CheckIO((struct IORequest *)c->io)) return 0;
+    int error = WaitIO((struct IORequest *)c->io); c->pending = 0;
+    *actual = c->io->ahir_Std.io_Actual;
+    return error ? -1 : 1;
+}
+void ahi_capture_close(struct ahi_capture *c)
+{
+    if (!c) return;
+    if (c->pending) { AbortIO((struct IORequest *)c->io); WaitIO((struct IORequest *)c->io); }
+    if (c->opened) CloseDevice((struct IORequest *)c->io);
+    if (c->io) DeleteIORequest((struct IORequest *)c->io);
+    if (c->port) DeleteMsgPort(c->port);
+    free(c);
+}
