diff --git a/client/AROS/vault.c b/client/AROS/vault.c
new file mode 100644
index 0000000..b9933d4
--- /dev/null
+++ b/client/AROS/vault.c
@@ -0,0 +1,77 @@
+#include "vault.h"
+#include <openssl/evp.h>
+#include <openssl/rand.h>
+#include <openssl/crypto.h>
+#include <string.h>
+/* RDP1 | salt16 | nonce12 | tag16 | ciphertext (0..511 bytes), hex encoded.
+ * Fixed work factor prevents a modified file selecting unbounded KDF work.
+ * Endpoint/account fields are authenticated so editing them cannot silently
+ * send a recovered password to another server or account. */
+#define HEADER 48
+#define ITERATIONS 210000
+static int aad(EVP_CIPHER_CTX *ctx,const struct adt_profile *p,int seal)
+{
+    const char *fields[]={p->host,p->user,p->domain,p->options.fingerprint};int n;
+    for(unsigned i=0;i<4;i++) {
+        size_t len=strnlen(fields[i],512)+1;
+        if(len>512)return 0;
+        if(seal ? !EVP_EncryptUpdate(ctx,NULL,&n,(const unsigned char*)fields[i],(int)len)
+                : !EVP_DecryptUpdate(ctx,NULL,&n,(const unsigned char*)fields[i],(int)len))return 0;
+    }
+    return 1;
+}
+static int key_for(const char *unlock,const unsigned char *salt,unsigned char key[32])
+{
+    size_t n=unlock?strlen(unlock):0;
+    return n && n<=511 && PKCS5_PBKDF2_HMAC(unlock,(int)n,salt,16,ITERATIONS,EVP_sha256(),32,key);
+}
+int adt_password_seal(const struct adt_profile *p,const char *unlock,const char *password,char output[1200])
+{
+    unsigned char blob[HEADER+512]={0},key[32]={0};int n=0,end=0,ok=0;
+    EVP_CIPHER_CTX *ctx=EVP_CIPHER_CTX_new();output[0]=0;
+    size_t length=password?strlen(password):512;
+    if(!ctx || length>511)goto done;
+    memcpy(blob,"RDP1",4);
+    if(RAND_bytes(blob+4,28)!=1 || !key_for(unlock,blob+4,key) ||
+       !EVP_EncryptInit_ex(ctx,EVP_aes_256_gcm(),NULL,NULL,NULL) ||
+       !EVP_CIPHER_CTX_ctrl(ctx,EVP_CTRL_GCM_SET_IVLEN,12,NULL) ||
+       !EVP_EncryptInit_ex(ctx,NULL,NULL,key,blob+20) || !aad(ctx,p,1) ||
+       !EVP_EncryptUpdate(ctx,blob+HEADER,&n,(const unsigned char*)password,(int)length) ||
+       !EVP_EncryptFinal_ex(ctx,blob+HEADER+n,&end) || n+end!=(int)length ||
+       !EVP_CIPHER_CTX_ctrl(ctx,EVP_CTRL_GCM_GET_TAG,16,blob+32))goto done;
+    static const char hex[]="0123456789abcdef";
+    for(size_t i=0;i<HEADER+length;i++){output[2*i]=hex[blob[i]>>4];output[2*i+1]=hex[blob[i]&15];}
+    output[2*(HEADER+length)]=0;ok=1;
+ done:
+    EVP_CIPHER_CTX_free(ctx);OPENSSL_cleanse(key,sizeof(key));OPENSSL_cleanse(blob,sizeof(blob));return ok;
+}
+static int nibble(char c)
+{
+    if(c>='0' && c<='9')return c-'0';
+    if(c>='a' && c<='f')return c-'a'+10;
+    return -1;
+}
+int adt_password_open(const struct adt_profile *p,const char *unlock,char password[512])
+{
+    unsigned char blob[HEADER+512]={0},key[32]={0},plain[512]={0};int n=0,end=0,ok=0;
+    EVP_CIPHER_CTX *ctx=EVP_CIPHER_CTX_new();password[0]=0;
+    size_t length=strnlen(p->password_blob,sizeof(p->password_blob));
+    if(!ctx || length<HEADER*2 || length>2*(HEADER+511) || length%2)goto done;
+    for(size_t i=0;i<length/2;i++){
+        int a=nibble(p->password_blob[2*i]),b=nibble(p->password_blob[2*i+1]);
+        if(a<0 || b<0)goto done;
+        blob[i]=(unsigned char)((a<<4)|b);
+    }
+    length=length/2-HEADER;
+    if(memcmp(blob,"RDP1",4) || !key_for(unlock,blob+4,key) ||
+       !EVP_DecryptInit_ex(ctx,EVP_aes_256_gcm(),NULL,NULL,NULL) ||
+       !EVP_CIPHER_CTX_ctrl(ctx,EVP_CTRL_GCM_SET_IVLEN,12,NULL) ||
+       !EVP_DecryptInit_ex(ctx,NULL,NULL,key,blob+20) || !aad(ctx,p,0) ||
+       !EVP_DecryptUpdate(ctx,plain,&n,blob+HEADER,(int)length) ||
+       !EVP_CIPHER_CTX_ctrl(ctx,EVP_CTRL_GCM_SET_TAG,16,blob+32) ||
+       !EVP_DecryptFinal_ex(ctx,plain+n,&end) || n+end!=(int)length ||
+       memchr(plain,0,length))goto done;
+    memcpy(password,plain,length);password[length]=0;ok=1;
+ done:
+    EVP_CIPHER_CTX_free(ctx);OPENSSL_cleanse(key,sizeof(key));OPENSSL_cleanse(blob,sizeof(blob));OPENSSL_cleanse(plain,sizeof(plain));return ok;
+}
