+
+/// The AROS clipboard: unit 0 through clipboard.device, as IFF FTXT text in
+/// ISO-8859-1.
+#[cfg(target_os = "aros")]
+mod aros {
+    use copypasta::ClipboardProvider;
+
+    pub struct Clipboard;
+
+    impl ClipboardProvider for Clipboard {
+        fn get_contents(&mut self) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
+            let mut len = 0;
+            let text = unsafe { aros_gui_sys::aros_gui_clip_read(&mut len) };
+            if text.is_null() {
+                return Ok(String::new());
+            }
+            let latin1 = unsafe { std::slice::from_raw_parts(text, len as usize) };
+            let contents = latin1.iter().map(|&byte| char::from(byte)).collect();
+            unsafe { aros_gui_sys::aros_gui_clip_free(text) };
+            Ok(contents)
+        }
+
+        fn set_contents(&mut self, text: String) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
+            let latin1: Vec<u8> =
+                text.chars().map(|c| u8::try_from(u32::from(c)).unwrap_or(b'?')).collect();
+            let len = i32::try_from(latin1.len())?;
+            if unsafe { aros_gui_sys::aros_gui_clip_write(latin1.as_ptr(), len) } != 0 {
+                return Err("could not write to the clipboard".into());
+            }
+            Ok(())
         }
     }
 }
