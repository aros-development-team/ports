+#include <devices/rawkeycodes.h>
+#include <devices/inputevent.h>
+
+pp_uint16 toVK(pp_uint16 rawkey, pp_uint16 qualifier)
+{
+	switch (rawkey)
+	{
+		/* Letters */
+		case RAWKEY_A:		return 'A';
+		case RAWKEY_B:		return 'B';
+		case RAWKEY_C:		return 'C';
+		case RAWKEY_D:		return 'D';
+		case RAWKEY_E:		return 'E';
+		case RAWKEY_F:		return 'F';
+		case RAWKEY_G:		return 'G';
+		case RAWKEY_H:		return 'H';
+		case RAWKEY_I:		return 'I';
+		case RAWKEY_J:		return 'J';
+		case RAWKEY_K:		return 'K';
+		case RAWKEY_L:		return 'L';
+		case RAWKEY_M:		return 'M';
+		case RAWKEY_N:		return 'N';
+		case RAWKEY_O:		return 'O';
+		case RAWKEY_P:		return 'P';
+		case RAWKEY_Q:		return 'Q';
+		case RAWKEY_R:		return 'R';
+		case RAWKEY_S:		return 'S';
+		case RAWKEY_T:		return 'T';
+		case RAWKEY_U:		return 'U';
+		case RAWKEY_V:		return 'V';
+		case RAWKEY_W:		return 'W';
+		case RAWKEY_X:		return 'X';
+		case RAWKEY_Y:		return 'Y';
+		case RAWKEY_Z:		return 'Z';
+
+		/* Numbers */
+		case RAWKEY_0:		return '0';
+		case RAWKEY_1:		return '1';
+		case RAWKEY_2:		return '2';
+		case RAWKEY_3:		return '3';
+		case RAWKEY_4:		return '4';
+		case RAWKEY_5:		return '5';
+		case RAWKEY_6:		return '6';
+		case RAWKEY_7:		return '7';
+		case RAWKEY_8:		return '8';
+		case RAWKEY_9:		return '9';
+
+		/* Numeric keypad */
+		case RAWKEY_KP_0:		return VK_NUMPAD0;
+		case RAWKEY_KP_1:		return VK_NUMPAD1;
+		case RAWKEY_KP_2:		return VK_NUMPAD2;
+		case RAWKEY_KP_3:		return VK_NUMPAD3;
+		case RAWKEY_KP_4:		return VK_NUMPAD4;
+		case RAWKEY_KP_5:		return VK_NUMPAD5;
+		case RAWKEY_KP_6:		return VK_NUMPAD6;
+		case RAWKEY_KP_7:		return VK_NUMPAD7;
+		case RAWKEY_KP_8:		return VK_NUMPAD8;
+		case RAWKEY_KP_9:		return VK_NUMPAD9;
+		case RAWKEY_KP_DIVIDE:		return VK_DIVIDE;
+		case RAWKEY_KP_MULTIPLY:	return VK_MULTIPLY;
+		case RAWKEY_KP_MINUS:		return VK_SUBTRACT;
+		case RAWKEY_KP_PLUS:		return VK_ADD;
+		case RAWKEY_KP_ENTER:		return VK_SEPARATOR;
+		case RAWKEY_KP_DECIMAL:		return VK_DECIMAL;
+
+		/* Modifier keys */
+		case RAWKEY_LALT:		return VK_ALT;
+		case RAWKEY_RALT:		return VK_RMENU;
+		case RAWKEY_LSHIFT:		return VK_SHIFT;
+		case RAWKEY_RSHIFT:		return VK_SHIFT;
+		case RAWKEY_LCONTROL:	return VK_LCONTROL;
+		case RAWKEY_CAPSLOCK:	return VK_CAPITAL;
+
+		/* Other non-character keys */
+		case RAWKEY_RETURN:		return VK_RETURN;
+		case RAWKEY_TAB:		return VK_TAB;
+		case RAWKEY_SPACE:		return VK_SPACE;
+		case RAWKEY_ESCAPE:		return VK_ESCAPE;
+		case RAWKEY_INSERT:		return VK_INSERT;
+		case RAWKEY_DELETE:		return VK_DELETE;
+		case RAWKEY_BACKSPACE:	return VK_BACK;
+
+		case RAWKEY_LEFT:		return VK_LEFT;
+		case RAWKEY_RIGHT:		return VK_RIGHT;
+		case RAWKEY_DOWN:		return VK_DOWN;
+		case RAWKEY_UP:			return VK_UP;
+
+		case RAWKEY_PAGEUP:		return VK_PRIOR;
+		case RAWKEY_PAGEDOWN:	return VK_NEXT;
+		case RAWKEY_HOME:		return VK_HOME;
+		case RAWKEY_END:		return VK_END;
+
+		/* Function keys */
+		case RAWKEY_F1:		return VK_F1;
+		case RAWKEY_F2:		return VK_F2;
+		case RAWKEY_F3:		return VK_F3;
+		case RAWKEY_F4:		return VK_F4;
+		case RAWKEY_F5:		return VK_F5;
+		case RAWKEY_F6:		return VK_F6;
+		case RAWKEY_F7:		return VK_F7;
+		case RAWKEY_F8:		return VK_F8;
+		case RAWKEY_F9:		return VK_F9;
+		case RAWKEY_F10:	return VK_F10;
+		case RAWKEY_F11:	return VK_F11;
+		case RAWKEY_F12:	return VK_F12;
+
+		/* Special characters */
+		case RAWKEY_TILDE:		return 0xC0;
+		case RAWKEY_MINUS:		return 0xBE;
+		case RAWKEY_EQUAL:		return 0xDD;
+		case RAWKEY_COMMA:		return 0xBC;
+		case RAWKEY_PERIOD:		return 0xBF;
+		case RAWKEY_LESSGREATER:	return 0xE2;
+
+		default:			return 0;
+	}
+}
+
+pp_uint16 toSC(pp_uint16 rawkey)
+{
+	switch (rawkey)
+	{
+		/* Letters */
+		case RAWKEY_A:		return SC_A;
+		case RAWKEY_B:		return SC_B;
+		case RAWKEY_C:		return SC_C;
+		case RAWKEY_D:		return SC_D;
+		case RAWKEY_E:		return SC_E;
+		case RAWKEY_F:		return SC_F;
+		case RAWKEY_G:		return SC_G;
+		case RAWKEY_H:		return SC_H;
+		case RAWKEY_I:		return SC_I;
+		case RAWKEY_J:		return SC_J;
+		case RAWKEY_K:		return SC_K;
+		case RAWKEY_L:		return SC_L;
+		case RAWKEY_M:		return SC_M;
+		case RAWKEY_N:		return SC_N;
+		case RAWKEY_O:		return SC_O;
+		case RAWKEY_P:		return SC_P;
+		case RAWKEY_Q:		return SC_Q;
+		case RAWKEY_R:		return SC_R;
+		case RAWKEY_S:		return SC_S;
+		case RAWKEY_T:		return SC_T;
+		case RAWKEY_U:		return SC_U;
+		case RAWKEY_V:		return SC_V;
+		case RAWKEY_W:		return SC_W;
+		case RAWKEY_X:		return SC_X;
+		case RAWKEY_Y:		return SC_Z; /* MilkyTracker scancodes are based on German layout */
+		case RAWKEY_Z:		return SC_Y; /* so Y <-> Z swap is correct here */
+
+		/* Numbers */
+		case RAWKEY_0:		return SC_0;
+		case RAWKEY_1:		return SC_1;
+		case RAWKEY_2:		return SC_2;
+		case RAWKEY_3:		return SC_3;
+		case RAWKEY_4:		return SC_4;
+		case RAWKEY_5:		return SC_5;
+		case RAWKEY_6:		return SC_6;
+		case RAWKEY_7:		return SC_7;
+		case RAWKEY_8:		return SC_8;
+		case RAWKEY_9:		return SC_9;
+
+		/* Special characters */
+		case RAWKEY_MINUS:			return SC_SS;
+		case RAWKEY_EQUAL:			return SC_TICK;
+		case RAWKEY_LBRACKET:		return SC_UE;
+		case RAWKEY_RBRACKET:		return SC_PLUS;
+
+		case RAWKEY_SEMICOLON:		return SC_OE;
+		case RAWKEY_QUOTE:			return SC_AE;
+		case RAWKEY_BACKSLASH:		return SC_SHARP;
+
+		case RAWKEY_LESSGREATER:	return SC_SMALLERGREATER;
+		case RAWKEY_COMMA:			return SC_COMMA;
+		case RAWKEY_PERIOD:			return SC_PERIOD;
+		case RAWKEY_SLASH:			return SC_MINUS;
+		case RAWKEY_TILDE:			return SC_WTF;
+
+		/* Modifiers */
+		case RAWKEY_CAPSLOCK:		return SC_CAPSLOCK;
+
+		default:					return 0;
+	}
+}
+
+char toChar(pp_uint16 rawkey, pp_uint16 qualifier)
+{
+	/* Map rawkeys to printable ASCII characters */
+	bool shift = (qualifier & (IEQUALIFIER_LSHIFT | IEQUALIFIER_RSHIFT)) != 0;
+
+	/* Letters */
+	if (rawkey >= RAWKEY_A && rawkey <= RAWKEY_Z)
+	{
+		/* This is tricky because RAWKEY_A..Z aren't contiguous.
+		   Use the toVK mapping to get the letter. */
+		char c = (char)toVK(rawkey, qualifier);
+		if (c >= 'A' && c <= 'Z')
+		{
+			if (!shift)
+				c = c - 'A' + 'a';
+			return c;
+		}
+	}
+
+	/* Numbers and shifted symbols */
+	switch (rawkey)
+	{
+		case RAWKEY_0: return shift ? ')' : '0';
+		case RAWKEY_1: return shift ? '!' : '1';
+		case RAWKEY_2: return shift ? '@' : '2';
+		case RAWKEY_3: return shift ? '#' : '3';
+		case RAWKEY_4: return shift ? '$' : '4';
+		case RAWKEY_5: return shift ? '%' : '5';
+		case RAWKEY_6: return shift ? '^' : '6';
+		case RAWKEY_7: return shift ? '&' : '7';
+		case RAWKEY_8: return shift ? '*' : '8';
+		case RAWKEY_9: return shift ? '(' : '9';
+		case RAWKEY_SPACE:		return ' ';
+		case RAWKEY_MINUS:		return shift ? '_' : '-';
+		case RAWKEY_EQUAL:		return shift ? '+' : '=';
+		case RAWKEY_LBRACKET:	return shift ? '{' : '[';
+		case RAWKEY_RBRACKET:	return shift ? '}' : ']';
+		case RAWKEY_BACKSLASH:	return shift ? '|' : '\\';
+		case RAWKEY_SEMICOLON:	return shift ? ':' : ';';
+		case RAWKEY_QUOTE:		return shift ? '"' : '\'';
+		case RAWKEY_TILDE:		return shift ? '~' : '`';
+		case RAWKEY_COMMA:		return shift ? '<' : ',';
+		case RAWKEY_PERIOD:		return shift ? '>' : '.';
+		case RAWKEY_SLASH:		return shift ? '?' : '/';
+		default: return 0;
+	}
+}
