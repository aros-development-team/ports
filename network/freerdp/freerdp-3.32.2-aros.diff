diff --git a/client/AROS/profile.c b/client/AROS/profile.c
new file mode 100644
index 0000000..8a9837e
--- /dev/null
+++ b/client/AROS/profile.c
@@ -0,0 +1,98 @@
+#include "profile.h"
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+#include <errno.h>
+#include <unistd.h>
+int adt_profile_name_valid(const char *s)
+{
+    if (!s || !*s || strlen(s) > 48) return 0;
+    for (; *s; s++) if (!isalnum((unsigned char)*s) && *s != '-' && *s != '_') return 0;
+    return 1;
+}
+static int text_valid(const char *s, size_t n)
+{
+    size_t i;
+    for (i = 0; i < n && s[i]; i++) if ((unsigned char)s[i] < 32 || (unsigned char)s[i] == 127) return 0;
+    return i < n;
+}
+static int valid(const struct adt_profile *p)
+{
+    if (!text_valid(p->host, sizeof(p->host)) || !text_valid(p->user, sizeof(p->user)) ||
+        !text_valid(p->domain, sizeof(p->domain)) || !text_valid(p->options.fingerprint, sizeof(p->options.fingerprint))) return 0;
+    if (!text_valid(p->options.directory,sizeof(p->options.directory)) || strchr(p->options.directory,',') ||
+        (p->options.printer && p->options.documents)) return 0;
+    size_t secret_len=strnlen(p->password_blob,sizeof(p->password_blob));
+    if(secret_len && (secret_len<96 || secret_len>1118 || secret_len%2))return 0;
+    for(size_t i=0;i<secret_len;i++)if(!strchr("0123456789abcdef",p->password_blob[i]))return 0;
+    if (*p->options.fingerprint) {
+        if (strlen(p->options.fingerprint) != 64) return 0;
+        for (unsigned i = 0; i < 64; i++) if (!isxdigit((unsigned char)p->options.fingerprint[i])) return 0;
+    }
+    return 1;
+}
+int adt_profile_load(const char *path, struct adt_profile *out)
+{
+    FILE *f = fopen(path, "rb"); if (!f) return 0;
+    struct adt_profile p = {0}; char line[1300]; unsigned seen = 0; int ok = 1;
+    while (fgets(line, sizeof(line), f)) {
+        size_t n = strlen(line);
+        if (!n || line[n-1] != '\n') { ok = 0; break; }
+        line[--n] = 0; if (n && line[n-1] == '\r') line[--n] = 0;
+        char *value = strchr(line, '='); if (!value) { ok = 0; break; } *value++ = 0;
+        unsigned bit = 0; char *dst = NULL; size_t cap = 0; int *flag = NULL;
+        if (!strcmp(line, "host")) { bit=1; dst=p.host; cap=sizeof(p.host); }
+        else if (!strcmp(line, "user")) { bit=2; dst=p.user; cap=sizeof(p.user); }
+        else if (!strcmp(line, "domain")) { bit=4; dst=p.domain; cap=sizeof(p.domain); }
+        else if (!strcmp(line, "fingerprint")) { bit=8; dst=p.options.fingerprint; cap=sizeof(p.options.fingerprint); }
+        else if (!strcmp(line, "clipboard")) { bit=16; flag=&p.options.clipboard; }
+        else if (!strcmp(line, "sound")) { bit=32; flag=&p.options.sound; }
+        else if (!strcmp(line, "microphone")) { bit=64; flag=&p.options.microphone; }
+        else if (!strcmp(line, "printer")) { bit=128; flag=&p.options.printer; }
+        else if (!strcmp(line, "fullscreen")) { bit=256; flag=&p.options.fullscreen; }
+        else if (!strcmp(line, "resize")) { bit=512; flag=&p.options.resize; }
+        else if (!strcmp(line, "documents")) { bit=1024; flag=&p.options.documents; }
+        else if (!strcmp(line, "directory")) { bit=2048; dst=p.options.directory; cap=sizeof(p.options.directory); }
+        else if (!strcmp(line,"password_encrypted")) { bit=4096; dst=p.password_blob; cap=sizeof(p.password_blob); }
+        else { ok=0; break; } /* Reject plaintext passwords and unsupported settings. */
+        if (seen & bit) { ok=0; break; } seen |= bit;
+        if (dst) { if (strlen(value) >= cap) { ok=0; break; } strcpy(dst, value); }
+        else { if (strcmp(value, "0") && strcmp(value, "1")) { ok=0; break; } *flag=*value-'0'; }
+    }
+    if (ferror(f)) ok=0;
+    fclose(f);
+    if (!ok || (seen & 1023) != 1023 || !valid(&p)) return 0;
+    *out=p; return 1;
+}
+int adt_profile_save(const char *path, const struct adt_profile *p)
+{
+    if (!valid(p)) return 0;
+    char temp[1024], backup[1024];
+    if (snprintf(temp,sizeof(temp),"%s.%lu.tmp",path,(unsigned long)getpid()) >= (int)sizeof(temp) ||
+        snprintf(backup,sizeof(backup),"%s.bak",path) >= (int)sizeof(backup)) return 0;
+    FILE *f=fopen(temp,"wb"); if (!f) return 0;
+    int ok=fprintf(f,"host=%s\nuser=%s\ndomain=%s\nfingerprint=%s\nclipboard=%d\nsound=%d\nmicrophone=%d\nprinter=%d\nfullscreen=%d\nresize=%d\ndocuments=%d\ndirectory=%s\n",
+        p->host,p->user,p->domain,p->options.fingerprint,!!p->options.clipboard,!!p->options.sound,
+        !!p->options.microphone,!!p->options.printer,!!p->options.fullscreen,!!p->options.resize,!!p->options.documents,p->options.directory) > 0;
+    if(ok && *p->password_blob)ok=fprintf(f,"password_encrypted=%s\n",p->password_blob)>0;
+    if (fclose(f)) ok=0;
+    if (!ok) { remove(temp); return 0; }
+    /* AROS stdio rename deletes an existing target before Rename(). Preserve
+     * the old file first, and retain it as .bak even after a successful save. */
+    FILE *old=fopen(path,"rb"); int existed=old!=NULL;
+    if (old) fclose(old);
+    else if (errno!=ENOENT) { remove(temp); return 0; }
+    struct adt_profile prior={0};
+    int forgetting=existed && !*p->password_blob && adt_profile_load(path,&prior) && *prior.password_blob;
+    if (existed && rename(path,backup)) { remove(temp); return 0; }
+    if (rename(temp,path)==0) {
+        /* Opting out must not retain the old encrypted password in our backup. */
+        if(forgetting && remove(backup))return 0;
+        return 1;
+    }
+    if (existed) {
+        /* On a further disk failure the backup remains available for recovery. */
+        int restored=rename(backup,path); (void)restored;
+    }
+    remove(temp); return 0;
+}
