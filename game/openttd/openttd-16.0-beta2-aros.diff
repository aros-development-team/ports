+
+/**
+ * Get a seed from AROS' entropy.resource.
+ *
+ * Worth the detour because the wall clock is a poor seed here: a Raspberry Pi
+ * has no battery-backed clock, so time() reads much the same at every boot and
+ * every run would generate the same world.
+ *
+ * The resource is addressed directly rather than through arc4random(), which
+ * also draws on it: arc4random() cannot report failure, so when the resource
+ * is absent it quietly degrades to a xorshift seeded from that same clock.
+ * Going through GetEntropy() keeps that case visible.
+ *
+ * EntropyBase is deliberately a local - the inline stubs pick the base out of
+ * whatever scope they are called from, which avoids having to define the
+ * global the proto header declares. The resource is never closed.
+ */
+static uint32_t AROSGetRandomSeed()
+{
+	struct Library *EntropyBase = (struct Library *)OpenResource(ENTROPYNAME);
+	uint32_t seed;
+
+	if (EntropyBase != nullptr && GetEntropy(&seed, sizeof(seed)) == (LONG)sizeof(seed)) return seed;
+
+	Debug(misc, 0, "entropy.resource unavailable, falling back to the clock for the random seed");
+	return (uint32_t)time(nullptr);
+}
+#endif
+
