+use super::AudioDeviceOption;
+
+/// The audio modes ahi.device offers, through the engine's AHI backend.
+pub(crate) fn discover_aros_audio_devices() -> Vec<AudioDeviceOption> {
+    maolan_engine::audio_devices::discover_ahi_audio_devices()
+        .into_iter()
+        .map(AudioDeviceOption::from)
+        .collect()
