diff --git a/channels/rdpsnd/client/ahi/rdpsnd_ahi.c b/channels/rdpsnd/client/ahi/rdpsnd_ahi.c
new file mode 100644
index 0000000..fbe2d99
--- /dev/null
+++ b/channels/rdpsnd/client/ahi/rdpsnd_ahi.c
@@ -0,0 +1,52 @@
+#include <freerdp/config.h>
+#include <winpr/crt.h>
+#include "rdpsnd_main.h"
+#include "ahi_output.h"
+typedef struct {
+    rdpsndDevicePlugin iface;
+    struct ahi_output *output;
+    UINT32 volume;
+} AhiOutput;
+static BOOL supported(rdpsndDevicePlugin *dev, const AUDIO_FORMAT *f)
+{
+    WINPR_UNUSED(dev);
+    return f && f->wFormatTag == WAVE_FORMAT_PCM && f->wBitsPerSample == 16 &&
+        (f->nChannels == 1 || f->nChannels == 2) && f->nSamplesPerSec >= 8000 &&
+        f->nSamplesPerSec <= 96000 && f->nBlockAlign == f->nChannels * 2 &&
+        f->nAvgBytesPerSec == f->nSamplesPerSec * f->nBlockAlign && f->cbSize == 0;
+}
+static void close_output(rdpsndDevicePlugin *dev)
+{
+    AhiOutput *a = (AhiOutput *)dev;
+    ahi_output_close(a->output); a->output = NULL;
+}
+static BOOL open_output(rdpsndDevicePlugin *dev, const AUDIO_FORMAT *f, UINT32 latency)
+{
+    WINPR_UNUSED(latency);
+    if (!supported(dev, f)) return FALSE;
+    AhiOutput *a = (AhiOutput *)dev;
+    close_output(dev);
+    a->output = ahi_output_open(f->nSamplesPerSec, f->nChannels);
+    if (!a->output) WLog_ERR(TAG, "Cannot open AHI playback unit 0");
+    return a->output != NULL;
+}
+static UINT32 get_volume(rdpsndDevicePlugin *dev) { return ((AhiOutput *)dev)->volume; }
+static BOOL set_volume(rdpsndDevicePlugin *dev, UINT32 volume) { ((AhiOutput *)dev)->volume = volume; return TRUE; }
+static UINT play(rdpsndDevicePlugin *dev, const BYTE *data, size_t size)
+{
+    AhiOutput *a = (AhiOutput *)dev;
+    if (!ahi_output_play(a->output, data, size, a->volume)) WLog_ERR(TAG, "AHI playback failed");
+    return 0; /* synchronous playback has no queued samples on return */
+}
+static void free_output(rdpsndDevicePlugin *dev) { close_output(dev); free(dev); }
+FREERDP_ENTRY_POINT(UINT VCAPITYPE ahi_freerdp_rdpsnd_client_subsystem_entry(PFREERDP_RDPSND_DEVICE_ENTRY_POINTS entry))
+{
+    AhiOutput *a = calloc(1, sizeof(*a));
+    if (!a) return CHANNEL_RC_NO_MEMORY;
+    a->volume = 0xffffffff;
+    a->iface.FormatSupported = supported; a->iface.Open = open_output;
+    a->iface.Close = close_output; a->iface.Free = free_output;
+    a->iface.GetVolume = get_volume; a->iface.SetVolume = set_volume; a->iface.Play = play;
+    entry->pRegisterRdpsndDevice(entry->rdpsnd, &a->iface);
+    return CHANNEL_RC_OK;
+}
