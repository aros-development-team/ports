+
+#ifndef __AROS_MODALLOOP_H__
+#define __AROS_MODALLOOP_H__
+
+#include "BasicTypes.h"
+#include "Event.h"
+#include "PPModalDialog.h"
+
+class CustomEventListener : public EventListenerInterface
+{
+private:
+	EventListenerInterface* oldEventListener;
+
+public:
+	CustomEventListener(EventListenerInterface* oldListener) :
+		oldEventListener(oldListener)
+	{
+	}
+
+	virtual pp_int32 handleEvent(PPObject* sender, PPEvent* event)
+	{
+		if (event->getID() == eTimer)
+		{
+			return oldEventListener->handleEvent(sender, event);
+		}
+		return 0;
+	}
+};
+
+class ModalLoopResponder : public DialogResponder
+{
+private:
+	bool& exitModalLoop;
+	PPModalDialog::ReturnCodes returnCode;
+
+public:
+	ModalLoopResponder(bool& exitModalLoopFlag) :
+		exitModalLoop(exitModalLoopFlag),
+		returnCode(PPModalDialog::ReturnCodeCANCEL)
+	{
+	}
+
+	PPModalDialog::ReturnCodes getReturnCode() { return returnCode; }
+
+	virtual pp_int32 ActionOkay(PPObject* sender)
+	{
+		exitModalLoop = true;
+		returnCode = PPModalDialog::ReturnCodeOK;
+		return 0;
+	}
+
+	virtual pp_int32 ActionCancel(PPObject* sender)
+	{
+		exitModalLoop = true;
+		returnCode = PPModalDialog::ReturnCodeCANCEL;
+		return 0;
+	}
+
+	virtual pp_int32 ActionNo(PPObject* sender)
+	{
+		exitModalLoop = true;
+		returnCode = PPModalDialog::ReturnCodeNO;
+		return 0;
+	}
+};
+
+class PPScreen;
+class PPDialogBase;
+
+PPModalDialog::ReturnCodes AROS_runModalLoop(PPScreen* screen, PPDialogBase* dialog);
+
+#endif
diff -ruN MilkyTracker-1.05.01/src/tracker/aros/AudioDriver_AHI.cpp MilkyTracker-1.05.01.aros/src/tracker/aros/AudioDriver_AHI.cpp
--- MilkyTracker-1.05.01/src/tracker/aros/AudioDriver_AHI.cpp	1970-01-01 01:00:00.000000000 +0100
+++ MilkyTracker-1.05.01.aros/src/tracker/aros/AudioDriver_AHI.cpp	2026-04-26 10:16:31.665606833 +0200
@@ -0,0 +1,246 @@
+#include "AudioDriver_AHI.h"
+#include "MasterMixer.h"
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/ahi.h>
+#include <devices/ahi.h>
+#include <exec/tasks.h>
+#include <dos/dos.h>     /* SIGBREAKF_CTRL_C/D/E */
+#include <dos/dostags.h> /* NP_* */
+#include <dos/dosextens.h> /* struct Process */
+
+/* The audio worker runs as a Process (not a bare task): opening ahi.device
+ * loads driver modules via DOS LoadSeg, which needs a DOS process context.
+ * Single driver instance -> pass 'this' through a file-static. */
+static AudioDriver_AHI *s_instance = NULL;
+
+/* Control signals to the audio task (predefined per-task break signals). */
+#define AUDIOSIG_DIE   SIGBREAKF_CTRL_C
+#define AUDIOSIG_START SIGBREAKF_CTRL_D
+#define AUDIOSIG_STOP  SIGBREAKF_CTRL_E
+
+AudioDriver_AHI::AudioDriver_AHI() :
+	AudioDriver_COMPENSATE(),
+	ahiPort(NULL), ahiDevice(-1), bufferSizeBytes(0),
+	currentBuffer(0), deviceOpen(false),
+	audioTask(NULL), creatorTask(NULL), audioInitOK(false), audioPlaying(false)
+{
+	ahiReq[0] = ahiReq[1] = NULL;
+	sampleBuffer[0] = sampleBuffer[1] = NULL;
+}
+
+AudioDriver_AHI::~AudioDriver_AHI() { closeDevice(); }
+
+/* --- Resources are owned by the audio task (so the AHI reply port's signal
+ *     belongs to the task that waits on it). --- */
+
+bool AudioDriver_AHI::setupAHI()
+{
+	ahiPort = CreateMsgPort();
+	if (!ahiPort) return false;
+
+	ahiReq[0] = (struct AHIRequest *)CreateIORequest(ahiPort, sizeof(struct AHIRequest));
+	if (!ahiReq[0]) return false;
+	ahiReq[0]->ahir_Version = 4;
+	ahiDevice = OpenDevice(AHINAME, AHI_DEFAULT_ID, (struct IORequest *)ahiReq[0], 0);
+	if (ahiDevice != 0) return false;
+
+	ahiReq[1] = (struct AHIRequest *)CreateIORequest(ahiPort, sizeof(struct AHIRequest));
+	if (!ahiReq[1]) return false;
+	CopyMem(ahiReq[0], ahiReq[1], sizeof(struct AHIRequest));
+
+	sampleBuffer[0] = (WORD *)AllocVec(bufferSizeBytes, MEMF_PUBLIC | MEMF_CLEAR);
+	sampleBuffer[1] = (WORD *)AllocVec(bufferSizeBytes, MEMF_PUBLIC | MEMF_CLEAR);
+	if (!sampleBuffer[0] || !sampleBuffer[1]) return false;
+
+	return true;
+}
+
+void AudioDriver_AHI::teardownAHI()
+{
+	if (sampleBuffer[0]) { FreeVec(sampleBuffer[0]); sampleBuffer[0] = NULL; }
+	if (sampleBuffer[1]) { FreeVec(sampleBuffer[1]); sampleBuffer[1] = NULL; }
+	if (ahiDevice == 0)  { CloseDevice((struct IORequest *)ahiReq[0]); ahiDevice = -1; }
+	if (ahiReq[1]) { DeleteIORequest((struct IORequest *)ahiReq[1]); ahiReq[1] = NULL; }
+	if (ahiReq[0]) { DeleteIORequest((struct IORequest *)ahiReq[0]); ahiReq[0] = NULL; }
+	if (ahiPort)   { DeleteMsgPort(ahiPort); ahiPort = NULL; }
+}
+
+void AudioDriver_AHI::primeBuffers()
+{
+	currentBuffer = 0;
+
+	fillAudioWithCompensation((char *)sampleBuffer[0], bufferSizeBytes);
+	ahiReq[0]->ahir_Std.io_Command = CMD_WRITE;
+	ahiReq[0]->ahir_Std.io_Data = sampleBuffer[0];
+	ahiReq[0]->ahir_Std.io_Length = bufferSizeBytes;
+	ahiReq[0]->ahir_Std.io_Offset = 0;
+	ahiReq[0]->ahir_Type = AHIST_S16S;
+	ahiReq[0]->ahir_Frequency = mixFrequency;
+	ahiReq[0]->ahir_Volume = 0x10000;
+	ahiReq[0]->ahir_Position = 0x8000;
+	ahiReq[0]->ahir_Link = NULL;
+	SendIO((struct IORequest *)ahiReq[0]);
+
+	fillAudioWithCompensation((char *)sampleBuffer[1], bufferSizeBytes);
+	ahiReq[1]->ahir_Std.io_Command = CMD_WRITE;
+	ahiReq[1]->ahir_Std.io_Data = sampleBuffer[1];
+	ahiReq[1]->ahir_Std.io_Length = bufferSizeBytes;
+	ahiReq[1]->ahir_Std.io_Offset = 0;
+	ahiReq[1]->ahir_Type = AHIST_S16S;
+	ahiReq[1]->ahir_Frequency = mixFrequency;
+	ahiReq[1]->ahir_Volume = 0x10000;
+	ahiReq[1]->ahir_Position = 0x8000;
+	ahiReq[1]->ahir_Link = ahiReq[0];
+	SendIO((struct IORequest *)ahiReq[1]);
+}
+
+void AudioDriver_AHI::refillCompleted()
+{
+	while (GetMsg(ahiPort))
+	{
+		int buf = currentBuffer;
+		currentBuffer ^= 1;
+
+		fillAudioWithCompensation((char *)sampleBuffer[buf], bufferSizeBytes);
+		ahiReq[buf]->ahir_Std.io_Command = CMD_WRITE;
+		ahiReq[buf]->ahir_Std.io_Data = sampleBuffer[buf];
+		ahiReq[buf]->ahir_Std.io_Length = bufferSizeBytes;
+		ahiReq[buf]->ahir_Std.io_Offset = 0;
+		ahiReq[buf]->ahir_Type = AHIST_S16S;
+		ahiReq[buf]->ahir_Frequency = mixFrequency;
+		ahiReq[buf]->ahir_Volume = 0x10000;
+		ahiReq[buf]->ahir_Position = 0x8000;
+		ahiReq[buf]->ahir_Link = ahiReq[currentBuffer];
+		SendIO((struct IORequest *)ahiReq[buf]);
+	}
+}
+
+void AudioDriver_AHI::abortBuffers()
+{
+	AbortIO((struct IORequest *)ahiReq[0]); WaitIO((struct IORequest *)ahiReq[0]);
+	AbortIO((struct IORequest *)ahiReq[1]); WaitIO((struct IORequest *)ahiReq[1]);
+	while (GetMsg(ahiPort)) { }
+}
+
+void AudioDriver_AHI::audioTaskLoop()
+{
+	bool ok = setupAHI();
+	audioInitOK = ok;
+	__asm__ __volatile__("" ::: "memory");
+	Signal(creatorTask, SIGF_SINGLE);   /* unblock initDevice */
+
+	if (!ok)
+	{
+		teardownAHI();
+		return;   /* initDevice sees audioInitOK == false */
+	}
+
+	ULONG portSig = 1L << ahiPort->mp_SigBit;
+	bool localPlaying = false;
+
+	for (;;)
+	{
+		ULONG sigs = Wait(portSig | AUDIOSIG_DIE | AUDIOSIG_START | AUDIOSIG_STOP);
+
+		if (sigs & AUDIOSIG_DIE)
+		{
+			if (localPlaying) { abortBuffers(); localPlaying = false; }
+			break;
+		}
+		if (sigs & AUDIOSIG_STOP)
+		{
+			if (localPlaying) { abortBuffers(); localPlaying = false; }
+		}
+		if (sigs & AUDIOSIG_START)
+		{
+			if (!localPlaying) { primeBuffers(); localPlaying = true; }
+		}
+		if ((sigs & portSig) && localPlaying)
+		{
+			refillCompleted();
+		}
+	}
+
+	teardownAHI();
+	Signal(creatorTask, SIGF_SINGLE);   /* unblock closeDevice */
+}
+
+void AudioDriver_AHI::audioProcEntry()
+{
+	AudioDriver_AHI *self = s_instance;
+	if (self) self->audioTaskLoop();
+}
+
+mp_sint32 AudioDriver_AHI::initDevice(mp_sint32 bufferSizeInWords, mp_uint32 mixFreq, MasterMixer* theMixer)
+{
+	mp_sint32 res = AudioDriverBase::initDevice(bufferSizeInWords, mixFreq, theMixer);
+	if (res < 0) return res;
+
+	bufferSizeBytes = bufferSizeInWords * sizeof(WORD);
+
+	creatorTask = FindTask(NULL);
+	audioInitOK = false;
+	s_instance = this;
+
+	/* A Process (not a bare task): ahi.device open loads driver modules via
+	 * DOS, which needs a process context. The cast is safe - pr_Task is the
+	 * first member of struct Process. */
+	audioTask = (struct Task *)CreateNewProcTags(
+		NP_Entry,     (IPTR)audioProcEntry,
+		NP_Name,      (IPTR)"MilkyTracker Audio",
+		NP_StackSize, 65536,
+		NP_Priority,  20,
+		TAG_DONE);
+	if (!audioTask)
+		return MP_DEVICE_ERROR;
+
+	/* The task opens AHI and reports the result; wait for it. */
+	Wait(SIGF_SINGLE);
+	if (!audioInitOK)
+	{
+		audioTask = NULL;   /* task has already exited on failure */
+		return MP_DEVICE_ERROR;
+	}
+
+	deviceOpen = true;
+	return MP_OK;
+}
+
+mp_sint32 AudioDriver_AHI::closeDevice()
+{
+	if (audioTask)
+	{
+		Signal(audioTask, AUDIOSIG_DIE);
+		Wait(SIGF_SINGLE);   /* task tears down AHI then signals back */
+		audioTask = NULL;
+	}
+	audioPlaying = false;
+	deviceOpen = false;
+	return MP_OK;
+}
+
+mp_sint32 AudioDriver_AHI::start()
+{
+	if (audioTask && !audioPlaying)
+	{
+		audioPlaying = true;
+		deviceHasStarted = true;
+		Signal(audioTask, AUDIOSIG_START);
+	}
+	return MP_OK;
+}
+
+mp_sint32 AudioDriver_AHI::stop()
+{
+	if (audioTask && audioPlaying)
+	{
+		audioPlaying = false;
+		deviceHasStarted = false;
+		Signal(audioTask, AUDIOSIG_STOP);
+	}
+	return MP_OK;
+}
+
+mp_sint32 AudioDriver_AHI::pause() { return stop(); }
+mp_sint32 AudioDriver_AHI::resume() { return start(); }
diff -ruN MilkyTracker-1.05.01/src/tracker/aros/AudioDriver_AHI.h MilkyTracker-1.05.01.aros/src/tracker/aros/AudioDriver_AHI.h
--- MilkyTracker-1.05.01/src/tracker/aros/AudioDriver_AHI.h	1970-01-01 01:00:00.000000000 +0100
+++ MilkyTracker-1.05.01.aros/src/tracker/aros/AudioDriver_AHI.h	2026-04-26 10:15:30.164678624 +0200
@@ -0,0 +1,57 @@
+#ifndef __AUDIODRIVER_AHI_H__
+#define __AUDIODRIVER_AHI_H__
+
+#include "AudioDriver_COMPENSATE.h"
+#include <exec/types.h>
+#include <devices/ahi.h>
+
+struct Task;
+
+class AudioDriver_AHI : public AudioDriver_COMPENSATE
+{
+private:
+	struct MsgPort *ahiPort;
+	struct AHIRequest *ahiReq[2];
+	BYTE ahiDevice;
+	WORD *sampleBuffer[2];
+	mp_uint32 bufferSizeBytes;
+	int currentBuffer;
+	bool deviceOpen;
+
+	/* Dedicated audio task. The buffer refill (mixing) used to run in the
+	 * GUI main loop via pump(); that stalled whenever the loop blocked on
+	 * LockLayers during a window drag/resize, underrunning AHI. The task
+	 * owns the AHI port + double buffer and refills independently of the
+	 * GUI - the same threaded-callback model SDL/RtAudio already use. */
+	struct Task    *audioTask;
+	struct Task    *creatorTask;
+	volatile bool   audioInitOK;
+	bool            audioPlaying;
+
+	bool setupAHI();
+	void teardownAHI();
+	void primeBuffers();
+	void refillCompleted();
+	void abortBuffers();
+	void audioTaskLoop();
+	static void audioProcEntry();   /* CreateNewProc body; reads s_instance */
+
+public:
+	AudioDriver_AHI();
+	virtual ~AudioDriver_AHI();
+
+	virtual mp_sint32 initDevice(mp_sint32 bufferSizeInWords, mp_uint32 mixFrequency, MasterMixer* mixer);
+	virtual mp_sint32 closeDevice();
+	virtual mp_sint32 start();
+	virtual mp_sint32 stop();
+	virtual mp_sint32 pause();
+	virtual mp_sint32 resume();
+	virtual const char* getDriverID() { return "AHI Audio"; }
+	virtual mp_sint32 getPreferredBufferSize() const { return 2048; }
+
+	/* Audio is self-driven by audioTask now; the GUI loop no longer pumps. */
+	ULONG getSignalMask() const { return 0; }
+	void pump() {}
+};
+
+#endif
diff -ruN MilkyTracker-1.05.01/src/tracker/aros/DisplayDevice_AROS.cpp MilkyTracker-1.05.01.aros/src/tracker/aros/DisplayDevice_AROS.cpp
--- MilkyTracker-1.05.01/src/tracker/aros/DisplayDevice_AROS.cpp	1970-01-01 01:00:00.000000000 +0100
+++ MilkyTracker-1.05.01.aros/src/tracker/aros/DisplayDevice_AROS.cpp	2026-04-26 10:15:30.164706406 +0200
@@ -0,0 +1,131 @@
+#include "DisplayDevice_AROS.h"
+#include "Graphics.h"
+#include <stdio.h>
+#include <string.h>
+#include <aros/debug.h>
+#include <proto/intuition.h>
+#include <proto/graphics.h>
+#include <proto/exec.h>
+#include <proto/cybergraphics.h>
+#include <cybergraphx/cybergraphics.h>
+
+extern void exitEventLoop();
+
+PPDisplayDevice::PPDisplayDevice(pp_int32 width, pp_int32 height, pp_int32 scaleFactor, pp_int32 bpp) :
+	PPDisplayDeviceBase(width, height, scaleFactor),
+	window(NULL), screen(NULL),
+	pixelBuffer(NULL), pitch(0), bpp(bpp), titleBuf(NULL)
+{
+	D(bug("[DD] constructor start, %dx%d\n", width, height));
+
+	D(bug("[DD] LockPubScreen...\n"));
+	screen = LockPubScreen(NULL);
+	if (!screen) { D(bug("[DD] FAILED LockPubScreen\n")); return; }
+
+	if (width > screen->Width) size.width = screen->Width;
+	if (height > screen->Height) size.height = screen->Height;
+
+	WORD left = (screen->Width - size.width) / 2;
+	WORD top = (screen->Height - size.height) / 2;
+
+	D(bug("[DD] OpenWindowTags %dx%d at %d,%d...\n", size.width, size.height, left, top));
+	window = OpenWindowTags(NULL,
+		WA_InnerWidth, size.width, WA_InnerHeight, size.height,
+		WA_Left, left, WA_Top, top,
+		WA_Title, (IPTR)"MilkyTracker",
+		WA_DragBar, TRUE, WA_DepthGadget, TRUE, WA_CloseGadget, TRUE,
+		WA_SizeGadget, FALSE, WA_Activate, TRUE,
+		WA_GimmeZeroZero, TRUE, WA_ReportMouse, TRUE, WA_RMBTrap, TRUE,
+		WA_IDCMP, IDCMP_CLOSEWINDOW | IDCMP_MOUSEBUTTONS | IDCMP_MOUSEMOVE |
+		          IDCMP_RAWKEY | IDCMP_NEWSIZE | IDCMP_REFRESHWINDOW,
+		WA_CustomScreen, (IPTR)screen,
+		TAG_DONE);
+
+	UnlockPubScreen(NULL, screen);
+	if (!window) { D(bug("[DD] FAILED OpenWindowTags\n")); return; }
+	D(bug("[DD] window opened: %p\n", (void*)window));
+
+	pitch = size.width * 4;
+	pixelBuffer = (pp_uint8 *)AllocVec(pitch * size.height, MEMF_ANY | MEMF_CLEAR);
+	if (!pixelBuffer) { D(bug("[DD] FAILED AllocVec framebuffer\n")); return; }
+
+	D(bug("[DD] constructor done\n"));
+}
+
+PPDisplayDevice::~PPDisplayDevice()
+{
+	if (window) { SetWindowTitles(window, (CONST_STRPTR)-1, (CONST_STRPTR)-1); CloseWindow(window); }
+	if (pixelBuffer) FreeVec(pixelBuffer);
+	if (titleBuf) free(titleBuf);
+}
+
+PPGraphicsAbstract* PPDisplayDevice::open()
+{
+	if (!pixelBuffer) return NULL;
+	currentGraphics = new PPGraphics_ARGB32(size.width, size.height, pitch, pixelBuffer);
+	return currentGraphics;
+}
+
+void PPDisplayDevice::close()
+{
+	delete currentGraphics;
+	currentGraphics = NULL;
+}
+
+void PPDisplayDevice::update()
+{
+	if (!pixelBuffer || !window) return;
+	WritePixelArray(pixelBuffer, 0, 0, pitch, window->RPort,
+		0, 0, size.width, size.height, RECTFMT_ARGB);
+}
+
+void PPDisplayDevice::update(const PPRect& r)
+{
+	pp_int32 x = r.x1, y = r.y1, w = r.width(), h = r.height();
+	if (x < 0) { w += x; x = 0; }
+	if (y < 0) { h += y; y = 0; }
+	if (x + w > size.width) w = size.width - x;
+	if (y + h > size.height) h = size.height - y;
+	if (w <= 0 || h <= 0) return;
+
+	if (!pixelBuffer || !window) return;
+	WritePixelArray(pixelBuffer, x, y, pitch, window->RPort,
+		x, y, w, h, RECTFMT_ARGB);
+}
+
+void PPDisplayDevice::setTitle(const PPSystemString& title)
+{
+	if (!window) return;
+	if (titleBuf) free(titleBuf);
+	const char *src = (const char*)title;
+	titleBuf = (char *)malloc(strlen(src) + 1);
+	if (titleBuf) strcpy(titleBuf, src);
+	SetWindowTitles(window, titleBuf ? (CONST_STRPTR)titleBuf : (CONST_STRPTR)"MilkyTracker", (CONST_STRPTR)-1);
+}
+
+bool PPDisplayDevice::goFullScreen(bool b) { return false; }
+
+PPSize PPDisplayDevice::getDisplayResolution() const
+{
+	struct Screen *s = LockPubScreen(NULL);
+	if (s) { PPSize res(s->Width, s->Height); UnlockPubScreen(NULL, s); return res; }
+	return PPSize(640, 480);
+}
+
+void PPDisplayDevice::shutDown() { exitEventLoop(); }
+void PPDisplayDevice::setMouseCursor(MouseCursorTypes type) { PPDisplayDeviceBase::setMouseCursor(type); }
+
+void PPDisplayDevice::signalWaitState(bool b, const PPColor& color)
+{
+	if (b) { waitBarColor = color; setMouseCursor(MouseCursorTypeWait); }
+	else setMouseCursor(MouseCursorTypeStandard);
+}
+
+void PPDisplayDevice::setSize(const PPSize& newSize)
+{
+	PPDisplayDeviceBase::setSize(newSize);
+
+	if (pixelBuffer) FreeVec(pixelBuffer);
+	pitch = newSize.width * 4;
+	pixelBuffer = (pp_uint8 *)AllocVec(pitch * newSize.height, MEMF_ANY | MEMF_CLEAR);
+}
