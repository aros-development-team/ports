-	snprintf(path, pathSize, "%s/%s", userDirPath, filename);
+	/* An AmigaDOS volume or assign name already ends in ':', which must not be
+	 * followed by a separator - a leading '/' there means the parent instead. */
+	const char *separator = userDirPath[userDirPathLen - 1] == ':' ? "" : "/";
