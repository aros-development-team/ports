+#ifdef __AROS__
+	/* AROS sets neither XDG_CONFIG_HOME nor HOME, so the generic code below
+	 * would fall through to a relative path, i.e. the current directory. That
+	 * is the program's own drawer when launched from Workbench, but an
+	 * arbitrary one when launched from a shell - which would scatter the
+	 * configuration and high scores. Anchor them to the program instead. */
+	userDirPath = "PROGDIR:";
+	userDirPathLen = strlen(userDirPath);
+	return;
+#endif
