+#ifndef FILTER_H
+#define FILTER_H
+
+#define PRGB2SHORT(r,g,b) ((((r))<<11)+(((g))<<5)+((b))) 
+#define RGB2SHORT(r,g,b) ((((r>>3))<<11)+(((g>>2))<<5)+((b>>3))) 
