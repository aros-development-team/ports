diff --git a/source/pdf/aros-timegm.h b/source/pdf/aros-timegm.h
new file mode 100644
index 0000000..3e9f8c6
--- /dev/null
+++ b/source/pdf/aros-timegm.h
@@ -0,0 +1,20 @@
+/* UTC civil-date conversion for AROS, independent of the process timezone. */
+#ifndef MUPDF_AROS_TIMEGM_H
+#define MUPDF_AROS_TIMEGM_H
+#include <stdint.h>
+#include <time.h>
+static time_t aros_timegm(const struct tm *tm)
+{
+	int64_t year=(int64_t)tm->tm_year+1900;
+	int64_t month=(int64_t)tm->tm_mon+1;
+	year-=month<=2;
+	int64_t era=(year>=0 ? year : year-399)/400;
+	int64_t yoe=year-era*400;
+	int64_t doy=(153*(month+(month>2 ? -3 : 9))+2)/5+tm->tm_mday-1;
+	int64_t doe=yoe*365+yoe/4-yoe/100+doy;
+	int64_t seconds=(era*146097+doe-719468)*86400+
+		(int64_t)tm->tm_hour*3600+(int64_t)tm->tm_min*60+tm->tm_sec;
+	time_t result=(time_t)seconds;
+	return (int64_t)result==seconds ? result : (time_t)-1;
+}
+#endif
