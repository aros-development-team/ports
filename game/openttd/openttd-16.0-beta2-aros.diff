+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file sdlmixer_s.cpp Playing sound via SDL2_mixer.
+ *
+ * AROS' SDL2 audio backend sets OnlyHasDefaultOutputDevice, and SDL2 refuses
+ * a second output device outright when that is set ("Audio device already
+ * open"). The music driver needs SDL2_mixer, which opens a device of its own,
+ * so the two cannot each hold one. Instead SDL2_mixer owns the single device
+ * and this driver adds OpenTTD's effects to the finished mix from a post-mix
+ * hook. Mix_OpenAudio() refcounts, so whichever driver starts first opens the
+ * device and the other just joins it.
+ */
+
+#include "../stdafx.h"
+
+#include "sdlmixer_s.h"
+
+#include <SDL.h>
+#include <SDL_mixer.h>
+
+#include "../mixer.h"
+
+#include "../safeguards.h"
+
+/** Factory for the SDL2_mixer sound driver. */
+static FSoundDriver_SdlMixer iFSoundDriver_SdlMixer;
+
+/** Scratch buffer for OpenTTD's own mix, sized in Start(). */
+static std::vector<uint8_t> _mix_buffer;
+
+/**
+ * Add OpenTTD's effects to what SDL2_mixer has already mixed.
+ * @param stream The finished mix, to be modified in place.
+ * @param len    Length of \a stream in bytes.
+ */
+static void CDECL AddSoundToMix(void *, Uint8 *stream, int len)
+{
+	/* MxMixSamples() clears its buffer before filling it, so it cannot write
+	 * straight into the stream without dropping the music that is already
+	 * there. Mix into scratch, then add. */
+	if (_mix_buffer.size() < (size_t)len) _mix_buffer.resize(len);
+
+	MxMixSamples(_mix_buffer.data(), len / 4);
+	SDL_MixAudioFormat(stream, _mix_buffer.data(), AUDIO_S16SYS, len, SDL_MIX_MAXVOLUME);
+}
+
+std::optional<std::string_view> SoundDriver_SdlMixer::Start(const StringList &parm)
+{
+	/* Only quit in Stop() what was started here; the music driver may already
+	 * hold the audio subsystem. */
+	if (SDL_WasInit(SDL_INIT_AUDIO) == 0) {
+		int ret_code = (SDL_WasInit(SDL_INIT_EVERYTHING) == 0) ? SDL_Init(SDL_INIT_AUDIO) : SDL_InitSubSystem(SDL_INIT_AUDIO);
+		if (ret_code == -1) return SDL_GetError();
+		this->inited_audio = true;
+	}
+
+	int hz = GetDriverParamInt(parm, "hz", 44100);
+	int samples = GetDriverParamInt(parm, "samples", 1024);
+	if (Mix_OpenAudio(hz, MIX_DEFAULT_FORMAT, 2, samples) == -1) return Mix_GetError();
+
+	int got_hz = 0, got_ch = 0;
+	Uint16 got_fmt = 0;
+	if (Mix_QuerySpec(&got_hz, &got_fmt, &got_ch) == 0) return Mix_GetError();
+
+	_mix_buffer.resize(samples * 4);
+	MxInitialize(got_hz);
+	Mix_SetPostMix(AddSoundToMix, nullptr);
+
+	return std::nullopt;
+}
+
+void SoundDriver_SdlMixer::Stop()
+{
+	Mix_SetPostMix(nullptr, nullptr);
+	Mix_CloseAudio();
+	if (this->inited_audio) SDL_QuitSubSystem(SDL_INIT_AUDIO);
+}
