+/* Called before a connection is established.
+ * Set all configuration options to support and load channels here. */
+static int native_reject_unpinned_certificate(freerdp* instance, const BYTE* pem,
+    size_t length, const char* hostname, UINT16 port, DWORD flags)
+{
+    WINPR_UNUSED(instance); WINPR_UNUSED(pem); WINPR_UNUSED(length);
+    WINPR_UNUSED(hostname); WINPR_UNUSED(port); WINPR_UNUSED(flags);
+    WLog_ERR(TAG, "Certificate does not match the explicit fingerprint; connection rejected");
+    return 0;
+}
+
+static BOOL tf_pre_connect(freerdp* instance)
+{
+	rdpSettings* settings = nullptr;
+
+	WINPR_ASSERT(instance);
+	WINPR_ASSERT(instance->context);
+
+	settings = instance->context->settings;
+	WINPR_ASSERT(settings);
+
+    if (freerdp_settings_get_bool(settings, FreeRDP_Fullscreen)) {
+        uint32_t width=0,height=0;
+        if (!native_screen_size(&width,&height) ||
+            !freerdp_settings_set_uint32(settings,FreeRDP_DesktopWidth,width) ||
+            !freerdp_settings_set_uint32(settings,FreeRDP_DesktopHeight,height)) return FALSE;
+    }
+
+    /* This SDK's OpenSSL is built without thread support. Printer cache hashing
+     * and TLS must stay on the session task; native DOS handles are task-owned
+     * too. Use the upstream synchronous static-channel path on AROS. */
+    if (!freerdp_settings_set_bool(settings, FreeRDP_SynchronousStaticChannels, TRUE))
+        return FALSE;
+
+    /* FreeRDP checks accepted fingerprints before external certificate management.
+     * Make an explicit pin exclusive: neither CA trust nor a prompt may override
+     * a mismatch. Without a pin, retain normal validation and accept-once UI. */
+    const char* pins = freerdp_settings_get_string(settings, FreeRDP_CertificateAcceptedFingerprints);
+    if (pins && *pins) {
+        if (!freerdp_settings_set_bool(settings, FreeRDP_ExternalCertificateManagement, TRUE))
+            return FALSE;
+        instance->VerifyX509Certificate = native_reject_unpinned_certificate;
+    }
+
+	/* If the callbacks provide the PEM all certificate options can be extracted, otherwise
+	 * only the certificate fingerprint is available. */
+	if (!freerdp_settings_set_bool(settings, FreeRDP_CertificateCallbackPreferPEM, FALSE))
+		return FALSE;
+
+	/* Optional OS identifier sent to server */
+	if (!freerdp_settings_set_uint32(settings, FreeRDP_OsMajorType, OSMAJORTYPE_UNIX))
+		return FALSE;
+	if (!freerdp_settings_set_uint32(settings, FreeRDP_OsMinorType, OSMINORTYPE_NATIVE_XSERVER))
+		return FALSE;
+	/* OrderSupport is initialized at this point.
+	 * Only override it if you plan to implement custom order
+	 * callbacks or deactivate certain features. */
+	/* Register the channel listeners.
+	 * They are required to set up / tear down channels if they are loaded. */
+	if (PubSub_SubscribeChannelConnected(instance->context->pubSub,
+	                                     tf_OnChannelConnectedEventHandler) < 0)
+		return FALSE;
+	if (PubSub_SubscribeChannelDisconnected(instance->context->pubSub,
+	                                        tf_OnChannelDisconnectedEventHandler) < 0)
+		return FALSE;
+
+	/* TODO: Any code your client requires */
+	return TRUE;
+}
+
+/* Called after a RDP connection was successfully established.
+ * Settings might have changed during negotiation of client / server feature
+ * support.
+ *
+ * Set up local framebuffers and paing callbacks.
+ * If required, register pointer callbacks to change the local mouse cursor
+ * when hovering over the RDP window
+ */
+static BOOL tf_post_connect(freerdp* instance)
+{
+	rdpContext* context = nullptr;
+
+	if (!gdi_init(instance, PIXEL_FORMAT_BGRA32))
+		return FALSE;
+
+	context = instance->context;
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(context->update);
+
+	/* Decode into the software framebuffer for CyberGraphX presentation. */
+	if (!freerdp_settings_set_bool(context->settings, FreeRDP_DeactivateClientDecoding, FALSE))
+		return FALSE;
+
+	((tfContext*)context)->window = native_open(context->gdi->width, context->gdi->height,
+        freerdp_settings_get_bool(context->settings, FreeRDP_Fullscreen),
+        freerdp_settings_get_bool(context->settings, FreeRDP_DynamicResolutionUpdate));
+	if (!((tfContext*)context)->window)
+		return FALSE;
+
+	context->update->BeginPaint = tf_begin_paint;
+	context->update->EndPaint = tf_end_paint;
+	context->update->PlaySound = tf_play_sound;
+	context->update->DesktopResize = tf_desktop_resize;
+	context->update->SetKeyboardIndicators = tf_keyboard_set_indicators;
+	context->update->SetKeyboardImeStatus = tf_keyboard_set_ime_status;
+	return TRUE;
+}
+
+/* This function is called whether a session ends by failure or success.
+ * Clean up everything allocated by pre_connect and post_connect.
+ */
+static void tf_post_disconnect(freerdp* instance)
+{
+	tfContext* context = nullptr;
+
+	if (!instance)
+		return;
+
+	if (!instance->context)
+		return;
+
+	context = (tfContext*)instance->context;
+	PubSub_UnsubscribeChannelConnected(instance->context->pubSub,
+	                                   tf_OnChannelConnectedEventHandler);
+	PubSub_UnsubscribeChannelDisconnected(instance->context->pubSub,
+	                                      tf_OnChannelDisconnectedEventHandler);
+	WLog_DBG(TAG, "Closing native window");
+	native_close(context->window);
+	context->window = NULL;
+	WLog_DBG(TAG, "Freeing graphics context");
+	gdi_free(instance);
+	WLog_DBG(TAG, "Graphics context freed");
+	/* TODO : Clean up custom stuff */
+	WINPR_UNUSED(context);
+}
+
+/* RDP main loop.
+ * Connects RDP, loops while running and handles event and dispatch, cleans up
+ * after the connection ends. */
+static DWORD WINAPI tf_client_thread_proc(LPVOID arg)
+{
+	freerdp* instance = (freerdp*)arg;
+	DWORD nCount = 0;
+	DWORD status = 0;
+	DWORD result = 0;
+	HANDLE handles[MAXIMUM_WAIT_OBJECTS] = WINPR_C_ARRAY_INIT;
+	BOOL rc = freerdp_connect(instance);
+
+	WINPR_ASSERT(instance->context);
+	WINPR_ASSERT(instance->context->settings);
+	if (freerdp_settings_get_bool(instance->context->settings, FreeRDP_AuthenticationOnly))
+	{
+		result = freerdp_get_last_error(instance->context);
+		freerdp_abort_connect_context(instance->context);
+		WLog_ERR(TAG, "Authentication only, exit status 0x%08" PRIx32 "", result);
+		goto disconnect;
+	}
+
+	if (!rc)
+	{
+		result = freerdp_get_last_error(instance->context);
+		WLog_ERR(TAG, "connection failure 0x%08" PRIx32, result);
+		goto disconnect;
+	}
+
+	while (!freerdp_shall_disconnect_context(instance->context))
+	{
+		adt_clipboard_poll((tfContext*)instance->context);
+        adt_display_poll((tfContext*)instance->context);
+		struct native_event ev;
+		while (native_poll(((tfContext*)instance->context)->window, &ev))
+		{
+			if (ev.kind == 1)
+				goto disconnect;
+			if (ev.kind == 6) {
+				for (unsigned k = 0; k < 128; k++) {
+					if (((tfContext*)instance->context)->keys[k])
+						freerdp_input_send_keyboard_event_ex(instance->context->input,
+						    FALSE, FALSE, adt_raw_scancode(k));
+					((tfContext*)instance->context)->keys[k] = FALSE;
+				}
+				freerdp_input_send_mouse_event(instance->context->input, PTR_FLAGS_BUTTON1, 0, 0);
+				freerdp_input_send_mouse_event(instance->context->input, PTR_FLAGS_BUTTON2, 0, 0);
+				freerdp_input_send_mouse_event(instance->context->input, PTR_FLAGS_BUTTON3, 0, 0);
+			}
+			if (ev.kind == 7) {
+                adt_display_resize((tfContext*)instance->context, ev.x, ev.y);
+                ev.kind=5;
+            }
+            if (ev.kind == 2) {
+                tfContext *tf=(tfContext*)instance->context;
+                if (ev.code==0xc4 && tf->fullscreen_key) { tf->fullscreen_key=FALSE; continue; }
+                if (ev.code==0x44 && tf->keys[0x63] && (tf->keys[0x64] || tf->keys[0x65])) {
+                    for (unsigned k=0; k<128; k++) {
+                        if (tf->keys[k]) freerdp_input_send_keyboard_event_ex(instance->context->input,FALSE,FALSE,adt_raw_scancode(k));
+                        tf->keys[k]=FALSE;
+                    }
+                    freerdp_input_send_mouse_event(instance->context->input,PTR_FLAGS_BUTTON1,0,0);
+                    freerdp_input_send_mouse_event(instance->context->input,PTR_FLAGS_BUTTON2,0,0);
+                    freerdp_input_send_mouse_event(instance->context->input,PTR_FLAGS_BUTTON3,0,0);
+                    tf->fullscreen_key=TRUE;
+                    uint32_t width=0,height=0;
+                    if (native_toggle_fullscreen(tf->window,&width,&height)) {
+                        adt_display_resize(tf,width,height);
+                        rdpGdi *g=instance->context->gdi;
+                        native_paint(tf->window,g->primary_buffer,g->width,g->height,g->stride);
+                    }
+                    continue;
+                }
+				if (ev.code >= 0x7a && ev.code <= 0x7d) {
+					UINT16 flags = ev.code < 0x7c ? PTR_FLAGS_WHEEL : PTR_FLAGS_HWHEEL;
+					flags |= (ev.code == 0x7b || ev.code == 0x7c) ?
+					    PTR_FLAGS_WHEEL_NEGATIVE | 0x88 : 120;
+					freerdp_input_send_mouse_event(instance->context->input, flags, 0, 0);
+				}
+				UINT16 code = adt_raw_scancode(ev.code);
+				if (code) {
+					((tfContext*)instance->context)->keys[ev.code & 127] = !(ev.code & 128);
+					freerdp_input_send_keyboard_event_ex(instance->context->input,
+					    !(ev.code & 0x80), FALSE, code);
+				}
+			}
+			if (ev.kind == 3 || ev.kind == 4) {
+				if (ev.x < 0) ev.x = 0;
+				if (ev.y < 0) ev.y = 0;
+				if (ev.x >= instance->context->gdi->width) ev.x = instance->context->gdi->width - 1;
+				if (ev.y >= instance->context->gdi->height) ev.y = instance->context->gdi->height - 1;
+				UINT16 flags = PTR_FLAGS_MOVE;
+				if (ev.kind == 4) {
+					flags = 0;
+					switch (ev.code & 0x7f) {
+					case 0x68: flags = PTR_FLAGS_BUTTON1; break;
+					case 0x69: flags = PTR_FLAGS_BUTTON2; break;
+					case 0x6a: flags = PTR_FLAGS_BUTTON3; break;
+					}
+					if (flags && !(ev.code & 0x80)) flags |= PTR_FLAGS_DOWN;
+				}
+				if (flags) freerdp_input_send_mouse_event(instance->context->input,
+				    flags, (UINT16)ev.x, (UINT16)ev.y);
+			}
+			if (ev.kind == 5)
+			{
+				rdpGdi* g = instance->context->gdi;
+				native_paint(((tfContext*)instance->context)->window,
+				             g->primary_buffer, g->width, g->height, g->stride);
+			}
+		}
+		nCount = freerdp_get_event_handles(instance->context, handles, ARRAYSIZE(handles));
+
+		if (nCount == 0)
+		{
+			WLog_ERR(TAG, "freerdp_get_event_handles failed");
+            result=ERROR_INTERNAL_ERROR;
+			break;
+		}
+
+		status = WaitForMultipleObjects(nCount, handles, FALSE, 10);
+
+		if (status == WAIT_FAILED)
+		{
+			WLog_ERR(TAG, "WaitForMultipleObjects failed with %" PRIu32 "", status);
+            result=ERROR_INTERNAL_ERROR;
+			break;
+		}
+
+		if (!freerdp_check_event_handles(instance->context))
+		{
+			if (freerdp_get_last_error(instance->context) == FREERDP_ERROR_SUCCESS)
+				WLog_ERR(TAG, "Failed to check FreeRDP event handles");
+
+            result=freerdp_get_last_error(instance->context);
+            if (!result) result=ERROR_INTERNAL_ERROR;
+			break;
+		}
+	}
+    if (!result) result=freerdp_get_last_error(instance->context);
+
+disconnect:
+	WLog_INFO(TAG, "Disconnecting session");
+	freerdp_disconnect(instance);
+	WLog_INFO(TAG, "Session disconnected");
+	return result;
+}
+
+/* Optional global initializer.
+ * Here we just register a signal handler to print out stack traces
+ * if available. */
+static BOOL tf_client_global_init(void)
+{
+	return freerdp_handle_signals() == 0;
+}
