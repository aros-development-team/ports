diff --git a/channels/rdpsnd/client/ahi/ahi_output.c b/channels/rdpsnd/client/ahi/ahi_output.c
new file mode 100644
index 0000000..5f733b9
--- /dev/null
+++ b/channels/rdpsnd/client/ahi/ahi_output.c
@@ -0,0 +1,47 @@
+/* AHI playback bridge, compiled using only native AROS types. */
+#include "ahi_output.h"
+#include <devices/ahi.h>
+#include <proto/exec.h>
+#include <stdlib.h>
+#include <string.h>
+struct ahi_output { struct MsgPort *port; struct AHIRequest *io; uint16_t channels; int opened; };
+struct ahi_output *ahi_output_open(uint32_t rate, uint16_t channels)
+{
+    if (rate < 8000 || rate > 96000 || (channels != 1 && channels != 2)) return NULL;
+    struct ahi_output *a = calloc(1, sizeof(*a));
+    if (!a) return NULL;
+    a->port = CreateMsgPort();
+    if (a->port) a->io = (struct AHIRequest *)CreateIORequest(a->port, sizeof(*a->io));
+    if (!a->io) { ahi_output_close(a); return NULL; }
+    a->io->ahir_Version = 4;
+    if (OpenDevice(AHINAME, 0, (struct IORequest *)a->io, 0)) { ahi_output_close(a); return NULL; }
+    a->opened = 1; a->channels = channels;
+    a->io->ahir_Frequency = rate;
+    a->io->ahir_Type = channels == 1 ? AHIST_M16S : AHIST_S16S;
+    a->io->ahir_Volume = 0x10000; a->io->ahir_Position = 0x8000;
+    return a;
+}
+int ahi_output_play(struct ahi_output *a, const void *data, size_t size, uint32_t volume)
+{
+    if (!a || !data || !size || size > 1048576 || size % (a->channels * 2)) return 0;
+    int16_t *samples = malloc(size);
+    if (!samples) return 0;
+    memcpy(samples, data, size);
+    for (size_t i = 0; i < size / 2; i++) {
+        uint32_t level = a->channels == 2 && (i & 1) ? volume >> 16 : volume & 0xffff;
+        samples[i] = (int16_t)(((int32_t)samples[i] * (int32_t)level) / 65535);
+    }
+    a->io->ahir_Std.io_Command = CMD_WRITE;
+    a->io->ahir_Std.io_Data = samples; a->io->ahir_Std.io_Length = size;
+    a->io->ahir_Std.io_Offset = 0;
+    int error = DoIO((struct IORequest *)a->io);
+    free(samples); return error == 0;
+}
+void ahi_output_close(struct ahi_output *a)
+{
+    if (!a) return;
+    if (a->opened) CloseDevice((struct IORequest *)a->io);
+    if (a->io) DeleteIORequest((struct IORequest *)a->io);
+    if (a->port) DeleteMsgPort(a->port);
+    free(a);
+}
