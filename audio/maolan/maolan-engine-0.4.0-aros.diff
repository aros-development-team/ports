@@ -0,0 +1,419 @@
+//! AHI (ahi.device) backend for AROS: a duplex stereo stream in 32-bit samples, driven by the
+//! C side in `ahi_glue.c` (a ring of AHI sounds played back to back, a record hook feeding a
+//! capture ring). The engine's worker calls [`HwDriver::run_cycle_inner`] once per period:
+//! wait for a free slot, hand the captured period to the input ports, render the output ports
+//! into the slot.
+
+use super::common;
+use super::error_fmt;
+use super::latency;
+use super::ports;
+use crate::audio::io::AudioIO;
+use crate::message::HwMidiEvent;
+use std::sync::Arc;
+use std::time::Duration;
+
+pub use super::options::HwOptions;
+
+const MAX_FREQS: usize = 16;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct AhiModeInfo {
+    id: u32,
+    name: [u8; 64],
+    bits: i32,
+    max_channels: i32,
+    record: i32,
+    fullduplex: i32,
+    realtime: i32,
+    min_freq: i32,
+    max_freq: i32,
+    nfreq: i32,
+    freqs: [i32; MAX_FREQS],
+}
+
+#[repr(C)]
+struct AhiStream {
+    _private: [u8; 0],
+}
+
+unsafe extern "C" {
+    fn ahi_enumerate_modes(out: *mut AhiModeInfo, max: i32) -> i32;
+    fn ahi_best_mode() -> u32;
+    fn ahi_open(audio_id: u32, freq: i32, period: i32, nperiods: i32, record: i32, got_freq: *mut i32) -> *mut AhiStream;
+    fn ahi_close(s: *mut AhiStream);
+    fn ahi_mix_frequency(s: *mut AhiStream) -> i32;
+    fn ahi_wait_period(s: *mut AhiStream, timeout_ms: i32) -> i32;
+    fn ahi_write_period(s: *mut AhiStream, stereo: *const i32, frames: i32) -> i32;
+    fn ahi_read_period(s: *mut AhiStream, stereo: *mut i32, frames: i32) -> i32;
+    fn ahi_xruns(s: *mut AhiStream) -> u64;
+}
+
+const AHI_INVALID_ID: u32 = !0;
+
+/// An audio mode AHI offers, as the application lists devices.
+#[derive(Debug, Clone)]
+pub struct AudioDeviceDescriptor {
+    pub id: String,
+    pub label: String,
+    pub supported_bits: Vec<usize>,
+    pub supported_sample_rates: Vec<i32>,
+    pub max_channels: usize,
+    pub max_buffer_bytes: usize,
+    pub supports_input: bool,
+    pub supports_output: bool,
+}
+
+/// The device id used for an AHI mode: `AHI:0x<audio id>`.
+pub fn device_id_for(mode: u32) -> String {
+    format!("AHI:0x{mode:08X}")
+}
+
+fn parse_device_id(device: &str) -> Option<u32> {
+    let hex = device.strip_prefix("AHI:0x").or_else(|| device.strip_prefix("AHI:0X"))?;
+    u32::from_str_radix(hex, 16).ok()
+}
+
+/// Every mode AHI knows (`AHI_NextAudioID`), with its name, bits, frequencies and whether it
+/// records.
+pub fn discover_ahi_audio_devices() -> Vec<AudioDeviceDescriptor> {
+    let mut modes: Vec<AhiModeInfo> = vec![
+        AhiModeInfo {
+            id: 0,
+            name: [0; 64],
+            bits: 0,
+            max_channels: 0,
+            record: 0,
+            fullduplex: 0,
+            realtime: 0,
+            min_freq: 0,
+            max_freq: 0,
+            nfreq: 0,
+            freqs: [0; MAX_FREQS],
+        };
+        64
+    ];
+    // SAFETY: `modes` has room for the count passed.
+    let n = unsafe { ahi_enumerate_modes(modes.as_mut_ptr(), modes.len() as i32) };
+    let n = n.clamp(0, modes.len() as i32) as usize;
+    modes
+        .into_iter()
+        .take(n)
+        .map(|m| {
+            let name_len = m.name.iter().position(|&b| b == 0).unwrap_or(m.name.len());
+            let name = String::from_utf8_lossy(&m.name[..name_len]).into_owned();
+            let mut rates: Vec<i32> = m.freqs[..(m.nfreq.max(0) as usize).min(MAX_FREQS)].to_vec();
+            if rates.is_empty() && m.max_freq > 0 {
+                rates = [44_100, 48_000].into_iter().filter(|r| *r >= m.min_freq && *r <= m.max_freq).collect();
+            }
+            if rates.is_empty() {
+                rates = vec![44_100];
+            }
+            let bits = m.bits.max(8) as usize;
+            AudioDeviceDescriptor {
+                id: device_id_for(m.id),
+                label: format!("{name} (AHI)"),
+                supported_bits: if bits >= 24 { vec![32, 24, 16] } else { vec![bits] },
+                supported_sample_rates: rates,
+                max_channels: 2,
+                max_buffer_bytes: 0,
+                supports_input: m.record != 0,
+                supports_output: true,
+            }
+        })
+        .collect()
+}
+
+/// A MIDI hub with no devices: MIDI hardware is not reached through AHI.
+#[derive(Debug, Default)]
+pub struct MidiHub;
+
+impl MidiHub {
+    pub fn new() -> Self {
+        Self
+    }
+    pub fn open_input(&mut self, _device: &str) -> Result<(), String> {
+        Err("Hardware MIDI devices are not available through the AHI backend".to_string())
+    }
+    pub fn open_output(&mut self, _device: &str) -> Result<(), String> {
+        Err("Hardware MIDI devices are not available through the AHI backend".to_string())
+    }
+    pub fn close_all(&mut self) {}
+    pub fn read_events_into(&mut self, _out: &mut Vec<HwMidiEvent>) {}
+    pub fn read_events_blocking_into(&mut self, _out: &mut Vec<HwMidiEvent>) {}
+    pub fn wait_ready_blocking(&mut self) -> Option<Vec<i32>> {
+        None
+    }
+    pub fn read_events_for_fds(&mut self, _ready_fds: &[i32], _out: &mut Vec<HwMidiEvent>) {}
+    pub fn wake_input_waiter(&mut self) {}
+    pub fn close_input_waiter(&mut self) {}
+    pub fn write_events(&mut self, _events: &[HwMidiEvent]) {}
+    pub fn write_events_blocking(&mut self, _events: &[HwMidiEvent], _timeout: Duration) {}
+    pub fn read_events(&mut self) -> Vec<HwMidiEvent> {
+        Vec::new()
+    }
+    pub fn output_devices(&self) -> Vec<String> {
+        Vec::new()
+    }
+}
+
+crate::impl_hw_midi_hub_traits!(MidiHub);
+
+pub struct HwDriver {
+    stream: *mut AhiStream,
+    audio_ins: Vec<Arc<AudioIO>>,
+    audio_outs: Vec<Arc<AudioIO>>,
+    output_gain_linear: f32,
+    output_balance: f32,
+    sample_rate: i32,
+    period_frames: usize,
+    channels_in: usize,
+    channels_out: usize,
+    nperiods: usize,
+    sync_mode: bool,
+    input_latency_frames: usize,
+    output_latency_frames: usize,
+    capture_i32: Vec<i32>,
+    playback_i32: Vec<i32>,
+    capture_f32_buffer: Vec<f32>,
+    playback_f32_buffer: Vec<f32>,
+    playing: bool,
+    plan_slot: Option<Arc<crate::render_plan::PlanSlot>>,
+}
+
+// SAFETY: the stream is only ever used from the worker that owns the driver; the AHI hooks
+// touch it from AHI's own task, through the C side's own synchronisation.
+unsafe impl Send for HwDriver {}
+
+impl std::fmt::Debug for HwDriver {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("HwDriver")
+            .field("sample_rate", &self.sample_rate)
+            .field("period_frames", &self.period_frames)
+            .field("channels_in", &self.channels_in)
+            .field("channels_out", &self.channels_out)
+            .field("nperiods", &self.nperiods)
+            .finish()
+    }
+}
+
+impl Drop for HwDriver {
+    fn drop(&mut self) {
+        if !self.stream.is_null() {
+            // SAFETY: closed once; the pointer came from ahi_open.
+            unsafe { ahi_close(self.stream) };
+            self.stream = std::ptr::null_mut();
+        }
+    }
+}
+
+impl Default for HwOptions {
+    fn default() -> Self {
+        Self {
+            exclusive: false,
+            period_frames: 1024,
+            nperiods: 3,
+            input_channels: 0,
+            output_channels: 0,
+            ignore_hwbuf: false,
+            sync_mode: false,
+            input_latency_frames: 0,
+            output_latency_frames: 0,
+        }
+    }
+}
+
+impl HwDriver {
+    pub fn new_with_options(device: &str, rate: i32, _bits: i32, options: HwOptions) -> Result<Self, String> {
+        let mode = match parse_device_id(device.trim()) {
+            Some(id) => id,
+            // SAFETY: no arguments.
+            None => unsafe { ahi_best_mode() },
+        };
+        if mode == AHI_INVALID_ID {
+            return Err(error_fmt::backend_open_error("AHI", "duplex", device, "no usable audio mode"));
+        }
+        let period = options.period_frames.clamp(64, 65536) as i32;
+        let nperiods = options.nperiods.clamp(2, 16) as i32;
+        // Record through the same mode when it can; a mode without recording is still fine
+        // for playback (its input ports then carry silence).
+        let record = discover_ahi_audio_devices().into_iter().any(|d| d.id == device_id_for(mode) && d.supports_input);
+        let mut got_freq: i32 = 0;
+        // SAFETY: plain arguments; the returned stream is owned by this driver.
+        let stream = unsafe { ahi_open(mode, rate.max(8000), period, nperiods, record as i32, &mut got_freq) };
+        if stream.is_null() {
+            return Err(error_fmt::backend_open_error("AHI", "duplex", device, "AHI_AllocAudio failed"));
+        }
+        // SAFETY: valid stream.
+        let sample_rate = unsafe { ahi_mix_frequency(stream) }.max(1);
+        let period_frames = period as usize;
+        let channels_in = 2;
+        let channels_out = 2;
+        let audio_ins: Vec<Arc<AudioIO>> = (0..channels_in).map(|_| Arc::new(AudioIO::new(period_frames))).collect();
+        let audio_outs: Vec<Arc<AudioIO>> = (0..channels_out).map(|_| Arc::new(AudioIO::new(period_frames))).collect();
+        Ok(Self {
+            stream,
+            audio_ins,
+            audio_outs,
+            output_gain_linear: 1.0,
+            output_balance: 0.0,
+            sample_rate,
+            period_frames,
+            channels_in,
+            channels_out,
+            nperiods: nperiods as usize,
+            sync_mode: options.sync_mode,
+            input_latency_frames: options.input_latency_frames,
+            output_latency_frames: options.output_latency_frames,
+            capture_i32: vec![0; period_frames * channels_in],
+            playback_i32: vec![0; period_frames * channels_out],
+            capture_f32_buffer: vec![0.0; period_frames * channels_in],
+            playback_f32_buffer: vec![0.0; period_frames * channels_out],
+            playing: false,
+            plan_slot: None,
+        })
+    }
+
+    pub fn input_channels(&self) -> usize {
+        self.channels_in
+    }
+
+    pub fn output_channels(&self) -> usize {
+        self.channels_out
+    }
+
+    pub fn sample_rate(&self) -> i32 {
+        self.sample_rate
+    }
+
+    pub fn cycle_samples(&self) -> usize {
+        self.period_frames
+    }
+
+    pub fn sample_bits(&self) -> i32 {
+        32
+    }
+
+    pub fn frame_size_bytes(&self) -> usize {
+        self.channels_out * 4
+    }
+
+    pub fn close_fds(&mut self) {}
+
+    pub fn input_port(&self, idx: usize) -> Option<Arc<AudioIO>> {
+        self.audio_ins.get(idx).cloned()
+    }
+
+    pub fn output_port(&self, idx: usize) -> Option<Arc<AudioIO>> {
+        self.audio_outs.get(idx).cloned()
+    }
+
+    pub fn set_output_gain_balance(&mut self, gain: f32, balance: f32) {
+        self.output_gain_linear = gain.max(0.0);
+        self.output_balance = balance.clamp(-1.0, 1.0);
+    }
+
+    pub fn set_playing(&mut self, playing: bool) {
+        self.playing = playing;
+    }
+
+    pub fn set_plan_slot(&mut self, slot: Arc<crate::render_plan::PlanSlot>) {
+        self.plan_slot = Some(slot);
+    }
+
+    pub fn output_meter_linear(&self, gain: f32, balance: f32) -> Vec<f32> {
+        if let Some(slot) = &self.plan_slot {
+            let plan = slot.load();
+            common::output_meter_linear_from_plan(&plan, gain, balance)
+        } else {
+            common::output_meter_linear(self.audio_outs.len(), gain, balance)
+        }
+    }
+
+    pub fn latency_ranges(&self) -> ((usize, usize), (usize, usize)) {
+        latency::latency_ranges(
+            self.cycle_samples(),
+            self.nperiods,
+            self.sync_mode,
+            self.input_latency_frames,
+            self.output_latency_frames,
+        )
+    }
+
+    pub fn xrun_count(&self) -> u64 {
+        if self.stream.is_null() {
+            return 0;
+        }
+        // SAFETY: valid stream.
+        unsafe { ahi_xruns(self.stream) }
+    }
+
+    pub fn channel(&mut self) -> AhiChannel<'_> {
+        AhiChannel { driver: self }
+    }
+
+    fn run_cycle_inner(&mut self) -> Result<(), String> {
+        if self.stream.is_null() {
+            return Err(error_fmt::backend_io_error("AHI", "duplex", "stream closed"));
+        }
+        let frames = self.period_frames;
+        let channels_in = self.channels_in;
+        let channels_out = self.channels_out;
+        let total_in = frames * channels_in;
+        let total_out = frames * channels_out;
+
+        // SAFETY: valid stream; the wait returns once a slot is free.
+        unsafe { ahi_wait_period(self.stream, -1) };
+
+        // Capture: the last period recorded, as floats, into the input ports.
+        // SAFETY: the buffer holds `frames` stereo frames.
+        unsafe { ahi_read_period(self.stream, self.capture_i32.as_mut_ptr(), frames as i32) };
+        crate::simd::convert_i32_to_f32(&self.capture_i32[..total_in], &mut self.capture_f32_buffer[..total_in], 1.0 / 2147483648.0);
+        if let Some(slot) = &self.plan_slot {
+            let plan = slot.load();
+            ports::fill_arena_from_interleaved(&plan, frames, &self.capture_f32_buffer[..total_in], channels_in);
+        } else {
+            ports::fill_ports_from_interleaved_buffer(&self.audio_ins, frames, false, &self.capture_f32_buffer[..total_in], channels_in);
+        }
+
+        // Playback: the output ports, interleaved, into the next slot.
+        self.playback_f32_buffer[..total_out].fill(0.0);
+        let mut write_sample = |ch: usize, frame: usize, sample: f32| {
+            let idx = frame * channels_out + ch;
+            if let Some(dst) = self.playback_f32_buffer.get_mut(idx) {
+                *dst = sample;
+            }
+        };
+        if let Some(slot) = &self.plan_slot {
+            let plan = slot.load();
+            ports::write_interleaved_from_arena(&plan, frames, self.output_gain_linear, self.output_balance, &mut write_sample);
+        } else {
+            ports::write_interleaved_from_ports(&self.audio_outs, frames, self.output_gain_linear, self.output_balance, false, write_sample);
+        }
+        crate::simd::convert_f32_to_i32(&self.playback_f32_buffer[..total_out], &mut self.playback_i32[..total_out], 2147483647.0);
+        // SAFETY: the buffer holds `frames` stereo frames.
+        let wrote = unsafe { ahi_write_period(self.stream, self.playback_i32.as_ptr(), frames as i32) };
+        if wrote <= 0 {
+            return Err(error_fmt::backend_io_error("AHI", "playback", "no free period"));
+        }
+        Ok(())
+    }
+}
+
+pub struct AhiChannel<'a> {
+    driver: &'a mut HwDriver,
+}
+
+impl<'a> AhiChannel<'a> {
+    pub fn run_cycle(&mut self) -> Result<(), String> {
+        self.driver.run_cycle_inner()
+    }
+
+    pub fn run_assist_step(&mut self) -> Result<bool, String> {
+        Ok(false)
+    }
+}
