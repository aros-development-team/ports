 /*
@@ -640,12 +713,40 @@ Sys_Mkdir
 */
 qboolean Sys_Mkdir( const char *path )
 {
+#ifdef __AROS__
+	/* Do not go through mkdir()/errno here.
+	 *
+	 * FS_CreatePath() walks a path and calls this for every component, so it
+	 * runs into directories that already exist constantly - and it treats
+	 * anything but EEXIST as fatal. Whether an existing directory surfaces as
+	 * EEXIST depends on which DOS error the filesystem handler picks and on
+	 * __stdc_ioerr2errno()'s mapping of it; a handler that reports, say, a
+	 * write-protected volume before it even checks for existence gets the
+	 * engine killed with "FS_CreatePath: failed to create path" on a directory
+	 * that is plainly there. That is what "AROS:Extras/Games" did.
+	 *
+	 * Ask the filesystem instead of the errno translation: if it can be
+	 * locked, it exists, and that is all the caller wants to know. */
+	BPTR lock = Lock( (CONST_STRPTR)path, SHARED_LOCK );
+
+	if( !lock )
+		lock = CreateDir( (CONST_STRPTR)path );
+
+	if( lock )
+	{
+		UnLock( lock );
+		return qtrue;
+	}
+
+	return qfalse;
+#else
 	int result = mkdir( path, 0750 );
 
 	if( result != 0 )
 		return errno == EEXIST;
 
 	return qtrue;
+#endif
 }
 
