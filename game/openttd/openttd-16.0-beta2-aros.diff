diff --git a/src/music/sdlmixer_m.cpp b/src/music/sdlmixer_m.cpp
new file mode 100644
index 0000000000..c20ea9a46e
--- /dev/null
+++ b/src/music/sdlmixer_m.cpp
@@ -0,0 +1,98 @@
+/*
+ * This file is part of OpenTTD.
+ * OpenTTD is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 2.
+ * OpenTTD is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ * See the GNU General Public License for more details. You should have received a copy of the GNU General Public License along with OpenTTD. If not, see <https://www.gnu.org/licenses/old-licenses/gpl-2.0>.
+ */
+
+/** @file sdlmixer_m.cpp Playing music via SDL2_mixer.
+ *
+ * On AROS neither of the usual MIDI backends is available: there is no
+ * fork() for extmidi and no fluidsynth port. SDL2_mixer is ported and
+ * carries its own timidity, which renders MIDI with the patch set from
+ * the freepats package.
+ *
+ * SDL2 allows only one output device on AROS, so the sound driver goes
+ * through SDL2_mixer as well (see sound/sdlmixer_s.cpp) and the
+ * Mix_OpenAudio() below joins that same device by refcount.
+ */
+
+#include "../stdafx.h"
+
+#include "sdlmixer_m.h"
+
+#include <SDL.h>
+#include <SDL_mixer.h>
+
+#include "../debug.h"
+#include "midifile.hpp"
+
+#include "../safeguards.h"
+
+/** Factory for the SDL2_mixer driver. */
+static FMusicDriver_SdlMixer iFMusicDriver_SdlMixer;
+
+std::optional<std::string_view> MusicDriver_SdlMixer::Start(const StringList &param)
+{
+	/* The sound driver normally got here first. Only quit in Stop() what was
+	 * started here, or the refcount drops below what the sound driver holds
+	 * and the audio subsystem goes down under its still-open device. */
+	if (SDL_WasInit(SDL_INIT_AUDIO) == 0) {
+		int ret_code = (SDL_WasInit(SDL_INIT_EVERYTHING) == 0) ? SDL_Init(SDL_INIT_AUDIO) : SDL_InitSubSystem(SDL_INIT_AUDIO);
+		if (ret_code == -1) return SDL_GetError();
+		this->inited_audio = true;
+	}
+
+	int hz = GetDriverParamInt(param, "hz", 44100);
+	int samples = GetDriverParamInt(param, "samples", 1024);
+	if (Mix_OpenAudio(hz, MIX_DEFAULT_FORMAT, 2, samples) == -1) return Mix_GetError();
+
+	return std::nullopt;
+}
+
+void MusicDriver_SdlMixer::Stop()
+{
+	this->StopSong();
+	Mix_CloseAudio();
+	if (this->inited_audio) SDL_QuitSubSystem(SDL_INIT_AUDIO);
+}
+
+void MusicDriver_SdlMixer::PlaySong(const MusicSongInfo &song)
+{
+	std::string filename = MidiFile::GetSMFFile(song);
+
+	this->StopSong();
+
+	if (filename.empty()) return;
+
+	this->music = Mix_LoadMUS(filename.c_str());
+	if (this->music == nullptr) {
+		Debug(driver, 0, "sdlmixer: could not load '{}': {}", filename, Mix_GetError());
+		return;
+	}
+
+	if (Mix_PlayMusic(this->music, 1) == -1) {
+		Debug(driver, 0, "sdlmixer: could not play '{}': {}", filename, Mix_GetError());
+		this->StopSong();
+	}
+}
+
+void MusicDriver_SdlMixer::StopSong()
+{
+	if (this->music == nullptr) return;
+
+	Mix_HaltMusic();
+	Mix_FreeMusic(this->music);
+	this->music = nullptr;
+}
+
+bool MusicDriver_SdlMixer::IsSongPlaying()
+{
+	return Mix_PlayingMusic() != 0;
+}
+
+void MusicDriver_SdlMixer::SetVolume(uint8_t vol)
+{
+	/* OpenTTD's volume is 0-127, which MIX_MAX_VOLUME (128) covers directly. */
+	Mix_VolumeMusic(vol);
+}
