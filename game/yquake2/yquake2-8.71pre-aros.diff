diff --git a/src/backends/unix/aros_netstub.c b/src/backends/unix/aros_netstub.c
new file mode 100644
index 00000000..daf72975
--- /dev/null
+++ b/src/backends/unix/aros_netstub.c
@@ -0,0 +1,99 @@
+/*
+ * AROS: libnet provides the core BSD socket calls (socket/bind/sendto/
+ * recvfrom/select/...) but not these resolver/format helpers. Provide
+ * them here. inet_ntop/inet_pton get real IPv4 implementations (used for
+ * address logging); getaddrinfo/getnameinfo are stubbed — real
+ * multiplayer name resolution is a later refinement, single-player only
+ * uses the in-memory loopback path.
+ *
+ * Deliberately does NOT include <arpa/inet.h>/<netdb.h>: those macro-
+ * redirect inet_ntop->__inet_ntop etc. We define the plain symbols the
+ * linker actually wants. Only symbol names matter across TUs, so the
+ * simplified prototypes here are ABI-compatible with the callers.
+ */
+
+#include <stdio.h>
+
+#define AROS_AF_INET 2   /* BSD AF_INET */
+
+unsigned int
+if_nametoindex(const char *ifname)
+{
+	(void)ifname;
+	return 0;
+}
+
+int
+getaddrinfo(const char *node, const char *service,
+            const void *hints, void **res)
+{
+	(void)node;
+	(void)service;
+	(void)hints;
+	if (res)
+	{
+		*res = 0;
+	}
+	return -1;   /* EAI_FAIL-ish; callers log and give up */
+}
+
+void
+freeaddrinfo(void *res)
+{
+	(void)res;
+}
+
+int
+getnameinfo(const void *sa, unsigned int salen, char *host,
+            unsigned int hostlen, char *serv, unsigned int servlen, int flags)
+{
+	(void)sa;
+	(void)salen;
+	(void)flags;
+	if (host && hostlen)
+	{
+		host[0] = '\0';
+	}
+	if (serv && servlen)
+	{
+		serv[0] = '\0';
+	}
+	return -1;
+}
+
+const char *
+inet_ntop(int af, const void *src, char *dst, unsigned int size)
+{
+	if (af == AROS_AF_INET)
+	{
+		const unsigned char *p = src;
+		snprintf(dst, size, "%u.%u.%u.%u", p[0], p[1], p[2], p[3]);
+		return dst;
+	}
+	if (size)
+	{
+		dst[0] = '\0';
+	}
+	return 0;
+}
+
+int
+inet_pton(int af, const char *src, void *dst)
+{
+	if (af == AROS_AF_INET)
+	{
+		unsigned int a, b, c, d;
+
+		if (sscanf(src, "%u.%u.%u.%u", &a, &b, &c, &d) == 4)
+		{
+			unsigned char *p = dst;
+			p[0] = (unsigned char)a;
+			p[1] = (unsigned char)b;
+			p[2] = (unsigned char)c;
+			p[3] = (unsigned char)d;
+			return 1;
+		}
+		return 0;
+	}
+	return -1;
+}
