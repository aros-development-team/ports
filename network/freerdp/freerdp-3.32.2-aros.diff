--- /dev/null
+++ b/client/AROS/make-icon.c
@@ -0,0 +1,37 @@
+/* Generate a native tool icon with the stack size used during qualification. */
+#include <proto/icon.h>
+#include <workbench/workbench.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(int argc, char **argv)
+{
+    if (argc < 2) { puts("Usage: MakeIcon program [HEX]"); return 20; }
+    struct DiskObject *icon = GetDefDiskObject(WBTOOL);
+    if (!icon) return 20;
+    icon->do_StackSize = 4194304;
+    int ok = PutDiskObject(argv[1], icon);
+    FreeDiskObject(icon);
+    if (!ok) return 20;
+    icon = GetDiskObject(argv[1]);
+    if (!icon) return 20;
+    ok = icon->do_StackSize == 4194304;
+    FreeDiskObject(icon);
+    if (!ok) return 20;
+    puts("ICON_STACK=4194304");
+    if (argc > 2 && !strcmp(argv[2], "HEX")) {
+        char path[1024];
+        if (snprintf(path, sizeof(path), "%s.info", argv[1]) >= (int)sizeof(path)) return 20;
+        FILE *f = fopen(path, "rb");
+        if (!f) return 20;
+        unsigned char bytes[64]; size_t n;
+        while ((n = fread(bytes, 1, sizeof(bytes), f)) != 0) {
+            fputs("ICON_HEX=", stdout);
+            for (size_t i = 0; i < n; i++) printf("%02x", bytes[i]);
+            putchar('\n');
+        }
+        ok = !ferror(f); fclose(f);
+        if (!ok) return 20;
+    }
+    return 0;
+}
diff --git a/client/AROS/native.c b/client/AROS/native.c
