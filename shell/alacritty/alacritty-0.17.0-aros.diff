diff -ruN -x .git -x target -x .github alacritty-0.17.0.orig/alacritty_terminal/src/tty/aros.rs alacritty-0.17.0/alacritty_terminal/src/tty/aros.rs
--- alacritty-0.17.0.orig/alacritty_terminal/src/tty/aros.rs	1970-01-01 01:00:00
+++ alacritty-0.17.0/alacritty_terminal/src/tty/aros.rs	2026-10-04 08:49:14
@@ -0,0 +1,233 @@
+//! TTY for AROS.
+//!
+//! AROS has no pseudo-terminals. The shell runs against a console handler of
+//! our own instead (`aros-pty-sys`), which plays the part of a CON: window.
+//! A thread blocks on the console's output and posts readiness to the
+//! poller, as the Windows backend does for ConPTY.
+
+use std::collections::VecDeque;
+use std::ffi::CString;
+use std::io::{self, ErrorKind, Read, Write};
+use std::sync::{Arc, Mutex};
+use std::thread::JoinHandle;
+
+use aros_pty_sys as sys;
+use log::warn;
+use polling::os::aros::PollerArosExt;
+use polling::{Event, PollMode, Poller};
+
+use crate::event::{OnResize, WindowSize};
+use crate::thread;
+use crate::tty::{ChildEvent, EventedPty, EventedReadWrite, Options, Shell};
+
+// Interest in PTY read/writes.
+pub(crate) const PTY_READ_WRITE_TOKEN: usize = 0;
+
+// Interest in new child events.
+pub(crate) const PTY_CHILD_EVENT_TOKEN: usize = 1;
+
+/// The console handle, used by the terminal and the reader thread.
+struct Console(*mut sys::aros_pty);
+
+// SAFETY: the console locks its shared state itself.
+unsafe impl Send for Console {}
+unsafe impl Sync for Console {}
+
+#[derive(Default)]
+struct State {
+    output: VecDeque<u8>,
+    exited: bool,
+    exit_reported: bool,
+    interest: Option<(Arc<Poller>, Event)>,
+}
+
+impl State {
+    /// Tells the poller about whatever is ready for the registered interest.
+    fn post(&self) {
+        let Some((poller, interest)) = &self.interest else { return };
+        if interest.readable && !self.output.is_empty() {
+            let _ = poller.post(Event::readable(PTY_READ_WRITE_TOKEN));
+        }
+        if self.exited && !self.exit_reported {
+            let _ = poller.post(Event::readable(PTY_CHILD_EVENT_TOKEN));
+        }
+    }
+}
+
+struct Shared {
+    console: Console,
+    state: Mutex<State>,
+}
+
+pub struct Pty {
+    shared: Arc<Shared>,
+    reader: Reader,
+    writer: Writer,
+    thread: Option<JoinHandle<()>>,
+}
+
+/// Output of the console, as far as the reader thread has collected it.
+pub struct Reader(Arc<Shared>);
+
+impl Read for Reader {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        let mut state = self.0.state.lock().unwrap();
+        if state.output.is_empty() {
+            return if state.exited { Ok(0) } else { Err(ErrorKind::WouldBlock.into()) };
+        }
+        let len = buf.len().min(state.output.len());
+        for (dst, src) in buf.iter_mut().zip(state.output.drain(..len)) {
+            *dst = src;
+        }
+        Ok(len)
+    }
+}
+
+/// Input to the console, which queues it without blocking.
+pub struct Writer(Arc<Shared>);
+
+impl Write for Writer {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        let len = buf.len().min(i32::MAX as usize);
+        unsafe { sys::aros_pty_write(self.0.console.0, buf.as_ptr(), len as i32) };
+        Ok(len)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// The command line for the shell, or `None` for the user shell itself.
+fn command_line(shell: Option<&Shell>) -> Option<CString> {
+    let shell = shell?;
+    let mut line = shell.program.clone();
+    for arg in &shell.args {
+        line.push(' ');
+        if arg.is_empty() || arg.contains([' ', '"']) {
+            line.push('"');
+            line.push_str(&arg.replace('"', "*\""));
+            line.push('"');
+        } else {
+            line.push_str(arg);
+        }
+    }
+    CString::new(line).ok()
+}
+
+/// Create a new TTY and return a handle to interact with it.
+pub fn new(config: &Options, window_size: WindowSize, _window_id: u64) -> io::Result<Pty> {
+    if config.working_directory.is_some() {
+        warn!("Working directory is not supported on AROS yet");
+    }
+
+    let command = command_line(config.shell.as_ref());
+    let console = unsafe {
+        sys::aros_pty_spawn(
+            command.as_ref().map_or(std::ptr::null(), |command| command.as_ptr()),
+            i32::from(window_size.num_cols),
+            i32::from(window_size.num_lines),
+        )
+    };
+    if console.is_null() {
+        return Err(io::Error::other("could not start a shell on the console"));
+    }
+
+    let shared = Arc::new(Shared { console: Console(console), state: Mutex::default() });
+
+    let reader_shared = shared.clone();
+    let thread = thread::spawn_named("PTY console reader", move || {
+        let mut buf = [0u8; 4096];
+        loop {
+            let len = unsafe {
+                sys::aros_pty_read(reader_shared.console.0, buf.as_mut_ptr(), buf.len() as i32)
+            };
+            let mut state = reader_shared.state.lock().unwrap();
+            if len <= 0 {
+                // Every handle on the console is closed: the shell is gone.
+                state.exited = true;
+                state.post();
+                break;
+            }
+            state.output.extend(&buf[..len as usize]);
+            state.post();
+        }
+    });
+
+    Ok(Pty {
+        reader: Reader(shared.clone()),
+        writer: Writer(shared.clone()),
+        shared,
+        thread: Some(thread),
+    })
+}
+
+impl Drop for Pty {
+    fn drop(&mut self) {
+        // Ends the shell and waits until nothing uses the console any more,
+        // which also lets the reader thread see the end.
+        unsafe { sys::aros_pty_close(self.shared.console.0) };
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+        unsafe { sys::aros_pty_free(self.shared.console.0) };
+    }
+}
+
+impl EventedReadWrite for Pty {
+    type Reader = Reader;
+    type Writer = Writer;
+
+    unsafe fn register(&mut self, poll: &Arc<Poller>, interest: Event, mode: PollMode) -> io::Result<()> {
+        self.reregister(poll, interest, mode)
+    }
+
+    fn reregister(&mut self, poll: &Arc<Poller>, mut interest: Event, _: PollMode) -> io::Result<()> {
+        interest.key = PTY_READ_WRITE_TOKEN;
+        let mut state = self.shared.state.lock().unwrap();
+        state.interest = Some((poll.clone(), interest));
+        // Writes never block, so write interest is met at once.
+        if interest.writable {
+            poll.post(Event::writable(PTY_READ_WRITE_TOKEN))?;
+        }
+        state.post();
+        Ok(())
+    }
+
+    fn deregister(&mut self, _: &Arc<Poller>) -> io::Result<()> {
+        self.shared.state.lock().unwrap().interest = None;
+        Ok(())
+    }
+
+    fn reader(&mut self) -> &mut Reader {
+        &mut self.reader
+    }
+
+    fn writer(&mut self) -> &mut Writer {
+        &mut self.writer
+    }
+}
+
+impl EventedPty for Pty {
+    fn next_child_event(&mut self) -> Option<ChildEvent> {
+        let mut state = self.shared.state.lock().unwrap();
+        if state.exited && !state.exit_reported {
+            state.exit_reported = true;
+            Some(ChildEvent::Exited(None))
+        } else {
+            None
+        }
+    }
+}
+
+impl OnResize for Pty {
+    fn on_resize(&mut self, window_size: WindowSize) {
+        unsafe {
+            sys::aros_pty_resize(
+                self.shared.console.0,
+                i32::from(window_size.num_cols),
+                i32::from(window_size.num_lines),
+            )
+        };
+    }
+}
