diff --git a/channels/audin/client/ahi/audin_ahi.c b/channels/audin/client/ahi/audin_ahi.c
new file mode 100644
index 0000000..869de4a
--- /dev/null
+++ b/channels/audin/client/ahi/audin_ahi.c
@@ -0,0 +1,90 @@
+/* AHI microphone adapter. Capture starts only when audin is explicitly enabled. */
+#include <freerdp/config.h>
+#include <winpr/crt.h>
+#include <winpr/thread.h>
+#include <winpr/synch.h>
+#include <winpr/interlocked.h>
+#include "audin_main.h"
+#include "ahi_native.h"
+typedef struct {
+    IAudinDevice iface;
+    AUDIO_FORMAT format;
+    UINT32 frames;
+    HANDLE thread, ready;
+    LONG stopping;
+    UINT startup;
+    AudinReceive receive;
+    void *user;
+} AhiDevice;
+static BOOL supported(IAudinDevice *dev, const AUDIO_FORMAT *f)
+{
+    WINPR_UNUSED(dev);
+    return f && f->wFormatTag == WAVE_FORMAT_PCM && f->wBitsPerSample == 16 &&
+        (f->nChannels == 1 || f->nChannels == 2) && f->nSamplesPerSec >= 8000 &&
+        f->nSamplesPerSec <= 96000 && f->nBlockAlign == f->nChannels * 2 &&
+        f->nAvgBytesPerSec == f->nSamplesPerSec * f->nBlockAlign && f->cbSize == 0;
+}
+static UINT set_format(IAudinDevice *dev, const AUDIO_FORMAT *f, UINT32 frames)
+{
+    AhiDevice *a = (AhiDevice *)dev;
+    if (a->thread || !supported(dev, f) || !frames || frames > 16384) return ERROR_INVALID_PARAMETER;
+    a->format = *f; a->frames = frames; return CHANNEL_RC_OK;
+}
+static DWORD WINAPI capture_thread(void *arg)
+{
+    AhiDevice *a = arg;
+    size_t length = (size_t)a->frames * a->format.nBlockAlign;
+    BYTE *buffer = calloc(1, length);
+    struct ahi_capture *capture = buffer ? ahi_capture_open(a->format.nSamplesPerSec, a->format.nChannels) : NULL;
+    a->startup = capture ? CHANNEL_RC_OK : ERROR_NOT_SUPPORTED;
+    SetEvent(a->ready);
+    if (capture) {
+        while (!InterlockedCompareExchange(&a->stopping, 0, 0)) {
+            if (!ahi_capture_start(capture, buffer, length)) { WLog_ERR(TAG, "AHI capture request failed"); break; }
+            size_t actual = 0; int state = 0;
+            do {
+                if (InterlockedCompareExchange(&a->stopping, 0, 0)) goto done;
+                state = ahi_capture_poll(capture, &actual);
+                if (!state) Sleep(1);
+            } while (!state);
+            if (state < 0 || actual > length || actual % a->format.nBlockAlign) { WLog_ERR(TAG, "AHI capture completion invalid: state=%d bytes=%" PRIuz, state, actual); break; }
+            if (actual && a->receive(&a->format, buffer, actual, a->user) != CHANNEL_RC_OK) { WLog_ERR(TAG, "Microphone channel rejected captured PCM"); break; }
+        }
+    }
+done:
+    ahi_capture_close(capture);
+    if (buffer) { SecureZeroMemory(buffer, length); free(buffer); }
+    return 0;
+}
+static UINT close_capture(IAudinDevice *dev)
+{
+    AhiDevice *a = (AhiDevice *)dev;
+    (void)InterlockedExchange(&a->stopping, 1);
+    if (a->thread) { WaitForSingleObject(a->thread, INFINITE); CloseHandle(a->thread); a->thread = NULL; }
+    if (a->ready) { CloseHandle(a->ready); a->ready = NULL; }
+    a->receive = NULL; a->user = NULL; return CHANNEL_RC_OK;
+}
+static UINT open_capture(IAudinDevice *dev, AudinReceive receive, void *user)
+{
+    AhiDevice *a = (AhiDevice *)dev;
+    if (a->thread || !receive || !supported(dev, &a->format) || !a->frames) return ERROR_INVALID_PARAMETER;
+    a->receive = receive; a->user = user; a->startup = ERROR_INTERNAL_ERROR;
+    (void)InterlockedExchange(&a->stopping, 0);
+    a->ready = CreateEvent(NULL, TRUE, FALSE, NULL);
+    if (a->ready) a->thread = CreateThread(NULL, 0, capture_thread, a, 0, NULL);
+    if (!a->thread) { close_capture(dev); return ERROR_INTERNAL_ERROR; }
+    if (WaitForSingleObject(a->ready, 5000) != WAIT_OBJECT_0) { close_capture(dev); return ERROR_TIMEOUT; }
+    if (a->startup) { UINT error = a->startup; close_capture(dev); return error; }
+    return CHANNEL_RC_OK;
+}
+static UINT free_capture(IAudinDevice *dev) { close_capture(dev); free(dev); return CHANNEL_RC_OK; }
+FREERDP_ENTRY_POINT(UINT VCAPITYPE ahi_freerdp_audin_client_subsystem_entry(PFREERDP_AUDIN_DEVICE_ENTRY_POINTS entry))
+{
+    AhiDevice *a = calloc(1, sizeof(*a));
+    if (!a) return CHANNEL_RC_NO_MEMORY;
+    a->iface.Open = open_capture; a->iface.Close = close_capture;
+    a->iface.Free = free_capture; a->iface.SetFormat = set_format; a->iface.FormatSupported = supported;
+    UINT result = entry->pRegisterAudinDevice(entry->plugin, &a->iface);
+    if (result) free(a);
+    return result;
+}
