diff -ruN -x .cargo-checksum.json -x Cargo.toml.orig -x .cargo_vcs_info.json -x target -x Cargo.lock a/build.rs b/build.rs
--- a/build.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/build.rs	2026-10-12 13:34:37.462427135 +0100
@@ -0,0 +1,38 @@
+//! On AROS, compiles the AHI glue (`src/hw/ahi_glue.c`) with the AROS C cross compiler
+//! (`AROS_CC` / `AROS_AR`, else `<arch>-aros-cc` and `<arch>-aros-ar` on the PATH) and links it
+//! in. Nothing happens on other targets.
+
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-changed=src/hw/ahi_glue.c");
+    println!("cargo:rerun-if-env-changed=AROS_CC");
+    println!("cargo:rerun-if-env-changed=AROS_AR");
+    let os = std::env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
+    if os != "aros" {
+        return;
+    }
+    let arch = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
+    let cc = std::env::var("AROS_CC").unwrap_or_else(|_| format!("{arch}-aros-cc"));
+    let ar = std::env::var("AROS_AR").unwrap_or_else(|_| format!("{arch}-aros-ar"));
+    let out = PathBuf::from(std::env::var("OUT_DIR").unwrap_or_default());
+    let obj = out.join("ahi_glue.o");
+    let lib = out.join("libmaolan_ahi.a");
+    let ok = Command::new(&cc)
+        .args(["-O2", "-Wall", "-c", "src/hw/ahi_glue.c", "-o"])
+        .arg(&obj)
+        .status()
+        .map(|s| s.success())
+        .unwrap_or(false);
+    if !ok {
+        panic!("maolan-engine build.rs: {cc} failed on src/hw/ahi_glue.c");
+    }
+    let _ = std::fs::remove_file(&lib);
+    let ok = Command::new(&ar).arg("crs").arg(&lib).arg(&obj).status().map(|s| s.success()).unwrap_or(false);
+    if !ok {
+        panic!("maolan-engine build.rs: {ar} failed");
+    }
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=maolan_ahi");
+}
