+#if !defined(NOTTF) && defined(__AROS__)
+byte *Render_text_AROS(const char *str, int font_number, int size,
+                       int antialias, int bold, int italic, int *width,
+                       int *height, T_Palette palette) {
+  FT_Library library;
+  FT_Face face;
+  FT_Matrix matrix;
+  FT_Int strength;
+  FT_Vector kerning;
+  FT_UInt previous_glyph = 0;
+  FT_Int32 load_flags;
+  FT_Int32 render_mode;
+  byte *new_brush;
+  int pen_x = 0;
+  const char *p;
+  int max_ascent = 0;
+  int max_descent = 0;
+  int total_width = 0;
+  int baseline;
+
+  // Initialize FreeType
+  if (FT_Init_FreeType(&library)) {
+    return NULL;
+  }
+
+  // Load font face
+  if (FT_New_Face(library, Font_name(font_number), 0, &face)) {
+    FT_Done_FreeType(library);
+    return NULL;
+  }
+
+  // Set character size (in 1/64th points)
+  FT_Set_Char_Size(face, 0, size * 64, 96, 96);
+
+  // Calculate bold strength based on font size
+  // Typically 1/36 of the point size (in FT_Pos units, which are 1/64 pixel)
+  strength = bold ? (size * 64) / 24 : 0;
+
+  // Set the render mode based on antialiasing preference
+  if (antialias) {
+    load_flags = FT_LOAD_DEFAULT;
+    render_mode = FT_RENDER_MODE_NORMAL;
+  } else {
+    load_flags = FT_LOAD_TARGET_MONO;
+    render_mode = FT_RENDER_MODE_MONO;
+  }
+  if (bold) {
+    load_flags |= FT_LOAD_NO_BITMAP;
+  }
+
+  // Setup matrix for bold and italic transformations
+  // Check if font is inherently italic/oblique
+  int is_font_italic = (face->style_flags & FT_STYLE_FLAG_ITALIC) != 0;
+
+  // Only apply italic transform if the font isn't already italic and italic was requested
+  if (italic && !is_font_italic) {
+      matrix.xy = 0x10000L >> 2;  // Apply italic transform
+      matrix.xx = 0x10000L;       // 1.0 in 16.16 fixed point
+      matrix.yx = 0;
+      matrix.yy = 0x10000L;       // 1.0
+
+      FT_Set_Transform(face, &matrix, NULL);
+  }
+
+  int spaceing_adjustment = 0;
+  int italic_extra_width = (italic || bold) ? (size / 2) : 0;  // Add extra width for italic slant or bold width
+  total_width = italic_extra_width;
+
+  // First pass: calculate dimensions
+  for (p = str; *p; p++) {
+    FT_UInt current_glyph = FT_Get_Char_Index(face, *p);
+
+    // Apply kerning
+    if (FT_HAS_KERNING(face) && previous_glyph && current_glyph) {
+      FT_Get_Kerning(face, previous_glyph, current_glyph, FT_KERNING_DEFAULT,
+                     &kerning);
+      total_width += kerning.x >> 6;
+    }
+
+    // Apply synthetic bold if needed
+    if (bold && !(face->style_flags & FT_STYLE_FLAG_BOLD)) {
+      FT_Outline_EmboldenXY(&face->glyph->outline, strength, 1.0);
+    }
+
+    if (FT_Load_Char(face, *p, load_flags)) {
+      continue;
+    }
+
+    // Get glyph metrics
+    FT_Glyph_Metrics metrics = face->glyph->metrics;
+
+    // For italic, add some extra width based on the glyph height
+    int glyph_italic_extra = italic ? ((metrics.height >> 6) / 4) : 0;
+
+    // Add glyph width to total
+    total_width += (face->glyph->advance.x >> 6) + spaceing_adjustment +
+                   glyph_italic_extra;
+
+    // Track max dimensions
+    if (face->glyph->bitmap_top > max_ascent)
+      max_ascent = face->glyph->bitmap_top;
+    if ((face->glyph->bitmap.rows - face->glyph->bitmap_top) > max_descent)
+      max_descent = face->glyph->bitmap.rows - face->glyph->bitmap_top;
+
+    previous_glyph = current_glyph;
+  }
+
+  *height = max_ascent + max_descent;
+  *width = total_width;
+  baseline = max_ascent;
+
+  new_brush = (byte *)malloc(total_width * *height);
+  if (!new_brush) {
+    FT_Done_Face(face);
+    FT_Done_FreeType(library);
+    return NULL;
+  }
+
+  // Clear bitmap with background color
+  memset(new_brush, Back_color, total_width * *height);
+
+  pen_x = 0;
+  for (p = str; *p; p++) {
+    FT_UInt current_glyph = FT_Get_Char_Index(face, *p);
+
+    // Apply kerning if available
+    if (FT_HAS_KERNING(face) && previous_glyph && current_glyph) {
+      FT_Get_Kerning(face, previous_glyph, current_glyph, FT_KERNING_DEFAULT,
+                     &kerning);
+      pen_x += kerning.x >> 6;
+    }
+
+    // Load character
+    FT_Error error = FT_Load_Char(face, *p, load_flags);
+    if (error) {
+      GFX2_Log(GFX2_WARNING, "Failed to load character '%c' (error %d)\n", *p, error);
+      continue;
+    }
+
+    // Apply synthetic bold if needed
+    if (bold && !(face->style_flags & FT_STYLE_FLAG_BOLD)) {
+      FT_Outline_EmboldenXY(&face->glyph->outline, strength, 1.0);
+    }
+
+    FT_Render_Glyph(face->glyph, render_mode);
+    FT_Bitmap *bitmap = &face->glyph->bitmap;
+
+    // Calculate the advance width for this character
+    int advance_width = (face->glyph->advance.x >> 6) + spaceing_adjustment;
+    if (advance_width < bitmap->width) {
+      advance_width =
+          bitmap->width; // Ensure advance is at least as wide as the bitmap
+    }
+
+    // Center the glyph within its advance width
+    int char_center_offset;
+    if (bitmap->width > advance_width) {
+      char_center_offset = 0; // If glyph is wider than advance, don't center
+    } else {
+      char_center_offset = (advance_width - bitmap->width) / 2;
+    }
+
+    // Ensure x_pos stays within bounds
+    int x_pos = pen_x + char_center_offset;
+    int y_offset = baseline - face->glyph->bitmap_top;
+
+    // Copy the rendered glyph to our buffer
+    for (int y = 0; y < bitmap->rows; y++) {
+      if (y + y_offset >= 0 && y + y_offset < *height) {
+        for (int x = 0; x < bitmap->width; x++) {
+          if (x_pos + x < total_width) {
+            int index = (x_pos + x) + (y + y_offset) * total_width;
+            if (antialias) {
+              unsigned char value = bitmap->buffer[y * bitmap->pitch + x];
+              if (value > 1) { // Ensure value is in valid range
+                new_brush[index] = value;
+                palette[value].R = value;
+                palette[value].G = value;
+                palette[value].B = value;
+              }
+            } else {
+              unsigned char byte = bitmap->buffer[y * bitmap->pitch + (x >> 3)];
+              if (byte & (0x80 >> (x & 7))) {
+                new_brush[index] = Fore_color;
+              }
+            }
+          }
+        }
+      }
+    }
+
+    // Update pen position with optional adjustment
+    pen_x += advance_width;
+    previous_glyph = current_glyph;
+  }
+
+  if (!antialias) {
+    memcpy(palette, Main.palette, sizeof(T_Palette));
+  }
+
+  FT_Done_Face(face);
+  FT_Done_FreeType(library);
+
+  return new_brush;
+}
