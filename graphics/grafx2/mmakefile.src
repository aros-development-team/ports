# $Id$

include $(SRCDIR)/config/aros-contrib.cfg

#MM- ports-graphics : ports-graphics-grafx2

#MM  ports-graphics-grafx2 : includes linklibs \
#MM    contrib-development-lua \
#MM    ports-graphics-grafx2-genfiles \
#MM    ports-graphics-grafx2-data

#MM  ports-graphics-grafx2-genfiles : ports-graphics-grafx2-fetch ports-graphics-grafx2-3rdparty
#MM  ports-graphics-grafx2-3rdparty : ports-graphics-grafx2-fetch

#MM  ports-graphics-grafx2-data : ports-graphics-grafx2-fetch

GFXVERS      := 2.9
REPOSITORIES := https://gitlab.com/GrafX2/grafX2/-/archive/v$(GFXVERS)
ARCHBASE     := grafX2-v$(GFXVERS)
TARGETDIR    := $(AROS_CONTRIB)/MultiMedia/Gfx/GrafX2
ARCHSUFFIX   := "tgz"
PATCHSPEC    := $(ARCHBASE)-aros.diff:$(ARCHBASE):-p1

NOWARN_FLAGS := $(NOWARN_MISLEADING_INDENTATION) $(NOWARN_UNUSED_BUT_SET_VARIABLE) $(NOWARN_CPP) $(NOWARN_FORMAT)
USER_CFLAGS  := $(COMPILER_COMMON_CFLAGS) $(NOWARN_FLAGS) -g
USER_CPPFLAGS := \
	-D_GNU_SOURCE=1 \
	-D_REENTRANT \
	-D__ENABLE_LUA__ \
	-D__no_tifflib__ \
	-DCPU_6502_STATIC \
	-DCPU_6502_USE_LOCAL_HEADER \
	-DCPU_6502_DEPENDENCIES_H=\"6502types.h\"
USER_INCLUDES := -I$(AROS_INCLUDES)/lua -I$(AROS_CONTRIB_INCLUDES) -iquote $(GENDIR)/$(CURDIR) -iquote $(GENDIR)/$(CURDIR)/3rdparty/6502/API/emulation/CPU -iquote $(PORTSDIR)/grafx2/$(ARCHBASE)/src
USER_LDFLAGS := -L$(AROS_CONTRIB_LIB)

FILES := \
	main \
	init \
	graph \
	misc \
	osdep \
	special \
	buttons \
	palette \
	help \
	operatio \
	pages \
	readline \
	engine \
	filesel \
	fileseltools \
	op_c \
	readini \
	saveini \
	shade \
	keyboard \
	io \
	text \
	SFont \
	setup \
	pxsimple \
	pxtall \
	pxwide \
	pxdouble \
	pxtriple \
	pxtall2 \
	pxtall3 \
	pxwide2 \
	pxquad \
	windows \
	brush \
	realpath \
	mountlist \
	input \
	hotkeys \
	transform \
	pversion \
	factory \
	loadsave \
	loadsavefuncs \
	loadrecoil \
	pngformat \
	motoformats \
	stformats \
	c64formats \
	cpcformats \
	ifformat \
	msxformats \
	packbits \
	giformat \
	2gsformats \
	packbytes \
	fileformats \
	miscfileformats \
	libraw2crtc \
	brush_ops \
	buttons_effects \
	layers \
	oldies \
	tiles \
	colorred \
	unicode \
	gfx2surface \
	gfx2log \
	gfx2mem \
	tifformat \
	c64load \
	cgfxscreen

FILES := $(addprefix $(PORTSDIR)/grafx2/$(ARCHBASE)/src/,$(FILES))
GENFILES := $(GENDIR)/$(CURDIR)/version $(GENDIR)/$(CURDIR)/6502 $(GENDIR)/$(CURDIR)/recoil

%build_prog mmake=ports-graphics-grafx2 progname=GrafX2 \
    files="$(FILES) $(GENFILES)" targetdir=$(TARGETDIR) \
    uselibs="lua png jpeg z freetype2"

# Generated source files
$(GENDIR)/$(CURDIR)/version.c : | $(GENDIR)/$(CURDIR)
	@$(ECHO) "const char SVN_revision[]=\"AROS\";" > $@

$(GENDIR)/$(CURDIR)/6502.c : | $(GENDIR)/$(CURDIR)
	mkdir -p $(GENDIR)/$(CURDIR)/doc
	make -C $(GENDIR)/$(CURDIR)/3rdparty 6502 && $(CP) $(GENDIR)/$(CURDIR)/3rdparty/6502/sources/6502.c $@

$(GENDIR)/$(CURDIR)/recoil.c : | $(GENDIR)/$(CURDIR)
	make -C $(GENDIR)/$(CURDIR)/3rdparty recoil && $(CP) $(GENDIR)/$(CURDIR)/3rdparty/recoil-*/recoil.c $@ && $(CP) $(GENDIR)/$(CURDIR)/3rdparty/recoil-*/recoil.h $(GENDIR)/$(CURDIR)/

#MM
ports-graphics-grafx2-genfiles : $(GENDIR)/$(CURDIR)/version.c $(GENDIR)/$(CURDIR)/6502.c $(GENDIR)/$(CURDIR)/recoil.c

############################################################################################################

%fetch mmake=ports-graphics-grafx2-fetch archive=$(ARCHBASE) destination=$(PORTSDIR)/grafx2 \
    location=$(PORTSSOURCEDIR) archive_origins=$(REPOSITORIES) suffixes="$(ARCHSUFFIX)" \
    patches_specs=$(PATCHSPEC)

%create_patch mmake=ports-graphics-grafx2-patch \
    archive=$(ARCHBASE) suffixes=$(ARCHSUFFIX) \
    destination=$(PORTSDIR)/grafx2

############################################################################################################

#MM  ports-graphics-grafx2-data : ports-graphics-grafx2-fetch
ports-graphics-grafx2-data:
	$(MKDIR) $(TARGETDIR)/data $(TARGETDIR)/data/fonts $(TARGETDIR)/data/skins $(TARGETDIR)/data/scripts
	$(CP) $(PORTSDIR)/grafx2/$(ARCHBASE)/share/grafx2/gfx2def.ini $(TARGETDIR)/data/
	$(CP) $(PORTSDIR)/grafx2/$(ARCHBASE)/share/grafx2/gfx2.png $(TARGETDIR)/data/
	$(CP) $(PORTSDIR)/grafx2/$(ARCHBASE)/share/grafx2/fonts/* $(TARGETDIR)/data/fonts/
	$(CP) $(PORTSDIR)/grafx2/$(ARCHBASE)/share/grafx2/skins/* $(TARGETDIR)/data/skins/
	$(CP) $(PORTSDIR)/grafx2/$(ARCHBASE)/misc/morphos/grafx2.info $(TARGETDIR)/GrafX2.info

%copy_dir_recursive mmake=ports-graphics-grafx2-3rdparty src=$(PORTSDIR)/grafx2/$(ARCHBASE)/3rdparty \
    dst=$(GENDIR)/$(CURDIR)/3rdparty

%common
