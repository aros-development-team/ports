diff --git a/client/AROS/clipboard_native.c b/client/AROS/clipboard_native.c
new file mode 100644
index 0000000..63eaf50
--- /dev/null
+++ b/client/AROS/clipboard_native.c
@@ -0,0 +1,56 @@
+#include <exec/types.h>
+#include <libraries/iffparse.h>
+#include <datatypes/textclass.h>
+#include <proto/iffparse.h>
+#include <stdlib.h>
+#include <string.h>
+#include "native.h"
+char *native_clipboard_read(void)
+{
+    char *text = NULL;
+    struct IFFHandle *iff = AllocIFF();
+    if (!iff) return NULL;
+    iff->iff_Stream = (IPTR)OpenClipboard(0);
+    if (iff->iff_Stream) {
+        InitIFFasClip(iff);
+        if (!OpenIFF(iff, IFFF_READ)) {
+            if (!StopChunk(iff, ID_FTXT, ID_CHRS) && !ParseIFF(iff, IFFPARSE_SCAN)) {
+                struct ContextNode *chunk = CurrentChunk(iff);
+                if (chunk && chunk->cn_Type == ID_FTXT && chunk->cn_ID == ID_CHRS &&
+                    chunk->cn_Size >= 0 && chunk->cn_Size <= 1048576) {
+                    text = calloc(1, (size_t)chunk->cn_Size + 1);
+                    if (text && ReadChunkBytes(iff, text, chunk->cn_Size) != chunk->cn_Size) {
+                        free(text); text = NULL;
+                    }
+                }
+            }
+            CloseIFF(iff);
+        }
+        CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+    }
+    FreeIFF(iff); return text;
+}
+int native_clipboard_write(const char *text)
+{
+    if (!text || strlen(text) > 1048576) return 0;
+    int result = 0;
+    struct IFFHandle *iff = AllocIFF();
+    if (!iff) return 0;
+    iff->iff_Stream = (IPTR)OpenClipboard(0);
+    if (iff->iff_Stream) {
+        InitIFFasClip(iff);
+        if (!OpenIFF(iff, IFFF_WRITE)) {
+            if (!PushChunk(iff, ID_FTXT, ID_FORM, IFFSIZE_UNKNOWN)) {
+                if (!PushChunk(iff, ID_FTXT, ID_CHRS, IFFSIZE_UNKNOWN)) {
+                    size_t size = strlen(text);
+                    result = WriteChunkBytes(iff, (void *)text, size) == size;
+                    if (PopChunk(iff)) result = 0;
+                }
+                if (PopChunk(iff)) result = 0;
+            }
+            CloseIFF(iff);
+        }
+        CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+    }
+    FreeIFF(iff); return result;
+}
