+
+#ifndef AROS_KEYTRANSLATION__H
+#define AROS_KEYTRANSLATION__H
+
+#include "BasicTypes.h"
+
+pp_uint16 toVK(pp_uint16 rawkey, pp_uint16 qualifier);
