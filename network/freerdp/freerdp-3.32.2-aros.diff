+struct native_options { int clipboard, sound, microphone, printer, fullscreen, resize, documents; char fingerprint[65]; char directory[260]; };
+int native_connection(char **host, char **user, char **password, char **domain, struct native_options *options);
+int native_confirm_certificate(const char *host, uint16_t port, const char *name, const char *fingerprint);
