+
+static CONST_STRPTR title = "GrafX2";
+struct Window *AmigaWindow = NULL;
+static struct Screen *AmigaScreen = NULL;
+static BOOL _fullscreen = FALSE;
+static T_GFX2_Surface *icon = NULL;
+static STRPTR BlankCursor = NULL;
+static ULONG lut[256] = {0};
+static APTR lock = 0;
+static UBYTE *bitmap_data = NULL;
+static ULONG *bitmap_data32 = NULL;
+static IPTR bitmap_pitch = 0;
+static IPTR bitmap_pitch32 = 0;
+volatile int Allow_colorcycling = 0;
+
+BOOL PointerSet = FALSE;
+struct IntuitionBase *IntuitionBase;
+struct GfxBase *GfxBase;
+struct Library *CyberGfxBase;
+
+static short Min_X = 0;
+static short Min_Y = 0;
+static short Max_X = 10000;
+static short Max_Y = 10000;
+static short Status_line_dirty_begin = 0;
+static short Status_line_dirty_end = 0;
+
+void FindWindowPosition(WORD *top, WORD *left, int width, int height) {
+  if ((*top == 0 && *left == 0) && !_fullscreen) {
+    *left = (AmigaScreen->Width - width) / 2;
+    *top = (AmigaScreen->Height - height) / 2;
+  }
+}
+
+void GFX2_Set_mode(int *width, int *height, int fullscreen) {
+  IPTR modeID = INVALID_ID;
+  BlankCursor = AllocMem(16, MEMF_CHIP | MEMF_CLEAR);
+  WORD _top = 0;
+  WORD _left = 0;
+
+  if (bitmap_data) {
+    FreeVec(bitmap_data);
+  }
+
+  if (AmigaWindow) {
+    _top = AmigaWindow->TopEdge;
+    _left = AmigaWindow->LeftEdge;
+    CloseWindow(AmigaWindow);
+    AmigaWindow = NULL;
+  }
+
+  if (_fullscreen && AmigaScreen) {
+    CloseScreen(AmigaScreen);
+    AmigaScreen = NULL;
+  }
+
+  if (fullscreen) {
+    modeID = Probe_Video_Mode(*width, *height);
+    if ((int)modeID == INVALID_ID) {
+      Cleanup("Could not find suitable screen mode!");
+    }
+
+    ULONG depth = GetCyberIDAttr(CYBRIDATTR_DEPTH, modeID);
+
+    AmigaScreen = OpenScreenTags(
+        NULL, SA_Left, 0, SA_Top, 0, SA_Width, *width, SA_Height, *height,
+        SA_Depth, depth, SA_DisplayID, modeID, SA_Type,
+        CUSTOMSCREEN | SDEPTH_TOFRONT, SA_ShowTitle, TRUE, SA_Behind, FALSE,
+        SA_Draggable, TRUE, SA_Quiet, TRUE, SA_Title, (IPTR)title, SA_PubName,
+        (IPTR)title, TAG_DONE);
+
+    if (!AmigaScreen) {
+      Cleanup("Failed to open CyberGraphics screen!");
+    }
+  } else {
+    if (!(AmigaScreen = LockPubScreen(NULL))) {
+      Cleanup("Can't lock pub screen!");
+    }
+
+    if (*width > AmigaScreen->Width || *height > AmigaScreen->Height) {
+      *width = Min(*width, AmigaScreen->Width);
+      *height = Min(*height, AmigaScreen->Height);
+      GFX2_Log(GFX2_WARNING, "Window size adjusted to fit screen: %dx%d\n",
+               *width, *height);
+    }
+  }
+
+  FindWindowPosition(&_top, &_left, *width, *height);
+
+  AmigaWindow = OpenWindowTags(
+      NULL, WA_InnerWidth, fullscreen ? AmigaScreen->Width : *width,
+      WA_InnerHeight, fullscreen ? AmigaScreen->Height : *height, WA_Top, _top,
+      WA_Left, _left, WA_DetailPen, 0, WA_BlockPen, 1, WA_GimmeZeroZero, 1,
+      WA_ReportMouse, 1, WA_Activate, 1, WA_RMBTrap, 1, WA_MinWidth, 320,
+      WA_MinHeight, 200, WA_MaxWidth, AmigaScreen->Width, WA_MaxHeight,
+      AmigaScreen->Height, WA_SizeGadget, fullscreen ? 0 : 1, WA_CloseGadget,
+      fullscreen ? 0 : 1, WA_DepthGadget, fullscreen ? 0 : 1, WA_DragBar,
+      fullscreen ? 0 : 1, WA_Backdrop, fullscreen ? 1 : 0, WA_Borderless,
+      fullscreen ? 1 : 0, WA_IDCMP,
+      IDCMP_CLOSEWINDOW | IDCMP_MOUSEBUTTONS | IDCMP_MOUSEMOVE | IDCMP_RAWKEY |
+          IDCMP_NEWSIZE,
+      WA_CustomScreen, (IPTR)AmigaScreen, TAG_DONE);
+
+  if (!AmigaWindow) {
+    Cleanup("Failed to open window!");
+  } else if (!fullscreen) {
+    UnlockPubScreen(NULL, AmigaScreen);
+  }
+
+  if (!GetCyberMapAttr(AmigaWindow->RPort->BitMap, CYBRMATTR_ISCYBERGFX)) {
+    Cleanup("Bitmap is not a CyberGraphics bitmap!");
+  }
+
+  bitmap_pitch = (*width + 15) & ~15;       // Original 8-bit pitch
+  bitmap_pitch32 = ((*width + 3) & ~3) * 4; // 32-bit pitch
+
+  bitmap_data = AllocVec(bitmap_pitch * *height, MEMF_ANY | MEMF_CLEAR);
+  bitmap_data32 = AllocVec(bitmap_pitch32 * *height, MEMF_ANY | MEMF_CLEAR);
+
+  if (!bitmap_data || !bitmap_data32) {
+    Cleanup("Failed to allocate bitmap data!");
+  }
+
+  *width = AmigaWindow->GZZWidth;
+  *height = AmigaWindow->GZZHeight;
+
+  _fullscreen = fullscreen;
+}
+
+void RestoreSystemPointer() {
+  if (PointerSet) {
+    ClearPointer(AmigaWindow);
+    PointerSet = FALSE;
+  }
+}
+
+void RemoveSystemPointer() {
+  if (!PointerSet) {
+    SetPointer(AmigaWindow, (UWORD *)BlankCursor, 1, 1, 0, 0);
+    PointerSet = TRUE;
+  }
+}
+
+void Get_Max_Screen_Dim(short *width, short *height) {
+  if (!(AmigaScreen = LockPubScreen(NULL))) {
+    Cleanup("Can't lock pub screen!");
+  }
+
+  *width = Min(*width, AmigaScreen->Width);
+  *height = Min(*height, AmigaScreen->Height);
+
+  UnlockPubScreen(NULL, AmigaScreen);
+}
+
+IPTR Probe_Video_Mode(int width, int height) {
+  IPTR modeID =
+      BestCModeIDTags(CYBRBIDTG_NominalWidth, width, CYBRBIDTG_NominalHeight,
+                      height, CYBRBIDTG_Depth, 24, TAG_DONE);
+  return modeID;
+}
+
+byte Get_Screen_pixel(int x, int y) { return *Get_Screen_pixel_ptr(x, y); }
+
+void Set_Screen_pixel(int x, int y, byte value) {
+  *Get_Screen_pixel_ptr(x, y) = value;
+}
+
+byte *Get_Screen_pixel_ptr(int x, int y) {
+  return (byte *)(bitmap_data + (y * bitmap_pitch) + x);
+}
+
+void Screen_FillRect(int x, int y, int w, int h, byte color) {
+  if (!AmigaScreen || !bitmap_data)
+    return;
+
+  if (x < 0) {
+    w += x;
+    x = 0;
+  }
+  if (y < 0) {
+    h += y;
+    y = 0;
+  }
+  if (x > Screen_width || y > Screen_height)
+    return;
+  if ((x + w) > Screen_width)
+    w = Screen_width - x;
+  if ((y + h) > Screen_height)
+    h = Screen_height - y;
+  if (w <= 0 || h <= 0)
+    return;
+
+  // Fill first line
+  byte *dst = Get_Screen_pixel_ptr(x, y);
+  memset(dst, color, w);
+
+  // Copy first line to remaining lines
+  dst += bitmap_pitch;
+  for (int i = 1; i < h; i++) {
+    memcpy(dst, dst - bitmap_pitch, w);
+    dst += bitmap_pitch;
+  }
+}
+
+void Update_rect(short x, short y, unsigned short width,
+                 unsigned short height) {
+  if (!bitmap_data || !bitmap_data32)
+    return;
+  if (width == 0 || height == 0) {
+    // Full screen update
+    Min_X = Min_Y = 0;
+    Max_X = Screen_width;
+    Max_Y = Screen_height;
+
+    // Convert the entire screen from 8-bit to 32-bit
+    for (int cy = 0; cy < Screen_height; cy++) {
+      UBYTE *src = bitmap_data + (cy * bitmap_pitch);
+      ULONG *dst = bitmap_data32 + (cy * (bitmap_pitch32 / 4));
+
+      for (int cx = 0; cx < Screen_width; cx++) {
+        dst[cx] = lut[src[cx]];
+      }
+    }
+  } else {
+    // Partial screen update
+    if (x < Min_X)
+      Min_X = x;
+    if (y < Min_Y)
+      Min_Y = y;
+    if (x + width > Max_X)
+      Max_X = x + width;
+    if (y + height > Max_Y)
+      Max_Y = y + height;
+
+    // Convert the updated region from 8-bit to 32-bit
+    for (int cy = y; cy < y + height; cy++) {
+      UBYTE *src = bitmap_data + (cy * bitmap_pitch) + x;
+      ULONG *dst = bitmap_data32 + (cy * (bitmap_pitch32 / 4)) + x;
+
+      for (int cx = 0; cx < width; cx++) {
+        dst[cx] = lut[src[cx]];
+      }
+    }
+  }
+}
+
+int GFX2_SetPalette(const T_Components *colors, int firstcolor, int ncolors) {
+  // colors may point to Current_palette + firstcolor (from Set_color),
+  // so index relative to the pointer, not absolute.
+  const T_Components *c = colors - firstcolor;
+  for (int i = firstcolor; i < firstcolor + ncolors; i++) {
+    UBYTE *p = (UBYTE *)&lut[i];
+    p[0] = 0xFF;     // Alpha
+    p[1] = c[i].R;   // Red
+    p[2] = c[i].G;   // Green
+    p[3] = c[i].B;   // Blue
+  }
+
+  Update_rect(0, 0, Screen_width, Screen_height);
+  return 1;
+}
+
+void Set_mouse_position(void) {}
+
+int GFX2_GetScreenSize(int *width, int *height) {
+  *width = AmigaScreen->Width * Pixel_width;
+  *height = AmigaScreen->Height * Pixel_height;
+  return 1;
+}
+
+int GFX2_MessageBox(const char *text, const char *caption, unsigned int type) {
+  struct EasyStruct es = {sizeof(struct EasyStruct), 0, (STRPTR)caption,
+                          (STRPTR)text, "OK"};
+  return EasyRequestArgs(NULL, &es, NULL, NULL);
+}
+
+void Allow_drag_and_drop(int flag) {}
+
+void Define_icon(void) {
+  icon = Load_surface("gfx2.png", Data_directory, NULL);
+}
+
+void Flush_update(void) {
+  if (Min_X >= Max_X || Min_Y >= Max_Y) {
+    ; // Nothing to do
+  } else {
+    if (Min_X < 0)
+      Min_X = 0;
+    if (Min_Y < 0)
+      Min_Y = 0;
+
+    // Calculate actual pixel coordinates
+    int x = Min_X * Pixel_width;
+    int y = Min_Y * Pixel_height;
+    int width = Min(Screen_width - Min_X, Max_X - Min_X) * Pixel_width;
+    int height = Min(Screen_height - Min_Y, Max_Y - Min_Y) * Pixel_height;
+
+    // Use the 32-bit buffer directly with WritePixelArray
+    WritePixelArray(bitmap_data32, x, y, // Source X, Y
+                    bitmap_pitch32,      // Source modulo (bytes per row)
+                    AmigaWindow->RPort,  // Destination RastPort
+                    x, y,                // Destination X, Y
+                    width, height,       // Width, Height
+                    RECTFMT_ARGB32
+    );
+    // Reset bounderies
+    Min_X = Min_Y = 10000;
+    Max_X = Max_Y = 0;
+  }
+
+  // Handle status line updates
+  if (Status_line_dirty_end) {
+    int status_x =
+        (18 + Status_line_dirty_begin * 8) * Menu_factor_X * Pixel_width;
+    int status_y = Menu_status_Y * Pixel_height;
+    int status_width = (Status_line_dirty_end - Status_line_dirty_begin) * 8 *
+                       Menu_factor_X * Pixel_width;
+    int status_height = 8 * Menu_factor_Y * Pixel_height;
+
+    WritePixelArray(bitmap_data32, status_x, status_y, // Source X, Y
+                    bitmap_pitch32,     // Source modulo (bytes per row)
+                    AmigaWindow->RPort, // Destination RastPort
+                    status_x, status_y, // Destination X, Y
+                    status_width, status_height, // Width, Height
+                    RECTFMT_ARGB32
+    );
+    // Reset bounderies
+    Status_line_dirty_begin = 25;
+    Status_line_dirty_end = 0;
+  }
+}
+
+void Clear_border(byte color) {}
+
+void Update_status_line(short char_pos, short width) {
+  if (Status_line_dirty_end < char_pos + width)
+    Status_line_dirty_end = char_pos + width;
+  if (Status_line_dirty_begin > char_pos)
+    Status_line_dirty_begin = char_pos;
+
+  // Convert the status line region from 8-bit to 32-bit
+  int status_x = (18 + char_pos * 8) * Menu_factor_X;
+  int status_y = Menu_status_Y;
+  int status_width = width * 8 * Menu_factor_X;
+  int status_height = 8 * Menu_factor_Y;
+
+  // Ensure we don't go out of bounds
+  if (status_x + status_width > Screen_width)
+    status_width = Screen_width - status_x;
+  if (status_y + status_height > Screen_height)
+    status_height = Screen_height - status_y;
+
+  // Convert the status line pixels from 8-bit to 32-bit
+  for (int cy = status_y; cy < status_y + status_height; cy++) {
+    UBYTE *src = bitmap_data + (cy * bitmap_pitch) + status_x;
+    ULONG *dst = bitmap_data32 + (cy * (bitmap_pitch32 / 4)) + status_x;
+
+    for (int cx = 0; cx < status_width; cx++) {
+      dst[cx] = lut[src[cx]];
+    }
+  }
+}
+
+void Cleanup(char *msg) {
+  if (msg) {
+    GFX2_Log(GFX2_ERROR, "Error : %s\n", msg);
+  }
+
+  if (BlankCursor)
+    FreeMem(BlankCursor, 16);
+
+  if (bitmap_data)
+    FreeVec(bitmap_data);
+
+  if (bitmap_data32)
+    FreeVec(bitmap_data32);
+
+  if (AmigaWindow) {
+    // Drain any pending messages before closing
+    struct Message *msg;
+    while ((msg = GetMsg(AmigaWindow->UserPort)))
+      ReplyMsg(msg);
+    CloseWindow(AmigaWindow);
+    AmigaWindow = NULL;
+  }
+
+  if (AmigaScreen) {
+    if (_fullscreen) {
+      CloseScreen(AmigaScreen);
+    } else {
+      UnlockPubScreen(NULL, AmigaScreen);
+    }
+  }
+
+  if (CyberGfxBase)
+    CloseLibrary(CyberGfxBase);
+  if (GfxBase)
+    CloseLibrary((struct Library *)GfxBase);
+  if (IntuitionBase)
+    CloseLibrary((struct Library *)IntuitionBase);
+}
+
+void Openlibs() {
+  if (!(IntuitionBase =
+            (struct IntuitionBase *)OpenLibrary("intuition.library", 39))) {
+    Cleanup("Can't open intuition.library V39!");
+  }
+
+  if (!(GfxBase = (struct GfxBase *)OpenLibrary("graphics.library", 39))) {
+    Cleanup("Can't open graphics.library V39!");
+  }
+
+  if (!(CyberGfxBase = OpenLibrary("cybergraphics.library", 0))) {
+    Cleanup("Can't open cybergraphics.library!");
+  }
+}
