+#[cfg(target_os = "aros")]
+mod imp {
+    //! AROS: there is no process exit notification (no kqueue/epoll/pidfd and the plugin
+    //! host subprocess cannot be spawned anyway), so registrations fail and the caller
+    //! falls back to bypass at once.
+    use super::{Arc, AtomicBool, Inner};
+    use std::io;
+
+    pub struct Registration {
+        bypass: Arc<AtomicBool>,
+    }
+
+    impl Registration {
+        pub fn new(_pid: u32, _bypass: Arc<AtomicBool>) -> Result<Self, io::Error> {
+            Err(io::Error::other("process watching is not supported on AROS"))
+        }
+
+        pub fn bypass(&self) -> &AtomicBool {
+            &self.bypass
+        }
+
+        pub fn deregister(&mut self, _poller: &Poller) {}
+    }
+
+    #[derive(Clone)]
+    pub struct Wake;
+
+    impl Wake {
+        pub fn wake(&self) {}
+    }
+
+    #[derive(Clone)]
+    pub struct Poller;
+
+    impl Poller {
+        pub fn new() -> Self {
+            Self
+        }
+
+        pub fn wake(&self) -> Wake {
+            Wake
+        }
+    }
+
+    pub fn watcher_thread(_inner: Arc<Inner>) {
+        // Nothing can be registered; the thread just waits for the program to end.
+        loop {
+            std::thread::park();
+        }
+    }
+}
