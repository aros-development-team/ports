diff --git a/client/AROS/clipboard.c b/client/AROS/clipboard.c
new file mode 100644
index 0000000..afb95e4
--- /dev/null
+++ b/client/AROS/clipboard.c
@@ -0,0 +1,100 @@
+#include <winpr/crt.h>
+#include <winpr/clipboard.h>
+#include <winpr/string.h>
+#include <winpr/sysinfo.h>
+#include "tf_freerdp.h"
+#include "native.h"
+#include "clipboard.h"
+static UINT announce(CliprdrClientContext *clip)
+{
+    CLIPRDR_FORMAT format = {CF_UNICODETEXT, NULL};
+    CLIPRDR_FORMAT_LIST list = {{CB_FORMAT_LIST, 0, 0}, 1, &format};
+    return clip->ClientFormatList(clip, &list);
+}
+static UINT ready(CliprdrClientContext *clip, const CLIPRDR_MONITOR_READY *event)
+{
+    WINPR_UNUSED(event);
+    tfContext *tf = clip->custom;
+    CLIPRDR_GENERAL_CAPABILITY_SET general = {CB_CAPSTYPE_GENERAL, 12, CB_CAPS_VERSION_2, CB_USE_LONG_FORMAT_NAMES};
+    CLIPRDR_CAPABILITIES caps = {{CB_CLIP_CAPS, 0, 0}, 1, (CLIPRDR_CAPABILITY_SET *)&general};
+    UINT result = clip->ClientCapabilities(clip, &caps);
+    if (result) return result;
+    EnterCriticalSection(&tf->clip_lock); tf->clip_ready = TRUE; LeaveCriticalSection(&tf->clip_lock);
+    return announce(clip);
+}
+static UINT formats(CliprdrClientContext *clip, const CLIPRDR_FORMAT_LIST *list)
+{
+    CLIPRDR_FORMAT_LIST_RESPONSE response = {{CB_FORMAT_LIST_RESPONSE, CB_RESPONSE_OK, 0}};
+    UINT result = clip->ClientFormatListResponse(clip, &response);
+    if (result) return result;
+    for (UINT32 i = 0; i < list->numFormats; i++) {
+        if (list->formats[i].formatId == CF_UNICODETEXT) {
+            CLIPRDR_FORMAT_DATA_REQUEST request = {{CB_FORMAT_DATA_REQUEST, 0, 0}, CF_UNICODETEXT};
+            return clip->ClientFormatDataRequest(clip, &request);
+        }
+    }
+    return CHANNEL_RC_OK;
+}
+static UINT request_data(CliprdrClientContext *clip, const CLIPRDR_FORMAT_DATA_REQUEST *request)
+{
+    CLIPRDR_FORMAT_DATA_RESPONSE response = {{CB_FORMAT_DATA_RESPONSE, CB_RESPONSE_FAIL, 0}, NULL};
+    char *text = NULL; WCHAR *wide = NULL; size_t length = 0;
+    if (request->requestedFormatId == CF_UNICODETEXT) {
+        text = native_clipboard_read();
+        if (text) wide = ConvertUtf8ToWCharAlloc(text, &length);
+        if (wide && length <= 1048576) {
+            response.common.msgFlags = CB_RESPONSE_OK;
+            response.common.dataLen = (UINT32)((length + 1) * sizeof(WCHAR));
+            response.requestedFormatData = (const BYTE *)wide;
+        }
+    }
+    UINT result = clip->ClientFormatDataResponse(clip, &response);
+    free(wide); free(text); return result;
+}
+static UINT receive_data(CliprdrClientContext *clip, const CLIPRDR_FORMAT_DATA_RESPONSE *response)
+{
+    if (!(response->common.msgFlags & CB_RESPONSE_OK)) return CHANNEL_RC_OK;
+    size_t bytes = response->common.dataLen;
+    if (!response->requestedFormatData || bytes < 2 || bytes > 2097152 || (bytes & 1)) return ERROR_INVALID_DATA;
+    WCHAR *wide = calloc(1, bytes + 2);
+    if (!wide) return ERROR_OUTOFMEMORY;
+    memcpy(wide, response->requestedFormatData, bytes);
+    char *text = ConvertWCharToUtf8Alloc(wide, NULL); free(wide);
+    if (!text) return ERROR_INVALID_DATA;
+    tfContext *tf = clip->custom;
+    EnterCriticalSection(&tf->clip_lock);
+    int stored = native_clipboard_write(text);
+    if (stored) { free(tf->clip_last); tf->clip_last = text; text = NULL; }
+    LeaveCriticalSection(&tf->clip_lock);
+    free(text); return stored ? CHANNEL_RC_OK : ERROR_WRITE_FAULT;
+}
+void adt_clipboard_attach(tfContext *tf, CliprdrClientContext *clip)
+{
+    EnterCriticalSection(&tf->clip_lock);
+    tf->clip = clip; clip->custom = tf;
+    clip->MonitorReady = ready; clip->ServerFormatList = formats;
+    clip->ServerFormatDataRequest = request_data; clip->ServerFormatDataResponse = receive_data;
+    LeaveCriticalSection(&tf->clip_lock);
+}
+void adt_clipboard_detach(tfContext *tf)
+{
+    EnterCriticalSection(&tf->clip_lock);
+    tf->clip = NULL; tf->clip_ready = FALSE;
+    free(tf->clip_last); tf->clip_last = NULL;
+    LeaveCriticalSection(&tf->clip_lock);
+}
+void adt_clipboard_poll(tfContext *tf)
+{
+    UINT64 now = GetTickCount64();
+    if (now - tf->clip_polled < 500) return;
+    tf->clip_polled = now;
+    EnterCriticalSection(&tf->clip_lock);
+    if (tf->clip && tf->clip_ready) {
+        char *text = native_clipboard_read();
+        if (text && (!tf->clip_last || strcmp(text, tf->clip_last))) {
+            if (announce(tf->clip) == CHANNEL_RC_OK) { free(tf->clip_last); tf->clip_last = text; text = NULL; }
+        }
+        free(text);
+    }
+    LeaveCriticalSection(&tf->clip_lock);
+}
